{% extends 'layout.html.twig' %}

{% set logout_to_index = true %}
{% set supports_mobile = true %}

{% block stylesheets %}
{{ parent() }}
<style>
.share-invite-shell {
    max-width: 860px;
    margin: 0 auto;
}

.share-invite-panel {
    border: 1px solid #dbe3ee;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    padding: 20px;
}

.share-invite-warning {
    margin-bottom: 20px;
}

.share-invite-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px 16px;
}

.share-invite-field .help-block {
    margin-bottom: 0;
}

body.theme-dark .share-invite-panel {
    background: #1a2330;
    border-color: #303b4a;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.28);
}
</style>
{% endblock %}

{% block content %}
<div class="share-invite-shell">
    <div class="clearfix" style="margin-bottom: 20px;">
        <a class="btn btn-default pull-left" href="{{ path('share') }}"><i class="icon-chevron-left"></i> Back to Sharing</a>
    </div>

    <div class="share-invite-panel">
        <h2 style="margin-top: 0;">Invite Access</h2>
        <p class="text-muted" style="margin-bottom: 18px;">Grant another Throttle account full access to view and manage your crash reports.</p>

        <div class="alert alert-warning share-invite-warning" style="text-align: left;">
            <p style="font-weight: bold;">Granting access through this form gives the other person the same report permissions you have.</p>
            <p>This includes downloading the raw minidump and viewing the full command line options.</p>
            <p style="margin-bottom: 0;">If you only need to show the public crash page, share the report link instead of adding them here.</p>
        </div>

{% for error in legacy_app.session.flashbag.get('error_share_invite') %}
        <div class="alert alert-danger">{{ error }}</div>
{% endfor %}

        <form action="{{ path('share_invite_post') }}" method="POST">
            <div class="share-invite-grid">
                <div class="share-invite-field">
                    <label class="control-label" for="share-user-id">User ID</label>
                    <input id="share-user-id" type="text" name="user_id" class="form-control" inputmode="numeric" pattern="\d*" placeholder="{{ legacy_app.user.id }}">
                    <p class="help-block">Invite by local Throttle user ID.</p>
                </div>
{% if share_invite_methods.email %}
                <div class="share-invite-field">
                    <label class="control-label" for="share-email">Email</label>
                    <input id="share-email" type="email" name="email" class="form-control" placeholder="name@example.com">
                    <p class="help-block">Invite by confirmed email address.</p>
                </div>
{% endif %}
{% if share_invite_methods.steam %}
                <div class="share-invite-field">
                    <label class="control-label" for="share-steam">SteamID64</label>
                    <input id="share-steam" type="text" name="steam_id" class="form-control" pattern="(?:steam:)?\d{15,20}" placeholder="76561198000000000">
                    <p class="help-block">Invite by linked Steam account.</p>
                </div>
{% endif %}
{% if share_invite_methods.discord %}
                <div class="share-invite-field">
                    <label class="control-label" for="share-discord">Discord ID</label>
                    <input id="share-discord" type="text" name="discord_id" class="form-control" placeholder="123456789012345678">
                    <p class="help-block">Invite by linked Discord account identifier.</p>
                </div>
{% endif %}
            </div>

            <p class="help-block" style="margin-top: 16px;">Fill only one field at a time. Available fields follow the login methods currently enabled on this server.</p>

            <div style="margin-top: 18px;">
                <button type="submit" class="btn btn-success"><i class="icon-inbox"></i> Send invite</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
