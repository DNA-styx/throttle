{% extends 'layout.html.twig' %}

{% set logout_to_index = true %}
{% set supports_mobile = true %}
 
{% block content %}
<div class="console-header clearfix">
    <div class="pull-left">
        <h1>Console</h1>
        <p class="muted">Crash console output with important lines highlighted.</p>
    </div>
    <div class="pull-right console-toolbar">
        <a class="btn btn-default" href="{{ path('details', {'id': id}) }}"><i class="icon-chevron-left"></i> Back to Details</a>
    </div>
</div>
<div class="well well-tight console-panel">
  <table class="table table-condensed table-log">
    <thead>
      <tr>
        <th class="hidden-xs">Time</th>
        <th class="hidden-xs">Channel</th>
        <th>Message</th>
      </tr>
    </thead>
    <tbody>
{% for line in console %}
    <tr class="{% if line.severity %}log-{{ line.severity }}{% endif %}">
      <td class="hidden-xs">{{ line.tick }}</td>
      <td class="hidden-xs">{{ line.time }}</td>
      <td class="log-message">{{ line.message }}</td>
    </tr>
{% else %}
    <tr class="danger">
      <th colspan="3">Console output is unavailable for this crash.</th>
    </tr>
{% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}

