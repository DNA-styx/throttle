{% block scripts %}
<script src="{{ legacy_app.request.baseUrl }}/js/jquery.hoverIntent.min.js"></script>
<script type="text/javascript">
    $('.table-stacktrace tbody tr').hoverIntent(function() { $(this).toggleClass('stackframe-expand'); });

    $('#copy-stacktrace').on('click', function() {
        var lines = [];
        $('.table-stacktrace tbody tr').each(function() {
            var frame = $(this).data('stack-frame');
            var rendered = $(this).data('stack-rendered');
            if (frame !== undefined && rendered) {
                lines.push('#' + frame + ' ' + rendered);
            }
        });

        var text = lines.join('\n');
        if (!text) {
            return;
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text);
            return;
        }

        var textarea = $('<textarea>').val(text).css({position: 'fixed', left: '-9999px', top: '0'});
        $('body').append(textarea);
        textarea[0].focus();
        textarea[0].select();
        document.execCommand('copy');
        textarea.remove();
    });

    $('.table-shown').each(function() {
        var table = $(this);
        if (table.find('tbody tr').length <= 10 || table.find('tfoot').length === 0) {
            return;
        }

        table.toggleClass('table-shown').toggleClass('table-hidden').find('tfoot').click(function() {
            $(this).parent().toggleClass('table-hidden').toggleClass('table-shown');
        });
    });

    (function() {
        var moduleRows = $('.table-modules .module-row');
        var showAll = false;
        var activeFilter = 'all';

        function applyModuleFilter() {
            var visible = 0;
            moduleRows.each(function() {
                var row = $(this);
                var matches = activeFilter === 'all'
                    || row.data('module-status') === activeFilter
                    || (activeFilter === 'useful' && row.data('module-useful') === 'high');
                var hiddenByLimit = !showAll && row.hasClass('module-extra');
                row.toggleClass('hidden', !matches || hiddenByLimit);
                if (matches && !hiddenByLimit) {
                    visible++;
                }
            });
            $('.modules-empty').toggleClass('hidden', visible !== 0);
            $('#show-all-modules').toggleClass('hidden', showAll || activeFilter !== 'all' || $('.table-modules .module-extra').length === 0);
        }

        $('[data-module-filter]').on('click', function() {
            $('[data-module-filter]').removeClass('active');
            $(this).addClass('active');
            activeFilter = $(this).data('module-filter');
            applyModuleFilter();
        });

        $('#show-all-modules').on('click', function() {
            showAll = true;
            applyModuleFilter();
        });

        applyModuleFilter();
    })();

    if (window.location.hash === '#signature-notes' || window.location.hash === '#signature-note-form') {
        $(window.location.hash).collapse('show');
    }
    if (window.location.hash && window.location.hash.indexOf('#signature-note-edit-') === 0) {
        $('#signature-notes').collapse('show');
        $(window.location.hash).collapse('show');
    }

    $('[data-open-signature-notes]').on('click', function() {
        $('#signature-notes').collapse('show');
    });

    function renderMarkdownPreview(text) {
        var escaped = $('<div>').text(text || '').html();
        escaped = escaped.replace(/`([^`\n]+)`/g, '<code>$1</code>')
            .replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>')
            .replace(/\*([^*\n]+)\*/g, '<em>$1</em>')
            .replace(/\[([^\]\n]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" rel="nofollow noopener noreferrer" target="_blank">$1</a>');

        var html = [];
        var list = null;
        var paragraph = [];
        var closeList = function() {
            if (list) {
                html.push('</' + list + '>');
                list = null;
            }
        };
        var flushParagraph = function() {
            if (paragraph.length) {
                html.push('<p>' + paragraph.join('<br>') + '</p>');
                paragraph = [];
            }
        };

        escaped.split(/\n/).forEach(function(line) {
            line = line.replace(/\s+$/, '');
            var match;
            if (!line) {
                flushParagraph();
                closeList();
                return;
            }
            if ((match = line.match(/^#{1,3}\s+(.+)$/))) {
                flushParagraph();
                closeList();
                html.push('<strong>' + match[1] + '</strong>');
                return;
            }
            if ((match = line.match(/^&gt;\s*(.+)$/))) {
                flushParagraph();
                closeList();
                html.push('<blockquote>' + match[1] + '</blockquote>');
                return;
            }
            if ((match = line.match(/^- \[( |x)\]\s+(.+)$/i))) {
                flushParagraph();
                if (list !== 'ul') {
                    closeList();
                    html.push('<ul>');
                    list = 'ul';
                }
                html.push('<li>' + (match[1].toLowerCase() === 'x' ? '&#9745; ' : '&#9744; ') + match[2] + '</li>');
                return;
            }
            if ((match = line.match(/^[-*]\s+(.+)$/))) {
                flushParagraph();
                if (list !== 'ul') {
                    closeList();
                    html.push('<ul>');
                    list = 'ul';
                }
                html.push('<li>' + match[1] + '</li>');
                return;
            }
            if ((match = line.match(/^\d+\.\s+(.+)$/))) {
                flushParagraph();
                if (list !== 'ol') {
                    closeList();
                    html.push('<ol>');
                    list = 'ol';
                }
                html.push('<li>' + match[1] + '</li>');
                return;
            }
            closeList();
            paragraph.push(line);
        });

        flushParagraph();
        closeList();
        return html.join('\n') || '<p class="muted">Nothing to preview.</p>';
    }

    $('[data-markdown-editor]').each(function() {
        var editor = $(this);
        var textarea = editor.find('textarea');
        var preview = editor.find('.markdown-preview');

        function selectedText(placeholder) {
            var element = textarea[0];
            var start = element.selectionStart || 0;
            var end = element.selectionEnd || 0;
            var text = textarea.val().substring(start, end);
            if (text) {
                return text;
            }

            return placeholder;
        }

        function replaceSelection(before, after, placeholder) {
            var element = textarea[0];
            var value = textarea.val();
            var start = element.selectionStart || 0;
            var end = element.selectionEnd || 0;
            var text = value.substring(start, end) || placeholder;
            var replacement = before + text + after;
            textarea.val((value.substring(0, start) + replacement + value.substring(end)).substring(0, 500));
            textarea.focus();
            element.selectionStart = start + before.length;
            element.selectionEnd = start + before.length + text.length;
        }

        editor.find('[data-md-action]').on('click', function() {
            var action = $(this).data('md-action');
            if (action === 'heading') replaceSelection('### ', '', 'Heading');
            if (action === 'bold') replaceSelection('**', '**', 'strong text');
            if (action === 'italic') replaceSelection('*', '*', 'emphasized text');
            if (action === 'quote') replaceSelection('> ', '', 'quoted text');
            if (action === 'code') replaceSelection('`', '`', 'code');
            if (action === 'link') replaceSelection('[', '](https://example.com)', 'link text');
            if (action === 'ul') replaceSelection('- ', '', 'list item');
            if (action === 'ol') replaceSelection('1. ', '', 'list item');
            if (action === 'task') replaceSelection('- [ ] ', '', 'task');
            if (action === 'mention') replaceSelection('@', '', 'username');
            if (action === 'reference') replaceSelection('#', '', '123');
            if (action === 'undo') document.execCommand('undo');
            if (preview.is(':visible')) {
                preview.html(renderMarkdownPreview(textarea.val()));
            }
        });

        editor.find('[data-md-tab]').on('click', function(event) {
            event.preventDefault();
            var tab = $(this).data('md-tab');
            editor.find('.markdown-tabs li').removeClass('active');
            $(this).parent().addClass('active');
            if (tab === 'preview') {
                preview.html(renderMarkdownPreview(textarea.val())).show();
                textarea.hide();
            } else {
                preview.hide();
                textarea.show().focus();
            }
        });
    });

{% if source_lookup_enabled and verified_source_lookup_frames|length > 0 %}
    var verifiedSourceLookupFrames = {};
    var verifiedSourceLookupNode = document.getElementById('verified-source-lookup-data');
    var verifiedSourceLookupPayload = verifiedSourceLookupNode ? verifiedSourceLookupNode.getAttribute('data-payload') : '';
    if (verifiedSourceLookupPayload) {
        try {
            verifiedSourceLookupFrames = JSON.parse(verifiedSourceLookupPayload);
        } catch (e) {
            verifiedSourceLookupFrames = {};
        }
    }
    var detailsStackShell = $('#details-stack-shell');
    var detailsStackSourcePanel = $('#details-stack-source-panel');
    if (detailsStackSourcePanel.length) {
        detailsStackSourcePanel.appendTo(document.body);
    }
    var detailsStackSourceState = detailsStackSourcePanel.find('.raw-source-state');
    var detailsStackSourceMeta = detailsStackSourcePanel.find('.raw-source-meta');
    var detailsStackSourceModule = detailsStackSourcePanel.find('.details-source-module');
    var detailsStackSourceSymbol = detailsStackSourcePanel.find('.details-source-symbol');

    function parseStackRenderedLabel(label) {
        var normalized = String(label || '').trim();
        var bang = normalized.indexOf('!');
        if (bang === -1) {
            return { module: '', symbol: normalized };
        }

        return {
            module: normalized.substring(0, bang),
            symbol: normalized.substring(bang + 1)
        };
    }

    function renderStackSourceDiagnostics(container, payload) {
        var diagnostics = [];
        if (payload.warning) {
            diagnostics.push(String(payload.warning));
        }
        if (!diagnostics.length) {
            return;
        }

        var wrapper = $('<details class="raw-source-diagnostics-toggle"></details>');
        $('<summary></summary>').text('Diagnostics').appendTo(wrapper);
        $('<pre class="raw-source-snippet" style="margin-top: 10px;"></pre>')
            .text(diagnostics.join('\n\n'))
            .appendTo(wrapper);
        container.append(wrapper);
    }

    function renderStackSourceSnippet(container, snippet) {
        var wrapper = $('<div class="raw-source-snippet raw-source-snippet-rendered"></div>');
        var focusIndex = -1;
        var currentIndex = 0;
        String(snippet || '').split('\n').forEach(function(line) {
            var focus = false;
            if (line.indexOf('> ') === 0) {
                focus = true;
                line = '  ' + line.substring(2);
                focusIndex = currentIndex;
            }

            $('<div class="raw-source-snippet-line"></div>')
                .toggleClass('is-focus', focus)
                .text(line)
                .appendTo(wrapper);
            currentIndex += 1;
        });
        container.append(wrapper);

        var focusLine = wrapper.find('.raw-source-snippet-line.is-focus').first();
        if (focusLine.length && focusIndex >= 0) {
            window.requestAnimationFrame(function() {
                var lineHeight = focusLine.outerHeight() || 0;
                var topLineOffset = Math.max(0, focusIndex - 2);
                wrapper.scrollTop(topLineOffset * lineHeight);
            });
        }
    }

    function renderStackSourceState(payload) {
        detailsStackSourceState.empty();
        detailsStackSourceMeta.empty();

        if (payload.module_identifier) {
            $('<div></div>').text('Identifier: ' + payload.module_identifier).appendTo(detailsStackSourceMeta);
        }

        $('<div></div>').append(
            document.createTextNode('Cache: hit')
        ).appendTo(detailsStackSourceMeta);

        var header = $('<p class="raw-source-note"></p>').appendTo(detailsStackSourceState);
        $('<span class="label label-success">Verified</span>').appendTo(header);
        header.append(' ');
        $('<code></code>').text((payload.file || '[unknown file]') + ':' + (payload.line_start || 0)).appendTo(header);
        if (payload.github_url) {
            header.append(' ');
            $('<a target="_blank" rel="noopener noreferrer"></a>')
                .attr('href', payload.github_url)
                .text('Open on GitHub')
                .appendTo(header);
        }

        $('<p class="help-block" style="margin-top: 8px; margin-bottom: 0;"></p>')
            .html('Full source lookup is available in <a href="{{ path('carburetor', {'id': crash.id}) }}">View Raw</a>.')
            .appendTo(detailsStackSourceState);

        if (payload.snippet) {
            renderStackSourceSnippet(detailsStackSourceState, payload.snippet);
        } else {
            $('<div class="raw-source-empty" style="margin-top: 8px;"></div>')
                .text('No cached snippet is available for this source match.')
                .appendTo(detailsStackSourceState);
        }

        renderStackSourceDiagnostics(detailsStackSourceState, payload);
    }

    function hideStackSourcePanel() {
        detailsStackSourcePanel.addClass('hidden').attr('aria-hidden', 'true');
    }

    function openStackSourcePanel(button, payload) {
        var row = button.closest('tr');
        var parsed = parseStackRenderedLabel(row.data('stack-rendered'));
        var buttonRect = button.length ? button[0].getBoundingClientRect() : { top: 0, left: 0, width: 24 };
        var scrollTop = $(window).scrollTop() || 0;
        var scrollLeft = $(window).scrollLeft() || 0;
        var buttonWidth = button.outerWidth() || buttonRect.width || 24;

        detailsStackSourceModule.text(payload.module_basename || parsed.module || '[unknown module]');
        detailsStackSourceSymbol.text(parsed.symbol || row.data('stack-rendered') || '[unknown symbol]');
        renderStackSourceState(payload);

        detailsStackSourcePanel.removeClass('hidden').attr('aria-hidden', 'false');

        var panelWidth = detailsStackSourcePanel.outerWidth() || 560;
        var viewportWidth = window.innerWidth || panelWidth;
        var viewportHeight = window.innerHeight || 0;
        var top = Math.max(12 + scrollTop, buttonRect.top + scrollTop - 2);
        var left = Math.max(12 + scrollLeft, Math.min(buttonRect.left + scrollLeft - panelWidth + buttonWidth, scrollLeft + viewportWidth - panelWidth - 8));
        var panelHeight = detailsStackSourcePanel.outerHeight() || 0;

        if (viewportHeight > 0 && panelHeight > 0 && (top + panelHeight) > (scrollTop + viewportHeight - 12)) {
            top = Math.max(12 + scrollTop, scrollTop + viewportHeight - panelHeight - 12);
        }

        detailsStackSourcePanel.css({
            top: top + 'px',
            left: left + 'px'
        });
    }

    detailsStackSourcePanel.find('.details-source-close').on('click', function() {
        hideStackSourcePanel();
    });

    detailsStackSourcePanel.find('.details-source-source-tab').on('click', function(event) {
        event.preventDefault();
    });

    $(document).on('mousedown', function(event) {
        if (detailsStackSourcePanel.hasClass('hidden')) {
            return;
        }

        var target = $(event.target);
        if (target.closest('#details-stack-source-panel').length || target.closest('.stack-source-button').length) {
            return;
        }

        hideStackSourcePanel();
    });

    $(document).on('keydown', function(event) {
        if (event.key === 'Escape') {
            hideStackSourcePanel();
        }
    });

    $('.stack-source-button').on('click', function(event) {
        event.preventDefault();
        var button = $(this);
        var frameId = String(button.data('stack-source-frame'));
        var payload = verifiedSourceLookupFrames && verifiedSourceLookupFrames[frameId] ? verifiedSourceLookupFrames[frameId] : null;
        if (!payload) {
            return;
        }

        openStackSourcePanel(button, payload);
    });
{% endif %}

{% if ai_analysis_enabled and ((legacy_app.user and can_manage) or public_ai_history_count > 0) %}
    var detailsAiDataNode = $('#details-ai-analysis-data');
    var detailsAiPanel = $('#details-ai-analysis-panel');
    if (detailsAiPanel.length) {
        detailsAiPanel.appendTo(document.body);
    }
    var detailsAiConfigs = [];
    try {
        detailsAiConfigs = JSON.parse(detailsAiDataNode.attr('data-configs') || '[]');
    } catch (e) {
        detailsAiConfigs = [];
    }
    var detailsAiUrl = detailsAiDataNode.attr('data-url');
    var detailsAiHistoryUrl = detailsAiDataNode.attr('data-history-url');
    var detailsAiVisibilityUrlTemplate = detailsAiDataNode.attr('data-visibility-url-template');
    var detailsAiToken = detailsAiDataNode.attr('data-token');
    var detailsAiCanAsk = detailsAiDataNode.attr('data-can-ask') === '1';
    var detailsAiButton = $('#ask-ai-details');
    var detailsAiSelect = detailsAiPanel.find('.details-ai-config');
    var detailsAiPrompt = detailsAiPanel.find('.details-ai-prompt');
    var detailsAiStatus = detailsAiPanel.find('.details-ai-status');
    var detailsAiResult = detailsAiPanel.find('.crash-ai-result');
    var detailsAiHistoryStatus = detailsAiPanel.find('.details-ai-history-status');
    var detailsAiHistoryList = detailsAiPanel.find('.details-ai-history-list');
    var detailsAiHistoryLoaded = false;
    var detailsAiEmbeddedHistory = [];
    try {
        detailsAiEmbeddedHistory = JSON.parse(detailsAiDataNode.attr('data-history-items') || '[]');
    } catch (e) {
        detailsAiEmbeddedHistory = [];
    }

    function detailsAiSelectedConfig() {
        var selectedId = String(detailsAiSelect.val() || '');
        for (var i = 0; i < detailsAiConfigs.length; i++) {
            if (String(detailsAiConfigs[i].id) === selectedId) {
                return detailsAiConfigs[i];
            }
        }
        return null;
    }

    function detailsAiRenderConfigs() {
        if (!detailsAiCanAsk) {
            return;
        }
        detailsAiSelect.empty();
        if (!detailsAiConfigs.length) {
            detailsAiSelect.append($('<option value=""></option>').text('No saved AI configs'));
            detailsAiPrompt.val('');
            return;
        }

        detailsAiConfigs.forEach(function(config) {
            var label = config.display_name + ' (' + config.provider_label + ' / ' + config.model + ')';
            detailsAiSelect.append($('<option></option>').attr('value', config.id).text(label));
        });

        var preferred = null;
        detailsAiConfigs.forEach(function(config) {
            if (config.is_default && preferred === null) {
                preferred = String(config.id);
            }
        });
        detailsAiSelect.val(preferred || String(detailsAiConfigs[0].id));
        var selected = detailsAiSelectedConfig();
        detailsAiPrompt.val(selected && selected.default_prompt ? selected.default_prompt : '');
    }

    function detailsAiShowTab(tab) {
        detailsAiPanel.find('.details-ai-tab-link').parent().removeClass('active');
        detailsAiPanel.find('.details-ai-tab-link[data-tab="' + tab + '"]').parent().addClass('active');
        detailsAiPanel.find('.details-ai-tab-panel').addClass('hidden');
        detailsAiPanel.find('.details-ai-tab-' + tab).removeClass('hidden');
        if (tab === 'history') {
            detailsAiLoadHistory(false);
        }
    }

    function detailsAiShowPanel() {
        detailsAiRenderConfigs();
        detailsAiStatus.empty();
        detailsAiResult.addClass('hidden').text('');

        detailsAiPanel.removeClass('hidden').attr('aria-hidden', 'false');
        var buttonRect = detailsAiButton[0].getBoundingClientRect();
        var panelWidth = detailsAiPanel.outerWidth() || 620;
        var scrollTop = $(window).scrollTop() || 0;
        var scrollLeft = $(window).scrollLeft() || 0;
        var viewportWidth = window.innerWidth || panelWidth;
        var left = Math.max(12 + scrollLeft, Math.min(buttonRect.left + scrollLeft - panelWidth + detailsAiButton.outerWidth(), scrollLeft + viewportWidth - panelWidth - 12));
        var top = Math.max(12 + scrollTop, buttonRect.top + scrollTop + detailsAiButton.outerHeight() + 6);
        detailsAiPanel.css({ top: top + 'px', left: left + 'px' });
        detailsAiShowTab(detailsAiCanAsk ? 'ask' : 'history');
    }

    function detailsAiHidePanel() {
        detailsAiPanel.addClass('hidden').attr('aria-hidden', 'true');
    }

    function detailsAiSetStatus(type, text, loading) {
        var box = $('<div></div>').addClass('alert alert-' + type);
        if (loading) {
            box.append($('<span class="crash-ai-inline-spinner"></span>'));
        }
        box.append(document.createTextNode(text));
        detailsAiStatus.empty().append(box);
    }

    function detailsAiSetHistoryStatus(type, text) {
        detailsAiHistoryStatus.empty().append($('<div></div>').addClass('alert alert-' + type).text(text));
    }

    function detailsAiHistorySections(entry) {
        var labels = [];
        if (entry.request_sections && entry.request_sections.stack_trace) labels.push('stack');
        if (entry.request_sections && entry.request_sections.likely_cause) labels.push('cause');
        if (entry.request_sections && entry.request_sections.modules) labels.push('modules');
        if (entry.request_sections && entry.request_sections.console) labels.push('console');
        if (entry.request_sections && entry.request_sections.header_metadata) labels.push('header');
        if (entry.request_sections && entry.request_sections.raw) labels.push('raw');
        return labels.join(', ');
    }

    function detailsAiRenderHistory(items) {
        detailsAiHistoryList.empty();
        if (!items || !items.length) {
            detailsAiHistoryList.append($('<div class="crash-ai-history-empty muted"></div>').text('No AI history entries yet.'));
            return;
        }

        items.forEach(function(entry) {
            var item = $('<div class="crash-ai-history-entry"></div>');
            var head = $('<div class="crash-ai-history-head"></div>').appendTo(item);
            var metaBox = $('<div></div>').appendTo(head);
            $('<div class="fw-semibold"></div>').text((entry.user_name || ('User #' + entry.user_id)) + ' В· ' + entry.provider_label + ' / ' + entry.model).appendTo(metaBox);
            $('<div class="crash-ai-history-meta"></div>').text(entry.created_at + ' В· ' + entry.context + ' В· ' + detailsAiHistorySections(entry)).appendTo(metaBox);

            var actions = $('<div class="text-right"></div>').appendTo(head);
            $('<span class="label ' + (entry.is_public ? 'label-success' : 'label-default') + '"></span>')
                .text(entry.is_public ? 'Public' : 'Private')
                .appendTo(actions);

            if (entry.can_toggle_visibility) {
                actions.append(' ');
                $('<button type="button" class="btn btn-mini btn-default"></button>')
                    .text(entry.is_public ? 'Make private' : 'Make public')
                    .on('click', function() {
                        detailsAiSetHistoryStatus('info', 'Updating visibility...');
                        $.ajax({
                            url: detailsAiVisibilityUrlTemplate.replace('__HISTORY__', String(entry.id)),
                            method: 'POST',
                            data: {
                                _token: detailsAiToken,
                                is_public: entry.is_public ? '0' : '1'
                            }
                        }).done(function(result) {
                            if (!result || result.status !== 'ok') {
                                detailsAiSetHistoryStatus('danger', result && result.reason ? result.reason : 'Could not update visibility.');
                                return;
                            }
                            detailsAiSetHistoryStatus('success', 'Visibility updated.');
                            detailsAiLoadHistory(true);
                        }).fail(function(xhr) {
                            var message = 'Could not update visibility.';
                            if (xhr && xhr.responseJSON && xhr.responseJSON.reason) {
                                message = xhr.responseJSON.reason;
                            }
                            detailsAiSetHistoryStatus('danger', message);
                        });
                    })
                    .appendTo(actions);
            }

            var promptDetails = $('<details></details>').appendTo(item);
            $('<summary></summary>').text('Prompt').appendTo(promptDetails);
            $('<pre class="crash-ai-history-prompt"></pre>').text(entry.prompt || '').appendTo(promptDetails);
            $('<pre class="crash-ai-history-response"></pre>').text(entry.response_text || '').appendTo(item);
            detailsAiHistoryList.append(item);
        });
    }

    function detailsAiLoadHistory(forceReload) {
        if (detailsAiHistoryLoaded && !forceReload) {
            return;
        }
        detailsAiSetHistoryStatus('info', 'Loading AI history...');
        $.getJSON(detailsAiHistoryUrl, function(result) {
            if (!result || result.status !== 'ok') {
                detailsAiSetHistoryStatus('danger', result && result.reason ? result.reason : 'Could not load AI history.');
                return;
            }
            detailsAiHistoryStatus.empty();
            detailsAiRenderHistory(result.items || []);
            detailsAiHistoryLoaded = true;
        }).fail(function(xhr) {
            var message = 'Could not load AI history.';
            if (xhr && xhr.responseJSON && xhr.responseJSON.reason) {
                message = xhr.responseJSON.reason;
            }
            detailsAiSetHistoryStatus('danger', message);
        });
    }

    if (detailsAiCanAsk) {
        detailsAiSelect.on('change', function() {
            var selected = detailsAiSelectedConfig();
            if (selected && selected.default_prompt) {
                detailsAiPrompt.val(selected.default_prompt);
            }
        });
    }

    detailsAiPanel.find('.details-ai-tab-link').on('click', function(event) {
        event.preventDefault();
        detailsAiShowTab($(this).data('tab'));
    });

    detailsAiButton.on('click', function(event) {
        event.preventDefault();
        detailsAiShowPanel();
    });

    detailsAiPanel.find('.details-ai-close, .details-ai-cancel').on('click', function() {
        detailsAiHidePanel();
    });

    $(document).on('mousedown', function(event) {
        if (detailsAiPanel.hasClass('hidden')) {
            return;
        }
        var target = $(event.target);
        if (target.closest('#details-ai-analysis-panel').length || target.closest('#ask-ai-details').length) {
            return;
        }
        detailsAiHidePanel();
    });

    detailsAiPanel.find('.details-ai-submit').on('click', function() {
        if (!detailsAiCanAsk) {
            return;
        }
        var selected = detailsAiSelectedConfig();
        if (!selected) {
            detailsAiSetStatus('warning', 'Create an AI config in Profile first.');
            return;
        }

        detailsAiSetStatus('info', 'Analyzing crash with AI...', true);
        detailsAiResult.addClass('hidden').text('');

        $.ajax({
            url: detailsAiUrl,
            method: 'POST',
            data: {
                _token: detailsAiToken,
                ai_config_id: selected.id,
                context: 'details',
                prompt: detailsAiPrompt.val() || '',
                include_stack_trace: detailsAiPanel.find('.details-ai-include-stack').is(':checked') ? '1' : '0',
                include_likely_cause: detailsAiPanel.find('.details-ai-include-cause').is(':checked') ? '1' : '0',
                include_modules: detailsAiPanel.find('.details-ai-include-modules').is(':checked') ? '1' : '0',
                include_console: detailsAiPanel.find('.details-ai-include-console').is(':checked') ? '1' : '0',
                include_header_metadata: detailsAiPanel.find('.details-ai-include-header').is(':checked') ? '1' : '0',
                include_raw: detailsAiPanel.find('.details-ai-include-raw').is(':checked') ? '1' : '0'
            }
        }).done(function(result) {
            if (!result || result.status !== 'ok') {
                detailsAiSetStatus('danger', result && result.reason ? result.reason : 'AI analysis failed.');
                return;
            }
            detailsAiSetStatus('success', result.provider_label + ' / ' + result.model + ' пїЅ ' + result.duration_ms + ' ms');
            detailsAiResult.removeClass('hidden').text(result.response_text || '');
            detailsAiHistoryLoaded = false;
        }).fail(function(xhr) {
            var message = 'AI analysis failed.';
            if (xhr && xhr.responseJSON && xhr.responseJSON.reason) {
                message = xhr.responseJSON.reason;
            }
            detailsAiSetStatus('danger', message);
        });
    });
{% endif %}

{% if has_error_string %}
    $.getJSON('{{ path('error', {id: crash.id}) }}', function(data) {
        if (data.string) {
            $('#error-details').text(data.string);
        }
    });
{% endif %}
</script>
