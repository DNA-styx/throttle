{% extends 'layout.html.twig' %}

{% set supports_mobile = true %}

{% block stylesheets %}
<style>
.signature-note {
    border-top: 1px solid rgba(120, 136, 156, 0.25);
    padding: 12px 0;
}

.signature-note:first-of-type {
    border-top: 0;
    padding-top: 4px;
}

.signature-note-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
}

.signature-note-header-meta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    color: #8a97a6;
    font-size: 12px;
    line-height: 1.2;
}

.signature-note-body {
    margin-top: 5px;
}

.signature-note-footer {
    margin-top: 12px;
    padding-top: 3px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.signature-note-votes {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex-wrap: nowrap;
}

.signature-note-vote-form,
.signature-note-pin-form {
    margin: 0;
    display: inline-flex;
}

.signature-note-vote-form .btn-link,
.signature-note-actions .btn-link,
.signature-note-pin-form .btn-link {
    padding: 0;
    border: 0;
    text-decoration: none;
    box-shadow: none;
}

.signature-note-vote-button {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    font-weight: 600;
}

.signature-note-vote-button i {
    line-height: 1;
}

.signature-note-vote-button.positive,
.signature-note-vote-button.positive i,
.signature-note-vote-count.positive {
    color: #4aa564;
}

.signature-note-vote-button.negative,
.signature-note-vote-button.negative i,
.signature-note-vote-count.negative {
    color: #d06075;
}

.signature-note-vote-count {
    font-weight: 700;
}

.signature-note-pin,
.signature-note-pin i {
    color: #5f9fe6;
    line-height: 1;
}

.signature-note-pin-date {
    color: #8a97a6;
    white-space: nowrap;
}

.signature-note-actions {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
}

.signature-note-edit {
    margin-top: 12px;
}

.signature-notes-pagination {
    margin-top: 14px;
}

.signature-notes-pagination ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.signature-notes-pagination li {
    margin: 0;
    padding: 0;
}

.signature-notes-pagination a,
.signature-notes-pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    padding: 6px 12px;
    border: 1px solid #3a4758;
    border-radius: 4px;
    background: #1a2330;
    color: #d7e0ea;
    text-decoration: none;
    line-height: 1.1;
}

.signature-notes-pagination a:hover,
.signature-notes-pagination a:focus {
    background: #2b3849;
    color: #fff;
    border-color: #536174;
}

.signature-notes-pagination .active span {
    background: #2b3849;
    color: #fff;
    border-color: #536174;
    font-weight: 700;
}

.signature-notes-pagination .disabled span,
.signature-notes-pagination .disabled a {
    color: #6f7b8a;
    background: #151c25;
    border-color: #303b4a;
    pointer-events: none;
}
</style>
{% endblock %}

{% block content %}
{% if not crash.owner %}
{% if legacy_app.config.accelerator %}
<div class="alert alert-block alert-info">This crash was submitted anonymously. Configure your server ownership metadata to associate future reports with your account.</div>
{% endif %}
{% else %}
{% if not legacy_app.user %}
<div class="alert alert-block alert-info">If you are the owner of this crash, <a href="{{ path('login_steam', {'return': legacy_app.request.pathInfo}) }}" class="alert-link">login with Steam</a> to see more information.</div>
{% elseif not can_manage %}
<div class="alert alert-block alert-info">You can not see full information about this crash as you are not the owner.</div>
{% endif %}
{% endif %}

<div class="well" style="position: relative;">
    <dl class="dl-horizontal" style="margin: 0;">
        <dt>Uploaded</dt>
        <dd>{{ crash.timestamp|date }}</dd>
{% if can_manage %}
{% if crash.ip %}
	<dt>Upload IP</dt>
	<dd>{{ crash.ip }}</dd>
{% endif %}
{% if can_manage and crash.owner and crash.owner != legacy_app.user.id %}
    <dt>Owner</dt>
    <dd><a  href="{{ path('dashboard', {'user': crash.owner}) }}">{{ crash.name ?? crash.owner }}</a></dd>
{% endif %}
{% if crash.cmdline %}
        <dt>Command Line</dt>
        <dd>{{ crash.cmdline }}</dd>
{% endif %}
{% for key, value in crash.metadata %}
        <dt>{{ key|format_metadata_key }}</dt>
{% if value %}
        <dd>{{ value }}</dd>
{% else %}
        <dd>&nbsp;</dd>
{% endif %}
{% endfor %}
{% endif %}
    </dl>
{% if legacy_app.feature.subscriptions %}
    <a class="supporter-tag" href="{{ path('subscribe') }}" data-toggle="tooltip" data-container="body" data-placement="bottom" title="The owner of the server that submitted this crash dump contributes money to support the hosting and development of this service."><i class="icon-usd"></i> Supporter</a>
{% endif %}
</div>

{% if crash.processed == 0 %}
<div class="alert alert-block alert-info">This crash is pending processing, try again later.</div>
{% elseif crash.failed == 1 %}
<div class="alert alert-block alert-danger">An error occurred while processing this crash.</div>
{% endif %}

{%if outdated %}
<div class="alert alert-block alert-warning">This crash was submitted using an older version of Accelerator, please <a href="https://forums.alliedmods.net/showthread.php?t=277703" class="alert-link">update to the latest version</a> for full functionality.</div>
{% endif %}

{% if crash.processed == 1 and crash.failed == 0 %}
{% for notice in notices %}
<div class="alert alert-block alert-{{ notice.severity }}">{{ notice.text|raw }}</div>
{% endfor %}

{%if show_sourcepawn_message %}
<div class="alert alert-block alert-info">Update to SourceMod 1.10.0.6431 or later for improved SourcePawn stack traces.<br>This crash is from a server running a version of SourceMod that does not fully support SourcePawn stack walking and the stack trace displayed may be incomplete or incorrect.</div>
{% endif %}

{% if crash.thread != 0 %}
<div class="alert alert-block alert-info">This crash is not from the main thread.<br>The stack trace displayed below is of the thread that crashed.</div>
{% endif %}

{% if has_error_string and can_manage %}
<div id="error-details" class="alert alert-block alert-warning"><i class="icon-cog icon-spin"></i></div>
{% endif %}

{% if modules|length == 0 %}
<div class="alert alert-block alert-warning">This crash is missing a module list and will not have symbol information.</div>
{% endif %}

<div class="alert alert-block alert-info">
{% if stats['crashes'] != 1 %}
    <a class="alert-link" href="{{ path('stats', {module: crash.stackhash}) }}">{{ stats['crashes'] }} reports share this crash signature.</a> ({{ stats['owners'] }} owner{% if stats['owners'] != 1 %}s{% endif %} / {{ stats['ips'] }} ip{% if stats['ips'] != 1 %}s{% endif %})
{% else %}
    <a class="alert-link" href="{{ path('stats', {module: crash.stackhash}) }}">This crash signature is unique.</a>
{% endif %}
{% if crash.stackhash %}
    <span class="muted"> &middot; </span><a class="alert-link" href="#signature-notes" data-toggle="collapse">View {{ signature_notes_total }} signature note{% if signature_notes_total != 1 %}s{% endif %}</a>
{% if legacy_app.user %}
{% if can_create_signature_note %}
    <span class="muted"> &middot; </span><a class="alert-link" href="#signature-note-form" data-toggle="collapse">Write a note</a>
{% elseif user_signature_note %}
    <span class="muted"> &middot; </span><a class="alert-link" href="#signature-note-edit-{{ user_signature_note.id }}" data-toggle="collapse" data-open-signature-notes="1">Edit your note</a>
{% endif %}
{% else %}
    <span class="muted"> &middot; Login to write a note</span>
{% endif %}
{% endif %}
</div>
{% if crash.stackhash %}
{% set note_errors = legacy_app.session.flashbag.get('error_note') %}
<div id="signature-notes" class="collapse{% if note_errors|length > 0 %} in{% endif %}">
{% for error in note_errors %}
    <div class="alert alert-block alert-danger">{{ error }}</div>
{% endfor %}
{% if signature_notes|length > 0 %}
    <div class="well">
        <h3 style="margin-top: 0;">Crash Signature Notes</h3>
{% for note in signature_notes %}
        <div class="signature-note">
            <div class="signature-note-header">
                <div>
                    <strong>{{ note.title }}</strong>
                </div>
                <div class="signature-note-header-meta">
                    <span>by {{ note.author_name ?: ('User #' ~ note.author_id) }} on {{ note.created_at|date }}{% if note.updated_at %}, edited {{ note.updated_at|date }}{% endif %}</span>
{% if note.can_pin %}
                    <form action="{{ path('signature_note_pin', {id: crash.id, noteId: note.id}) }}" method="post" class="signature-note-pin-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('signature-note-pin:' ~ note.id) }}">
                        <input type="hidden" name="notes_page" value="{{ signature_notes_page }}">
                        <button type="submit" class="btn btn-link btn-mini signature-note-pin{% if note.pinned %} active{% endif %}" title="{% if note.pinned %}Pinned on {{ note.pinned_at ? note.pinned_at|date : 'unknown date' }}. Click to unpin.{% else %}Pin{% endif %}"><i class="icon-pushpin"></i></button>
                    </form>
{% elseif note.pinned %}
                    <span class="signature-note-pin static" title="Pinned on {{ note.pinned_at ? note.pinned_at|date : 'unknown date' }}"><i class="icon-pushpin"></i></span>
{% endif %}
                </div>
            </div>
            <div class="signature-note-body">{{ note.body_html|raw }}</div>
            <div class="signature-note-footer">
                <div class="signature-note-votes">
{% if legacy_app.user %}
                    <form action="{{ path('signature_note_vote', {id: crash.id, noteId: note.id}) }}" method="post" class="signature-note-vote-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('signature-note-vote:' ~ note.id) }}">
                        <input type="hidden" name="notes_page" value="{{ signature_notes_page }}">
                        <input type="hidden" name="value" value="1">
                        <button type="submit" class="btn btn-link btn-mini signature-note-vote-button positive{% if note.user_vote > 0 %} active{% endif %}" title="Like">
                            <i class="icon-thumbs-up"></i>
                            (<span class="signature-note-vote-count positive">{{ note.likes }}</span>)
                        </button>
                    </form>
                    <form action="{{ path('signature_note_vote', {id: crash.id, noteId: note.id}) }}" method="post" class="signature-note-vote-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('signature-note-vote:' ~ note.id) }}">
                        <input type="hidden" name="notes_page" value="{{ signature_notes_page }}">
                        <input type="hidden" name="value" value="-1">
                        <button type="submit" class="btn btn-link btn-mini signature-note-vote-button negative{% if note.user_vote < 0 %} active{% endif %}" title="Dislike">
                            <i class="icon-thumbs-down"></i>
                            (<span class="signature-note-vote-count negative">{{ note.dislikes }}</span>)
                        </button>
                    </form>
{% else %}
                    <span class="signature-note-vote-button positive" title="Likes"><i class="icon-thumbs-up"></i> (<span class="signature-note-vote-count positive">{{ note.likes }}</span>)</span>
                    <span class="signature-note-vote-button negative" title="Dislikes"><i class="icon-thumbs-down"></i> (<span class="signature-note-vote-count negative">{{ note.dislikes }}</span>)</span>
{% endif %}
                </div>
{% if note.can_edit or note.can_delete %}
                <div class="signature-note-actions">
{% if note.can_edit %}
                    <a href="#signature-note-edit-{{ note.id }}" data-toggle="collapse">Edit</a>
{% endif %}
{% if note.can_delete %}
                    <button type="button" class="btn btn-link btn-mini" data-toggle="modal" data-target="#signature-note-delete-{{ note.id }}">Delete</button>
{% endif %}
                </div>
{% endif %}
            </div>
{% if note.can_edit %}
            <form id="signature-note-edit-{{ note.id }}" class="collapse signature-note-edit" action="{{ path('signature_note_edit', {id: crash.id, noteId: note.id}) }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('signature-note-edit:' ~ note.id) }}">
                <input type="hidden" name="notes_page" value="{{ signature_notes_page }}">
                <input type="text" name="title" class="form-control input-block-level" maxlength="100" value="{{ note.title }}" required>
                <div class="markdown-editor" data-markdown-editor>
                    <ul class="nav nav-tabs markdown-tabs">
                        <li class="active"><a href="#" data-md-tab="write">Write</a></li>
                        <li><a href="#" data-md-tab="preview">Preview</a></li>
                    </ul>
                    <div class="markdown-toolbar">
                        <button type="button" title="Heading" data-md-action="heading"><i class="icon-font"></i></button>
                        <button type="button" title="Bold" data-md-action="bold"><strong>B</strong></button>
                        <button type="button" title="Italic" data-md-action="italic"><em>I</em></button>
                        <button type="button" title="Quote" data-md-action="quote"><i class="icon-indent-left"></i></button>
                        <button type="button" title="Code" data-md-action="code"><i class="icon-code"></i></button>
                        <button type="button" title="Link" data-md-action="link"><i class="icon-link"></i></button>
                        <span class="markdown-toolbar-divider"></span>
                        <button type="button" title="Bulleted list" data-md-action="ul"><i class="icon-list-ul"></i></button>
                        <button type="button" title="Numbered list" data-md-action="ol"><i class="icon-list-ol"></i></button>
                        <button type="button" title="Task list" data-md-action="task"><i class="icon-check"></i></button>
                        <span class="markdown-toolbar-divider"></span>
                        <button type="button" title="Mention" data-md-action="mention">@</button>
                        <button type="button" title="Reference" data-md-action="reference"><i class="icon-external-link"></i></button>
                        <button type="button" title="Undo" data-md-action="undo"><i class="icon-undo"></i></button>
                    </div>
                    <textarea name="body" class="form-control input-block-level" maxlength="500" rows="4" required>{{ note.body }}</textarea>
                    <div class="markdown-preview signature-note-body" style="display: none;"></div>
                </div>
                <button type="submit" class="btn btn-primary btn-small">Save note</button>
            </form>
{% endif %}
{% if note.can_delete %}
            <div id="signature-note-delete-{{ note.id }}" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="signature-note-delete-title-{{ note.id }}" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form action="{{ path('signature_note_delete', {id: crash.id, noteId: note.id}) }}" method="post">
                            <input type="hidden" name="_token" value="{{ csrf_token('signature-note-delete:' ~ note.id) }}">
                            <input type="hidden" name="notes_page" value="{{ signature_notes_page }}">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                <h3 id="signature-note-delete-title-{{ note.id }}">Delete Signature Note?</h3>
                            </div>
                            <div class="modal-body">
                                <p>This will permanently delete this note.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger"><i class="icon-trash"></i> Delete</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
{% endif %}
        </div>
{% endfor %}
{% if signature_notes_pages > 1 %}
        <div class="signature-notes-pagination">
            <ul>
                <li class="{{ signature_notes_page > 1 ? '' : 'disabled' }}">
                    <a {% if signature_notes_page > 1 %}href="{{ path('details', {id: crash.id, notes_page: signature_notes_page - 1}) ~ '#signature-notes' }}"{% endif %}>&larr; Previous</a>
                </li>
                <li class="active">
                    <span>{{ signature_notes_page }}</span>
                </li>
                <li class="{{ signature_notes_page < signature_notes_pages ? '' : 'disabled' }}">
                    <a {% if signature_notes_page < signature_notes_pages %}href="{{ path('details', {id: crash.id, notes_page: signature_notes_page + 1}) ~ '#signature-notes' }}"{% endif %}>Next &rarr;</a>
                </li>
            </ul>
        </div>
{% endif %}
    </div>
{% else %}
    <div class="well muted">No notes for this crash signature yet.</div>
{% endif %}
</div>
{% if legacy_app.user and can_create_signature_note %}
<div id="signature-note-form" class="collapse{% if note_errors|length > 0 %} in{% endif %}">
    <div class="well">
        <h3 style="margin-top: 0;">Write a Signature Note</h3>
        <form action="{{ path('signature_note_create', {id: crash.id}) }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('signature-note:' ~ crash.id) }}">
            <input type="hidden" name="notes_page" value="{{ signature_notes_page }}">
            <label for="signature-note-title">Title</label>
            <input id="signature-note-title" type="text" name="title" class="form-control input-block-level" maxlength="100" required>
            <label for="signature-note-body">Note</label>
            <div class="markdown-editor" data-markdown-editor>
                <ul class="nav nav-tabs markdown-tabs">
                    <li class="active"><a href="#" data-md-tab="write">Write</a></li>
                    <li><a href="#" data-md-tab="preview">Preview</a></li>
                </ul>
                <div class="markdown-toolbar">
                    <button type="button" title="Heading" data-md-action="heading"><i class="icon-font"></i></button>
                    <button type="button" title="Bold" data-md-action="bold"><strong>B</strong></button>
                    <button type="button" title="Italic" data-md-action="italic"><em>I</em></button>
                    <button type="button" title="Quote" data-md-action="quote"><i class="icon-indent-left"></i></button>
                    <button type="button" title="Code" data-md-action="code"><i class="icon-code"></i></button>
                    <button type="button" title="Link" data-md-action="link"><i class="icon-link"></i></button>
                    <span class="markdown-toolbar-divider"></span>
                    <button type="button" title="Bulleted list" data-md-action="ul"><i class="icon-list-ul"></i></button>
                    <button type="button" title="Numbered list" data-md-action="ol"><i class="icon-list-ol"></i></button>
                    <button type="button" title="Task list" data-md-action="task"><i class="icon-check"></i></button>
                    <span class="markdown-toolbar-divider"></span>
                    <button type="button" title="Mention" data-md-action="mention">@</button>
                    <button type="button" title="Reference" data-md-action="reference"><i class="icon-external-link"></i></button>
                    <button type="button" title="Undo" data-md-action="undo"><i class="icon-undo"></i></button>
                </div>
                <textarea id="signature-note-body" name="body" class="form-control input-block-level" maxlength="500" rows="5" required></textarea>
                <div class="markdown-preview signature-note-body" style="display: none;"></div>
            </div>
            <p class="muted">Markdown is supported. Title limit: 100 characters. Note limit: 500 characters.</p>
            <button type="submit" class="btn btn-primary">Save note</button>
        </form>
    </div>
</div>
{% endif %}
{% endif %}
{% endif %}

{% if can_manage %}
<div class="well clearfix">
{% if crash.dump_available %}
    <a class="btn btn-primary" href="{{ path('download', {'id': crash.id}) }}"><i class="icon-download"></i> Download Minidump</a>
{% endif %}
{% if crash.has_console_log %}
    <a class="btn btn-default" href="{{ path('console', {'id': crash.id}) }}"><i class="icon-terminal"></i> View Console</a>
{% endif %}
{% if processing_log %}
    <a class="btn btn-default" href="{{ path('logs', {'id': crash.id}) }}"><i class="icon-cogs"></i> Processing Log</a>
{% endif %}
    <div class="pull-right">
{% if crash.dump_available %}
        <a class="btn btn-default" href="{{ path('carburetor', {'id': crash.id}) }}"><i class="icon-eye-open"></i> View Raw</a>
{% endif %}
{% if legacy_app.user.admin and crash.processed == 1 %}
        <form action="{{ path('reprocess', {id: crash.id, return: legacy_app.request.pathInfo}) }}" method="post" class="button-form">
            <input type="hidden" name="_token" value="{{ csrf_token('reprocess-crash:' ~ crash.id) }}">
            <button type="submit" class="btn btn-default"><i class="icon-refresh"></i> Reprocess</button>
        </form>
{% endif %}
        <form action="{{ path('delete', {id: crash.id}) }}" method="post" class="button-form">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-crash:' ~ crash.id) }}">
            <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#delete-crash-modal"><i class="icon-trash"></i> Delete</button>
        </form>
    </div>
</div>
<div id="delete-crash-modal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="delete-crash-modal-title" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="{{ path('delete', {id: crash.id}) }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-crash:' ~ crash.id) }}">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h3 id="delete-crash-modal-title">Delete Crash Dump?</h3>
                </div>
                <div class="modal-body">
                    <p>This will permanently delete this crash report and its stored minidump data.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="icon-trash"></i> Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}

{% if can_manage and crash.processed == 0 %}
<h2 id="modules">Modules</h2>
<div class="alert alert-block alert-info">This crash is still pending processing; symbol coverage may be incomplete.</div>
{% endif %}

{% if crash.processed == 1 and crash.failed == 0 %}
{% if can_manage and (sourcemod_snapshots.plugins or sourcemod_snapshots.extensions) %}
<h2>SourceMod Snapshot</h2>
<div class="well">
    <button class="btn btn-default btn-sm" type="button" data-toggle="collapse" data-target="#sourcemod-snapshot">
        Show SourceMod plugin and extension lists
    </button>
    <div id="sourcemod-snapshot" class="collapse" style="margin-top: 10px;">
{% if sourcemod_snapshots.plugins %}
        <h4>Plugins</h4>
        <pre>{{ sourcemod_snapshots.plugins }}</pre>
{% endif %}
{% if sourcemod_snapshots.extensions %}
        <h4>Extensions</h4>
        <pre>{{ sourcemod_snapshots.extensions }}</pre>
{% endif %}
    </div>
</div>
{% endif %}

<div class="clearfix">
    <h2 class="pull-left">Stack Trace</h2>
    <button type="button" class="btn btn-default btn-sm pull-right" id="copy-stacktrace" style="margin-top: 18px;" title="Copy stack trace" data-toggle="tooltip" data-container="body">
        <i class="icon-copy"></i>
    </button>
</div>
<div class="well well-tight">
    <table class="table table-stacktrace table-shown">
        <thead>
            <tr>
                <th></th>
                <th>Function</th>
            </tr>
        </thead>
        <tbody>
{% for frame in stack %}
            <tr class="{% if '__SourceHook_' in frame.rendered %}text-muted{% endif %}" data-stack-frame="{{ frame.frame }}" data-stack-rendered="{{ frame.rendered|e('html_attr') }}">
                <th>{{ frame.frame }}</th>
                <td class="monospace">
                  {{ frame.rendered }}
{% if frame.url %}
                  <a href="{{ frame.url }}"><i class="icon-external-link"></i></a>
{% endif %}
{% if '__SourceHook_' in frame.rendered %}
                  <span class="pull-right" data-toggle="tooltip" data-container="body" data-placement="bottom" title="This frame is from a function hook and is most likely unrelated to the cause of the crash."><i class="icon-anchor"></i></span>
{% endif %}
                </td>
            </tr>
{% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <td colspan="2"><i class="icon-ellipsis-horizontal"></i></td>
            </tr>
        </tfoot>
    </table>
</div>

{% if culprit_candidates|length > 0 %}
<h2>Likely Cause</h2>
<p class="muted">This heuristic prefers raw stack SourcePawn/JIT chains, then explicit native/extension crash sites, then tightly-correlated terminal SourceMod console exceptions.</p>
{% set primary = culprit_candidates[0] %}
<div class="well">
    <div class="row">
        <div class="col-sm-5">
            <div class="muted">Primary suspect</div>
            <h3 style="margin-top: 4px; margin-bottom: 8px;" class="monospace">{{ primary.label }}</h3>
            <span class="label {{ primary.kind_class|default('label-default') }}" title="{{ primary.kind_title|default('Candidate produced by stack, symbol, metadata, or log heuristics.') }}" data-toggle="tooltip" data-container="body">{{ primary.kind|default('Candidate') }}</span>
        </div>
        <div class="col-sm-2">
            <div class="muted">Score</div>
            <div class="progress" style="margin-top: 8px;">
                <div class="progress-bar" style="width: {{ primary.percent }}%;">{{ primary.percent }}%</div>
            </div>
        </div>
        <div class="col-sm-5">
            <div class="muted">Primary signals</div>
            <ul style="margin-bottom: 0;">
{% for reason in primary.reasons %}
                <li>{{ reason }}</li>
{% endfor %}
            </ul>
        </div>
    </div>
</div>
{% for group in culprit_groups %}
<div class="well well-tight">
    <h4 style="margin: 0 0 8px;">{{ group.label }}</h4>
    <table class="table table-condensed" style="margin-bottom: 0;">
        <thead>
            <tr>
                <th>Candidate</th>
                <th style="width: 150px;">Type</th>
                <th style="width: 120px;">Score</th>
                <th>Signals</th>
            </tr>
        </thead>
        <tbody>
{% for candidate in group.candidates %}
            <tr>
                <td class="monospace">{{ candidate.label }}</td>
                <td><span class="label {{ candidate.kind_class|default('label-default') }}" title="{{ candidate.kind_title|default('Candidate produced by stack, symbol, metadata, or log heuristics.') }}" data-toggle="tooltip" data-container="body">{{ candidate.kind|default('Candidate') }}</span></td>
                <td>
                    <div class="progress" style="margin-bottom: 0;">
                        <div class="progress-bar" style="width: {{ candidate.percent }}%;">{{ candidate.percent }}%</div>
                    </div>
                </td>
                <td>
                    <ul style="margin-bottom: 0;">
{% for reason in candidate.reasons %}
                        <li>{{ reason }}</li>
{% endfor %}
                    </ul>
                </td>
            </tr>
{% endfor %}
        </tbody>
    </table>
</div>
{% endfor %}
{% endif %}

{% if can_manage %}
<h2 id="modules">Modules</h2>
{% if symbol_coverage.total > 0 %}
<div class="well">
    <div class="row">
        <div class="col-sm-3"><strong>{{ symbol_coverage.percent }}%</strong><br><span class="text-muted">symbol coverage</span></div>
        <div class="col-sm-3"><strong>{{ symbol_coverage.with_symbols }}</strong><br><span class="text-muted">with symbols</span></div>
        <div class="col-sm-3"><strong>{{ symbol_coverage.missing }}</strong><br><span class="text-muted">missing</span></div>
        <div class="col-sm-3"><strong>{{ symbol_coverage.invalid }}</strong><br><span class="text-muted">invalid id</span></div>
    </div>
</div>
{% endif %}
{% if modules|length > 0 %}
<div class="well well-tight">
    <div class="modules-toolbar clearfix">
        <div class="btn-group btn-group-sm pull-left" data-toggle="buttons-radio">
            <button type="button" class="btn btn-default active" data-module-filter="all">All</button>
            <button type="button" class="btn btn-default" data-module-filter="missing">Missing</button>
            <button type="button" class="btn btn-default" data-module-filter="available">Available</button>
            <button type="button" class="btn btn-default" data-module-filter="invalid-id">Invalid</button>
            <button type="button" class="btn btn-default" data-module-filter="useful">Useful</button>
        </div>
        <button type="button" class="btn btn-default btn-sm pull-right" id="show-all-modules">Show all modules</button>
    </div>
    <table class="table table-modules">
        <thead>
            <tr>
                <th>Status</th>
                <th>Module</th>
                <th>Identifier</th>
                <th>Base</th>
                <th>Useful</th>
                <th>Policy hint</th>
            </tr>
        </thead>
        <tbody>
{% for module in modules %}
{% set module_status_key = module.coverage_status|lower|replace({' ': '-'}) %}
{% set default_hidden = loop.index > 18 and module.coverage_status == 'Available' and module.usefulness_hint != 'High' %}
            <tr class="module-row {{ module.coverage_class }}{% if default_hidden %} module-extra hidden{% endif %}" data-module-status="{{ module_status_key }}" data-module-useful="{{ module.usefulness_hint|lower }}">
                <td>{{ module.coverage_status }}</td>
                <td>{{ module.name }}</td>
                <td class="monospace">{{ module.identifier }}</td>
                <td class="monospace">{{ module.base|address }}</td>
                <td>{{ module.usefulness_hint }}</td>
                <td>{{ module.policy_hint }}</td>
            </tr>
{% endfor %}
        </tbody>
    </table>
    <div class="modules-empty text-center muted hidden">No modules match this filter.</div>
{% if symbol_upload_log is defined and symbol_upload_log|length > 0 %}
    <div class="table-more module-log-toggle">
        <a href="#symbol-upload-log" data-toggle="collapse"><i class="icon-ellipsis-horizontal"></i> Symbol Upload Log</a>
    </div>
    <div id="symbol-upload-log" class="collapse">
        <div class="module-upload-log">
            <table class="table table-condensed">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Endpoint</th>
                        <th>Module</th>
                        <th>Identifier</th>
                        <th>Status</th>
                        <th>Result</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
{% for entry in symbol_upload_log %}
                    <tr class="{% if entry.status_code >= 400 %}danger{% elseif entry.result == 'stored' %}success{% endif %}">
                        <td class="nowrap">{{ entry.created_at }}</td>
                        <td>{{ entry.endpoint }}</td>
                        <td>{{ entry.module }}</td>
                        <td class="monospace">{{ entry.identifier }}</td>
                        <td>{{ entry.status_code }}</td>
                        <td>{{ entry.result }}</td>
                        <td>{{ entry.reason }}</td>
                    </tr>
{% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
</div>
{% endif %}
{% endif %}
{% endif %}
{% endblock %}

{% block scripts %}
<script src="{{ legacy_app.request.baseUrl }}/js/jquery.hoverIntent.min.js"></script>
<script type="text/javascript">
    $('.table-stacktrace tbody tr').hoverIntent(function() { $(this).toggleClass('stackframe-expand'); });

    $('#copy-stacktrace').on('click', function() {
        var lines = [];
        $('.table-stacktrace tbody tr').each(function() {
            var frame = $(this).data('stack-frame');
            var rendered = $(this).data('stack-rendered');
            if (frame !== undefined && rendered) {
                lines.push('#' + frame + ' ' + rendered);
            }
        });

        var text = lines.join('\n');
        if (!text) {
            return;
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text);
            return;
        }

        var textarea = $('<textarea>').val(text).css({position: 'fixed', left: '-9999px', top: '0'});
        $('body').append(textarea);
        textarea[0].focus();
        textarea[0].select();
        document.execCommand('copy');
        textarea.remove();
    });

    $('.table-shown').each(function() {
        var table = $(this);
        if (table.find('tbody tr').length <= 10 || table.find('tfoot').length === 0) {
            return;
        }

        table.toggleClass('table-shown').toggleClass('table-hidden').find('tfoot').click(function() {
            $(this).parent().toggleClass('table-hidden').toggleClass('table-shown');
        });
    });

    (function() {
        var moduleRows = $('.table-modules .module-row');
        var showAll = false;
        var activeFilter = 'all';

        function applyModuleFilter() {
            var visible = 0;
            moduleRows.each(function() {
                var row = $(this);
                var matches = activeFilter === 'all'
                    || row.data('module-status') === activeFilter
                    || (activeFilter === 'useful' && row.data('module-useful') === 'high');
                var hiddenByLimit = !showAll && row.hasClass('module-extra');
                row.toggleClass('hidden', !matches || hiddenByLimit);
                if (matches && !hiddenByLimit) {
                    visible++;
                }
            });
            $('.modules-empty').toggleClass('hidden', visible !== 0);
            $('#show-all-modules').toggleClass('hidden', showAll || activeFilter !== 'all' || $('.table-modules .module-extra').length === 0);
        }

        $('[data-module-filter]').on('click', function() {
            $('[data-module-filter]').removeClass('active');
            $(this).addClass('active');
            activeFilter = $(this).data('module-filter');
            applyModuleFilter();
        });

        $('#show-all-modules').on('click', function() {
            showAll = true;
            applyModuleFilter();
        });

        applyModuleFilter();
    })();

    if (window.location.hash === '#signature-notes' || window.location.hash === '#signature-note-form') {
        $(window.location.hash).collapse('show');
    }
    if (window.location.hash && window.location.hash.indexOf('#signature-note-edit-') === 0) {
        $('#signature-notes').collapse('show');
        $(window.location.hash).collapse('show');
    }

    $('[data-open-signature-notes]').on('click', function() {
        $('#signature-notes').collapse('show');
    });

    function renderMarkdownPreview(text) {
        var escaped = $('<div>').text(text || '').html();
        escaped = escaped.replace(/`([^`\n]+)`/g, '<code>$1</code>')
            .replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>')
            .replace(/\*([^*\n]+)\*/g, '<em>$1</em>')
            .replace(/\[([^\]\n]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" rel="nofollow noopener noreferrer" target="_blank">$1</a>');

        var html = [];
        var list = null;
        var paragraph = [];
        var closeList = function() {
            if (list) {
                html.push('</' + list + '>');
                list = null;
            }
        };
        var flushParagraph = function() {
            if (paragraph.length) {
                html.push('<p>' + paragraph.join('<br>') + '</p>');
                paragraph = [];
            }
        };

        escaped.split(/\n/).forEach(function(line) {
            line = line.replace(/\s+$/, '');
            var match;
            if (!line) {
                flushParagraph();
                closeList();
                return;
            }
            if ((match = line.match(/^#{1,3}\s+(.+)$/))) {
                flushParagraph();
                closeList();
                html.push('<strong>' + match[1] + '</strong>');
                return;
            }
            if ((match = line.match(/^&gt;\s*(.+)$/))) {
                flushParagraph();
                closeList();
                html.push('<blockquote>' + match[1] + '</blockquote>');
                return;
            }
            if ((match = line.match(/^- \[( |x)\]\s+(.+)$/i))) {
                flushParagraph();
                if (list !== 'ul') {
                    closeList();
                    html.push('<ul>');
                    list = 'ul';
                }
                html.push('<li>' + (match[1].toLowerCase() === 'x' ? '&#9745; ' : '&#9744; ') + match[2] + '</li>');
                return;
            }
            if ((match = line.match(/^[-*]\s+(.+)$/))) {
                flushParagraph();
                if (list !== 'ul') {
                    closeList();
                    html.push('<ul>');
                    list = 'ul';
                }
                html.push('<li>' + match[1] + '</li>');
                return;
            }
            if ((match = line.match(/^\d+\.\s+(.+)$/))) {
                flushParagraph();
                if (list !== 'ol') {
                    closeList();
                    html.push('<ol>');
                    list = 'ol';
                }
                html.push('<li>' + match[1] + '</li>');
                return;
            }
            closeList();
            paragraph.push(line);
        });

        flushParagraph();
        closeList();
        return html.join('\n') || '<p class="muted">Nothing to preview.</p>';
    }

    $('[data-markdown-editor]').each(function() {
        var editor = $(this);
        var textarea = editor.find('textarea');
        var preview = editor.find('.markdown-preview');

        function selectedText(placeholder) {
            var element = textarea[0];
            var start = element.selectionStart || 0;
            var end = element.selectionEnd || 0;
            var text = textarea.val().substring(start, end);
            if (text) {
                return text;
            }

            return placeholder;
        }

        function replaceSelection(before, after, placeholder) {
            var element = textarea[0];
            var value = textarea.val();
            var start = element.selectionStart || 0;
            var end = element.selectionEnd || 0;
            var text = value.substring(start, end) || placeholder;
            var replacement = before + text + after;
            textarea.val((value.substring(0, start) + replacement + value.substring(end)).substring(0, 500));
            textarea.focus();
            element.selectionStart = start + before.length;
            element.selectionEnd = start + before.length + text.length;
        }

        editor.find('[data-md-action]').on('click', function() {
            var action = $(this).data('md-action');
            if (action === 'heading') replaceSelection('### ', '', 'Heading');
            if (action === 'bold') replaceSelection('**', '**', 'strong text');
            if (action === 'italic') replaceSelection('*', '*', 'emphasized text');
            if (action === 'quote') replaceSelection('> ', '', 'quoted text');
            if (action === 'code') replaceSelection('`', '`', 'code');
            if (action === 'link') replaceSelection('[', '](https://example.com)', 'link text');
            if (action === 'ul') replaceSelection('- ', '', 'list item');
            if (action === 'ol') replaceSelection('1. ', '', 'list item');
            if (action === 'task') replaceSelection('- [ ] ', '', 'task');
            if (action === 'mention') replaceSelection('@', '', 'username');
            if (action === 'reference') replaceSelection('#', '', '123');
            if (action === 'undo') document.execCommand('undo');
            if (preview.is(':visible')) {
                preview.html(renderMarkdownPreview(textarea.val()));
            }
        });

        editor.find('[data-md-tab]').on('click', function(event) {
            event.preventDefault();
            var tab = $(this).data('md-tab');
            editor.find('.markdown-tabs li').removeClass('active');
            $(this).parent().addClass('active');
            if (tab === 'preview') {
                preview.html(renderMarkdownPreview(textarea.val())).show();
                textarea.hide();
            } else {
                preview.hide();
                textarea.show().focus();
            }
        });
    });

{% if has_error_string %}
    $.getJSON('{{ path('error', {id: crash.id}) }}', function(data) {
        if (data.string) {
            $('#error-details').text(data.string);
        }
    });
{% endif %}
</script>
{% endblock %}

