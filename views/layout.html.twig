<!DOCTYPE html>
{% set theme_preference = legacy_app.user ? legacy_app.user.theme|default('light') : 'light' %}
<html lang="en" data-theme-preference="{{ theme_preference }}">
    <head>
        <meta charset="utf-8">
        <meta content="IE=EDGE" http-equiv="X-UA-Compatible">
{% if supports_mobile|default(false) %}
        <meta name="viewport" content="width=device-width, initial-scale=1">
{% endif %}
        <title>Throttle</title>
{% if theme_preference == 'dark' %}
        <style>html,body{background:#15191f;color:#d7dde6;color-scheme:dark;}</style>
{% elseif theme_preference == 'system' %}
        <style>@media (prefers-color-scheme: dark){html,body{background:#15191f;color:#d7dde6;color-scheme:dark;}}</style>
{% endif %}
        <link href="{{ legacy_app.request.baseUrl }}/css/bootstrap.no-icons.min.css" rel="stylesheet">
        <link href="{{ legacy_app.request.baseUrl }}/css/font-awesome.min.css" rel="stylesheet">
{% block stylesheets %}{% endblock %}
        <link href="{{ legacy_app.request.baseUrl }}/css/application.css" rel="stylesheet">
{% if theme_preference == 'dark' %}
        <style>html,body{background:#15191f;color:#d7dde6;color-scheme:dark;}</style>
{% elseif theme_preference == 'system' %}
        <style>@media (prefers-color-scheme: dark){html,body{background:#15191f;color:#d7dde6;color-scheme:dark;}}</style>
{% endif %}
{% if 'Kindle/3.0' in legacy_app.request.headers.get('User-Agent') %}
        <link href="{{ legacy_app.request.baseUrl }}/css/kindle.css" rel="stylesheet">
{% endif %}
    </head>
    <body class="theme-{{ theme_preference == 'system' ? 'light' : theme_preference }}" data-theme-preference="{{ theme_preference }}">
        <div class="navbar navbar-default navbar-static-top">
            <div class="container">
                <a class="navbar-brand" href="/"><i class="icon-dashboard"></i> Throttle</a>
                <div class="pull-right">
{% if legacy_app.user %}
                    {{ include('_account_menu_legacy.html.twig') }}
{% else %}
                    <a href="{{ path('login_steam', {'return': legacy_app.request.pathInfo}) }}" class="btn btn-success navbar-btn"><i class="icon-signin"></i> Login with Steam</a>
{% endif %}
                </div>
            </div>
        </div>
        <div class="container">
{% for error in legacy_app.session.flashbag.get('error_auth') %}
            <div class="alert alert-danger">{{ error }}</div>
{% endfor %}
{% block content %}{% endblock %}
        </div>
        <div id="footer" class="container text-center">
            <small class="text-muted"><a href="{{ path('stats') }}">Statistics</a>{% if legacy_app.version is defined and legacy_app.version %}<br>Version <a href="https://github.com/asherkin/throttle" class="text-muted">{{ legacy_app.version }}</a>{% endif %}</small>
        </div>
        <script src="{{ legacy_app.request.baseUrl }}/js/jquery.min.js"></script>
        <script src="{{ legacy_app.request.baseUrl }}/js/bootstrap.min.js"></script>
        <script type="text/javascript">
        (function() {
            var body = document.body;
            if (!body || body.getAttribute('data-theme-preference') !== 'system') {
                return;
            }

            var media = window.matchMedia('(prefers-color-scheme: dark)');
            var apply = function() {
                body.classList.toggle('theme-dark', media.matches);
                body.classList.toggle('theme-light', !media.matches);
            };

            apply();
            if (media.addEventListener) {
                media.addEventListener('change', apply);
            }
        })();

        $(function() {
            $('[data-toggle="tooltip"]').tooltip();
        })
        </script>
{% block scripts %}{% endblock %}
    </body>
</html>

