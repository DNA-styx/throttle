<!DOCTYPE html>
{% set theme_preference = 'system' %}
<html lang="en" data-theme-preference="{{ theme_preference }}">
    <head>
        <meta charset="utf-8">
        <meta content="IE=EDGE" http-equiv="X-UA-Compatible">
{% if supports_mobile|default(false) %}
        <meta name="viewport" content="width=device-width, initial-scale=1">
{% endif %}
        <title>Throttle</title>
        <script>
        (function() {
            var root = document.documentElement;
            var stored = null;
            try {
                stored = window.localStorage && window.localStorage.getItem('throttleTheme');
            } catch (e) {}
            var preference = /^(light|dark|system)$/.test(stored || '') ? stored : (root.getAttribute('data-theme-preference') || 'system');
            if (!/^(light|dark|system)$/.test(preference)) {
                preference = 'system';
            }
            var effective = preference === 'system' && window.matchMedia
                ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : preference;
            root.setAttribute('data-theme-preference', preference);
            root.setAttribute('data-effective-theme', effective === 'dark' ? 'dark' : 'light');
        })();
        </script>
        <style>html[data-effective-theme="dark"],html[data-effective-theme="dark"] body{background:#15191f;color:#d7dde6;color-scheme:dark;}</style>
        <link href="{{ legacy_app.request.baseUrl }}/css/bootstrap.no-icons.min.css" rel="stylesheet">
        <link href="{{ legacy_app.request.baseUrl }}/css/font-awesome.min.css" rel="stylesheet">
{% block stylesheets %}{% endblock %}
        <link href="{{ legacy_app.request.baseUrl }}/css/application.css" rel="stylesheet">
{% if 'Kindle/3.0' in legacy_app.request.headers.get('User-Agent') %}
        <link href="{{ legacy_app.request.baseUrl }}/css/kindle.css" rel="stylesheet">
{% endif %}
    </head>
    <body class="theme-light" data-theme-preference="{{ theme_preference }}">
        <div class="navbar navbar-default navbar-static-top">
            <div class="container-fluid navbar-shell">
                <div class="navbar-start">
                <div class="theme-switcher" role="group" aria-label="Theme">
                    <button type="button" class="theme-switcher-btn" data-theme-choice="light" title="Light theme" aria-label="Light theme">
                        <svg class="theme-switcher-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9zm0-3a.6.6 0 0 1 .6.6v1.2a.6.6 0 1 1-1.2 0V1.1A.6.6 0 0 1 8 .5zm0 12.6a.6.6 0 0 1 .6.6v1.2a.6.6 0 1 1-1.2 0v-1.2a.6.6 0 0 1 .6-.6zM1.1 7.4h1.2a.6.6 0 1 1 0 1.2H1.1a.6.6 0 1 1 0-1.2zm12.6 0h1.2a.6.6 0 1 1 0 1.2h-1.2a.6.6 0 1 1 0-1.2zM3.2 3.2a.6.6 0 0 1 .8 0l.9.9a.6.6 0 1 1-.8.8L3.2 4a.6.6 0 0 1 0-.8zm8.9 8.9a.6.6 0 0 1 .8 0l.9.9a.6.6 0 1 1-.8.8l-.9-.9a.6.6 0 0 1 0-.8zm1.7-8.9a.6.6 0 0 1 0 .8l-.9.9a.6.6 0 1 1-.8-.8l.9-.9a.6.6 0 0 1 .8 0zM4.9 12.1a.6.6 0 0 1 0 .8l-.9.9a.6.6 0 1 1-.8-.8l.9-.9a.6.6 0 0 1 .8 0z"/></svg>
                    </button>
                    <button type="button" class="theme-switcher-btn" data-theme-choice="dark" title="Dark theme" aria-label="Dark theme">
                        <svg class="theme-switcher-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.8 10.6A6.3 6.3 0 0 1 5.4 2.2a.6.6 0 0 0-.7-.8 7 7 0 1 0 9.9 9.9.6.6 0 0 0-.8-.7z"/></svg>
                    </button>
                    <button type="button" class="theme-switcher-btn" data-theme-choice="system" title="System theme" aria-label="System theme">
                        <svg class="theme-switcher-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.2a6.8 6.8 0 1 0 0 13.6A6.8 6.8 0 0 0 8 1.2zM8 13.6V2.4a5.6 5.6 0 0 1 0 11.2z"/></svg>
                    </button>
                </div>
                <a class="navbar-brand throttle-brand-link" href="/">
                    <svg class="throttle-brand-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M8 4a.5.5 0 0 1 .5.5V6a.5.5 0 0 1-1 0V4.5A.5.5 0 0 1 8 4zM3.732 5.732a.5.5 0 0 1 .707 0l.915.914a.5.5 0 1 1-.708.708l-.914-.915a.5.5 0 0 1 0-.707zM2 10a.5.5 0 0 1 .5-.5h1.586a.5.5 0 0 1 0 1H2.5A.5.5 0 0 1 2 10zm9.5 0a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 0 1H12a.5.5 0 0 1-.5-.5zm.754-4.246a.389.389 0 0 0-.527-.02L7.547 9.31a.91.91 0 1 0 1.302 1.258l3.434-4.297a.389.389 0 0 0-.029-.518z"/>
                        <path fill-rule="evenodd" d="M0 10a8 8 0 1 1 15.547 2.661c-.442 1.253-1.845 1.602-2.932 1.25C11.309 13.488 9.475 13 8 13c-1.474 0-3.31.488-4.615.911-1.087.352-2.49.003-2.932-1.25A7.988 7.988 0 0 1 0 10zm8-7a7 7 0 0 0-6.603 9.329c.203.575.923.876 1.68.63C4.397 12.533 6.358 12 8 12s3.604.532 4.923.96c.757.245 1.477-.056 1.68-.631A7 7 0 0 0 8 3z"/>
                    </svg>
                    Throttle
                </a>
                </div>
                <div class="pull-right">
{% if legacy_app.user %}
                    {{ include('_account_menu_legacy.html.twig') }}
{% else %}
                    <a href="{{ path('login_steam', {'return': legacy_app.request.pathInfo}) }}" class="btn btn-success navbar-btn"><i class="icon-signin"></i> Login with Steam</a>
{% endif %}
                </div>
            </div>
        </div>
        <div class="container">
{% for error in legacy_app.session.flashbag.get('error_auth') %}
            <div class="alert alert-danger">{{ error }}</div>
{% endfor %}
{% block content %}{% endblock %}
        </div>
        <div id="footer" class="container text-center">
            <small class="text-muted"><a href="{{ path('stats') }}">Statistics</a>{% if legacy_app.version is defined and legacy_app.version %}<br>Version <a href="https://github.com/asherkin/throttle" class="text-muted">{{ legacy_app.version }}</a>{% endif %}</small>
        </div>
        <script src="{{ legacy_app.request.baseUrl }}/js/jquery.min.js"></script>
        <script src="{{ legacy_app.request.baseUrl }}/js/bootstrap.min.js"></script>
        <script type="text/javascript">
        (function() {
            var root = document.documentElement;
            var body = document.body;
            var media = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
            var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-theme-choice]'));

            if (!body) {
                return;
            }

            function storedPreference() {
                try {
                    var stored = window.localStorage && window.localStorage.getItem('throttleTheme');
                    return /^(light|dark|system)$/.test(stored || '') ? stored : null;
                } catch (e) {
                    return null;
                }
            }

            var apply = function(preference, persist) {
                preference = /^(light|dark|system)$/.test(preference || '') ? preference : 'system';
                var effective = preference === 'system' && media ? (media.matches ? 'dark' : 'light') : preference;
                root.setAttribute('data-theme-preference', preference);
                root.setAttribute('data-effective-theme', effective === 'dark' ? 'dark' : 'light');
                body.setAttribute('data-theme-preference', preference);
                body.classList.toggle('theme-dark', effective === 'dark');
                body.classList.toggle('theme-light', effective !== 'dark');
                buttons.forEach(function(button) {
                    var active = button.getAttribute('data-theme-choice') === preference;
                    button.classList.toggle('active', active);
                    button.setAttribute('aria-pressed', active ? 'true' : 'false');
                });
                if (persist) {
                    try {
                        window.localStorage && window.localStorage.setItem('throttleTheme', preference);
                    } catch (e) {}
                }
            };

            buttons.forEach(function(button) {
                button.addEventListener('click', function() {
                    apply(button.getAttribute('data-theme-choice'), true);
                });
            });
            apply(storedPreference() || root.getAttribute('data-theme-preference') || 'system', false);
            if (media && media.addEventListener) {
                media.addEventListener('change', function() {
                    apply(storedPreference() || root.getAttribute('data-theme-preference') || 'system', false);
                });
            }
        })();

        $(function() {
            $('[data-toggle="tooltip"]').tooltip();
        })
        </script>
{% block scripts %}{% endblock %}
    </body>
</html>

