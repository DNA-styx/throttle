{% extends 'layout.html.twig' %}

{% set logout_to_index = true %}
{% set hide_ignored = hide_ignored is defined ? hide_ignored : true %}
{% set dashboard_query = hide_ignored ? {user: userid} : {user: userid, hide_ignored: 0} %}
 
{% block content %}
<div class="dashboard-toolbar clearfix">
{% if shared|length > 1 or legacy_app.user.admin %}
    <ul class="pull-left nav nav-tabs nav-tabs-avatars">
        <li class="{{ userid == null ? 'active' }}" data-toggle="tooltip" data-container="body" data-placement="top" title="All">
            <a href="{{ path('dashboard', dashboard_query) }}" style="text-align: center; padding: 5px 8px; color: #333;">
                <i class="icon-fixed-width icon-group"></i>
            </a>
        </li>
{% for user in shared %}
        <li class="{{ userid == user.id ? 'active' }}" data-toggle="tooltip" data-container="body" data-placement="top" title="{{ user.name ?? user.id }}">
            <a href="{{ path('dashboard', dashboard_query|merge({ user: user.id })) }}">
                <img class="column-identicon" alt="{{ user.name ?? user.id }}'s crashes" src="{{ user.avatar ?? 'https://steamcdn-a.akamaihd.net/steamcommunity/public/images/avatars/fe/fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb_full.jpg' }}" width="20" height="20">
            </a>
        </li>
{% endfor %}
    </ul>
{% endif %}
    <label class="dashboard-filter-toggle pull-right" for="hide-ignored-crashes" data-toggle="tooltip" data-container="body" data-placement="top" title="Hide crashes that match an ignored signature. These reports keep only their primary details page and are usually not actionable.">
        <input id="hide-ignored-crashes" type="checkbox" autocomplete="off"{% if hide_ignored %} checked{% endif %}>
        <span class="dashboard-filter-switch" aria-hidden="true"></span>
        <span>Hide ignored crashes</span>
    </label>
</div>
<div class="well well-tight">
    <table class="table table-striped">
        <thead>
            <tr>
                <th></th>
                <th>Crash ID</th>
                <th>Uploaded</th>
                <th class="hidden-xs"></th>
                <th class="hidden-xs">Function</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
{% set last = null %}
{% for crash in crashes %}
{% set last = crash.timestamp %}
            <tr{% if crash.processed == 0 %} class="warning"{% elseif crash.failed == 1 %} class="danger"{% endif %}>
                <td>
{% if crash.cmdline %}
                    <img class="column-identicon" src="{{ crash.cmdline|identicon }}" width="20" height="20">
{% endif %}
                </td>
                <td class="monospace"><a href="{{ path('details', {id: crash.id}) }}">{{ crash.id|crashid }}<a>{% if crash.signature_ignored %} <i class="icon-warning-sign" style="color: #f0ad4e;" data-toggle="tooltip" data-container="body" data-placement="top" title="Ignored crash signature policy: this crash keeps only the primary details page. Console history, raw dump access, processing logs, and Discord webhook delivery were skipped.{% if crash.signature_ignored_reason %} Matched signature: {{ crash.signature_ignored_reason }}.{% endif %}"></i>{% endif %}</td>
                <td><span title="{{ crash.timestamp|date }}">{{ crash.timestamp|diffdate }}</span></td>
                    <td class="hidden-xs">
{% if crash.owner and crash.name %}
                        <img class="column-identicon" title="{{ crash.name }}" src="{{ crash.avatar ?: (crash.name ~ '-' ~ crash.owner)|identicon }}" width="20" height="20">
{% endif %}
                    </td>
{% if crash.module is not empty or crash.module2 is empty %}
{% set frame = {rendered: crash.rendered, first: true} %}
{% else %}
{% set frame = {rendered: crash.rendered2, first: false} %}
{% endif %}
                <td title="{{ frame.rendered }}" class="hidden-xs monospace column-stackframe {% if not frame.first %}column-stackframe-fallback{% endif %}">
                    {{ frame.rendered }}
                </td>
                    <td class="column-actions hidden-xs">
{% if crash.notice is not empty %}
{% set notice = crash.notice | split('-', 2) %}
                        <span class="btn btn-xs disabled btn-{{ notice[1] }}">{{ (notice[0] != 1 ? notice[0] : '&ensp;') | raw }}</span>
{% endif %}
{% if legacy_app.user.admin %}
{% if crash.processed == 1 and not crash.signature_ignored %}
                        <form action="{{ path('reprocess', {id: crash.id, return: legacy_app.request.pathInfo}) }}" method="post" class="button-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('reprocess-crash:' ~ crash.id) }}">
                            <button type="submit" class="btn btn-xs btn-default" data-toggle="tooltip" data-container="body" data-placement="top" title="Reprocess this crash with the current symbols"><i class="icon-refresh"></i></button>
                    </form>
{% endif %}
                    <form action="{{ path('delete', {id: crash.id, return: legacy_app.request.pathInfo}) }}" method="post" class="button-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-crash:' ~ crash.id) }}">
                        <button type="submit" class="btn btn-xs btn-danger" data-toggle="tooltip" data-container="body" data-placement="top" title="Delete this crash report"><i class="icon-trash"></i></button>
                    </form>
{% endif %}
                    </td>
            </tr>
{% else %}
            <tr>
                <td class="text-center" colspan="6">No Crashes</td>
            </tr>
{% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <td colspan="6">
                    <ul class="pager">
                        <li class="previous {% if not offset %}disabled{% endif %}">
                            <a {% if offset %}href="{{ previous ? path('dashboard', dashboard_query|merge({offset: previous})) : path('dashboard', dashboard_query) }}"{% endif %}><i class="icon-double-angle-left"></i> Newer</a>
                        </li>
                        <li class="next {% if not last %}disabled{% endif %}">
                            <a {% if last %}href="{{ path('dashboard', dashboard_query|merge({offset: last, previous: offset})) }}"{% endif %}>Older <i class="icon-angle-right"></i></a>
                        </li>
                    </ul>
                </td>
            </tr>
        </tfoot>
    </table>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
(function () {
    var toggle = document.getElementById('hide-ignored-crashes');
    if (!toggle) return;
    var url = new URL(window.location.href);
    var hasExplicitPreference = url.searchParams.has('hide_ignored');
    var storedPreference = null;

    try {
        storedPreference = window.localStorage.getItem('throttleHideIgnoredCrashes');
    } catch (e) {}

    if (hasExplicitPreference) {
        toggle.checked = url.searchParams.get('hide_ignored') !== '0';
        try {
            window.localStorage.setItem('throttleHideIgnoredCrashes', toggle.checked ? 'true' : 'false');
        } catch (e) {}
    } else if (storedPreference === 'false') {
        toggle.checked = false;
        url.searchParams.set('hide_ignored', '0');
        window.location.replace(url.toString());
        return;
    } else {
        toggle.checked = true;
    }

    function updatePage() {
        var url = new URL(window.location.href);
        try {
            window.localStorage.setItem('throttleHideIgnoredCrashes', toggle.checked ? 'true' : 'false');
        } catch (e) {}
        if (toggle.checked) {
            url.searchParams.delete('hide_ignored');
        } else {
            url.searchParams.set('hide_ignored', '0');
        }
        window.location.assign(url.toString());
    }

    toggle.addEventListener('change', function () {
        updatePage();
    });
}());
</script>
{% endblock %}

