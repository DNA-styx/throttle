{% extends 'layout.html.twig' %}

{% set logout_to_index = true %}
{% set supports_mobile = true %}
 
{% block content %}
<div class="clearfix" style="margin-bottom: 20px;">
    <a class="btn btn-default pull-left" href="{{ path('details', {'id': id}) }}"><i class="icon-chevron-left"></i> Back to Details</a>
    <a class="btn btn-default pull-right" href="{{ path('view', {'id': id}) }}">Even More Raw <i class="icon-chevron-right"></i></a>
{% if ai_analysis_enabled and legacy_app.user %}
    <button type="button" class="btn btn-default pull-right" id="ask-ai-raw" style="margin-right: 8px;"><i class="icon-magic"></i> Ask AI</button>
{% endif %}
</div>
{% if retention is defined and retention.dump_deleted %}
<div class="alert alert-block alert-warning">
    The stored minidump was deleted by storage cleanup. Raw carburetor analysis may be unavailable or limited to previously cached data.
</div>
{% endif %}
<style>
    .raw-stack-shell { position: relative; }
    .raw-stack-output { margin-top: 0; padding-right: 72px; }
    .raw-source-anchor {
        position: absolute;
        right: 8px;
        z-index: 2;
    }
    .raw-source-anchor .btn {
        width: 24px;
        height: 24px;
        padding: 0;
        line-height: 1.2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .raw-source-anchor .btn.raw-source-button-cached {
        box-shadow: inset 0 0 0 1px #3abf7a;
    }
    .raw-source-panel {
        position: absolute;
        z-index: 4;
        width: min(560px, calc(100% - 64px));
        padding: 12px;
        border: 1px solid #303b4a;
        border-radius: 4px;
        background: #fff;
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.25);
    }
    .raw-source-panel .nav-tabs {
        margin-bottom: 10px;
    }
    .raw-source-panel .tab-content {
        overflow: hidden;
    }
    .raw-source-result,
    .raw-source-state,
    .raw-source-find-status { margin-top: 10px; }
    .raw-source-snippet { margin-top: 8px; max-height: 320px; overflow: auto; margin-bottom: 0; }
    .raw-source-note { margin-bottom: 0; }
    .raw-source-header { margin-bottom: 10px; }
    .raw-source-header-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
    }
    .raw-source-header code {
        display: inline-block;
        max-width: 100%;
        white-space: normal;
        word-break: break-word;
    }
    .raw-source-meta {
        margin-top: 8px;
        margin-bottom: 8px;
    }
    .raw-source-fields .form-group { margin-bottom: 10px; }
    .raw-source-empty {
        padding: 10px 12px;
        border: 1px dashed #3a4657;
        border-radius: 4px;
    }
    .raw-source-close-x {
        border: 0;
        background: transparent;
        color: inherit;
        opacity: 0.7;
        padding: 0 4px;
        line-height: 1;
        font-size: 18px;
    }
    .raw-source-close-x:hover,
    .raw-source-close-x:focus {
        opacity: 1;
        text-decoration: none;
    }
    .raw-source-loading {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.04);
    }
    .raw-source-loading-spinner {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-top-color: #55a8ff;
        animation: raw-source-spin 0.8s linear infinite;
        flex: 0 0 auto;
    }
    .raw-source-snippet-rendered {
        margin-top: 8px;
        margin-bottom: 0;
        padding: 0;
        border: 1px solid #303b4a;
        border-radius: 4px;
        overflow: auto;
        background: #111821;
        font-family: Menlo, Monaco, Consolas, "Courier New", monospace;
        font-size: 12px;
        line-height: 1.5;
    }
    .raw-source-snippet-line {
        white-space: pre;
        padding: 0 10px;
    }
    .raw-source-snippet-line.is-focus {
        background: rgba(58, 191, 122, 0.24);
    }
    .raw-source-diagnostics-toggle {
        margin-top: 10px;
    }
    .crash-ai-panel {
        position: absolute;
        z-index: 5;
        width: min(620px, calc(100vw - 64px));
        max-width: calc(100vw - 40px);
        height: 360px;
        min-height: 320px;
        display: flex;
        flex-direction: column;
        padding: 12px;
        border: 1px solid #303b4a;
        border-radius: 4px;
        background: #fff;
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.25);
        resize: both;
        overflow: auto;
    }
    .crash-ai-panel .form-group { margin-bottom: 10px; }
    .crash-ai-panel .checkbox { margin-top: 0; margin-bottom: 8px; }
    .crash-ai-panel .checkbox.inline { margin-right: 12px; }
    .crash-ai-panel .details-ai-tab-panel:not(.hidden),
    .crash-ai-panel .raw-ai-tab-panel:not(.hidden) { display: flex; flex: 1 1 auto; min-height: 0; flex-direction: column; }
    .crash-ai-result { margin-top: 10px; flex: 1 1 auto; min-height: 220px; max-height: none; overflow: auto; padding: 10px 12px; border: 1px solid #303b4a; border-radius: 4px; background: #111821; }
    .crash-ai-tabs { margin-bottom: 10px; }
    .crash-ai-history-entry { border-top: 1px solid rgba(120, 136, 156, 0.25); padding: 10px 0; }
    .crash-ai-history-entry:first-child { border-top: 0; padding-top: 0; }
    .crash-ai-history-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 6px; }
    .crash-ai-history-meta { color: #8a97a6; font-size: 12px; line-height: 1.4; }
    .crash-ai-history-response,
    .crash-ai-history-prompt { flex: 1 1 auto; min-height: 140px; max-height: none; overflow: auto; margin-top: 8px; }
    .crash-ai-history-response { padding: 10px 12px; border: 1px solid #303b4a; border-radius: 4px; background: #111821; }
    .crash-ai-history-empty { margin-top: 8px; }
    .details-ai-history-list,
    .raw-ai-history-list { flex: 1 1 auto; min-height: 0; overflow: auto; }
    .crash-ai-history-toggle { cursor: pointer; list-style: none; }
    .crash-ai-history-toggle::-webkit-details-marker { display: none; }
    .crash-ai-history-toggle::marker { display: none; }
    .crash-ai-history-body { padding-top: 8px; }
    .crash-ai-history-tabs { display: inline-flex; gap: 6px; margin-bottom: 8px; }
    .crash-ai-history-tab {
        border: 1px solid rgba(120, 136, 156, 0.35);
        background: transparent;
        color: inherit;
        border-radius: 4px;
        padding: 4px 10px;
        font-size: 12px;
        line-height: 1.2;
    }
    .crash-ai-history-tab.active {
        background: rgba(63, 136, 248, 0.18);
        border-color: rgba(63, 136, 248, 0.5);
    }
    .crash-ai-history-panel.hidden { display: none; }
    .crash-ai-markdown-output { white-space: normal; line-height: 1.5; word-break: normal; overflow-wrap: break-word; hyphens: none; }
    .crash-ai-markdown-output code { white-space: pre-wrap; overflow-wrap: anywhere; }
    .crash-ai-markdown-output p:last-child,
    .crash-ai-markdown-output ul:last-child,
    .crash-ai-markdown-output ol:last-child,
    .crash-ai-markdown-output blockquote:last-child { margin-bottom: 0; }
    .crash-ai-inline-spinner {
        display: inline-block;
        width: 12px;
        height: 12px;
        margin-right: 6px;
        border: 2px solid rgba(255, 255, 255, 0.35);
        border-top-color: currentColor;
        border-radius: 50%;
        animation: crash-ai-spin 0.8s linear infinite;
        vertical-align: -1px;
    }
    @keyframes raw-source-spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    @keyframes crash-ai-spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    body.theme-dark .raw-source-panel {
        background: #1a2330;
        border-color: #303b4a;
        color: #d7dde6;
    }
    body.theme-dark .raw-source-empty {
        border-color: #415066;
        background: rgba(255, 255, 255, 0.02);
    }
    body.theme-dark .raw-source-loading {
        background: rgba(255, 255, 255, 0.03);
    }
    body.theme-dark .raw-source-panel label,
    body.theme-dark .raw-source-panel .help-block,
    body.theme-dark .raw-source-panel .checkbox,
    body.theme-dark .raw-source-panel .checkbox label {
        color: #d7dde6;
    }
    body.theme-dark .raw-source-panel .nav-tabs > li > a {
        color: #cbd4de;
    }
    body.theme-dark .raw-source-panel .nav-tabs > li.active > a,
    body.theme-dark .raw-source-panel .nav-tabs > li.active > a:hover,
    body.theme-dark .raw-source-panel .nav-tabs > li.active > a:focus {
        background: #101722;
        color: #fff;
        border-color: #303b4a #303b4a transparent;
    }
    body.theme-dark .raw-source-panel code {
        background: #0d131a;
        color: #d8e7ff;
    }
    body.theme-dark .crash-ai-panel {
        background: #1a2330;
        border-color: #303b4a;
        color: #d7dde6;
    }
    body.theme-dark .crash-ai-panel label,
    body.theme-dark .crash-ai-panel .help-block,
    body.theme-dark .crash-ai-panel .checkbox,
    body.theme-dark .crash-ai-panel .checkbox label {
        color: #d7dde6;
    }
    body.theme-dark .crash-ai-panel code {
        background: #0d131a;
        color: #d8e7ff;
    }
</style>
<div id="loading" class="progress" style="background-color: #fff; border: 1px solid #ccc; height: 40px;"><div class="progress-bar" style="width: 0%"></div></div>
<div id="content" class="hidden">
    <div id="carburetor-error" class="alert alert-danger hidden" style="white-space: pre-wrap;"></div>
    <ul class="nav nav-tabs">
        <li class="active"><a href="#tab-stack" data-toggle="tab">Stack</a></li>
        <li><a href="#tab-memory" data-toggle="tab">Memory</a></li>
        <li><a href="#tab-raw" data-toggle="tab">Raw</a></li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="tab-stack">
            <div id="stack-shell" class="raw-stack-shell">
                <pre id="tab-stack-text" class="raw-stack-output"></pre>
            </div>
        </div>
        <pre class="tab-pane" id="tab-memory"></pre>
        <pre class="tab-pane" id="tab-raw"></pre>
    </div>
</div>
{% if ai_analysis_enabled and legacy_app.user %}
<div id="raw-ai-analysis-data"
     class="hidden"
     data-url="{{ path('crash_ai_analyze', {'id': id}) }}"
     data-history-url="{{ path('crash_ai_history', {'id': id}) }}"
     data-visibility-url-template="{{ path('crash_ai_history_visibility', {'id': id, 'historyId': 0})|replace({'/0/': '/__HISTORY__/'} ) }}"
     data-token="{{ csrf_token('crash-ai-analyze:' ~ id) }}"
     data-configs="{{ legacy_app.user.ai_configs|default([])|json_encode|e('html_attr') }}"
     data-history-items="{{ ai_history_items|default([])|json_encode|e('html_attr') }}">
</div>
<div id="raw-ai-analysis-panel" class="crash-ai-panel hidden" aria-hidden="true">
    <div class="raw-source-header">
        <div class="raw-source-header-top">
            <div>Ask AI about raw crash <code>{{ id }}</code></div>
            <button type="button" class="raw-source-close-x raw-ai-close" aria-label="Close" title="Close"><i class="icon-remove"></i></button>
        </div>
        <div class="text-muted" style="margin-top: 4px;">This mode can include raw carburetor output in addition to the processed crash view.</div>
    </div>
    <ul class="nav nav-tabs crash-ai-tabs">
        <li class="active"><a href="#" class="raw-ai-tab-link" data-tab="ask">Ask</a></li>
        <li><a href="#" class="raw-ai-tab-link" data-tab="history">History</a></li>
    </ul>
    <div class="raw-ai-tab-panel raw-ai-tab-ask">
        <div class="form-group">
            <label>AI config</label>
            <select class="form-control input-sm raw-ai-config"></select>
        </div>
        <div class="form-group">
            <label>Prompt</label>
            <textarea class="form-control input-block-level raw-ai-prompt" rows="8"></textarea>
        </div>
        <div class="form-group">
            <label>Include</label>
            <div>
                <label class="checkbox inline"><input type="checkbox" class="raw-ai-include-stack" checked> Stack Trace</label>
                <label class="checkbox inline"><input type="checkbox" class="raw-ai-include-cause" checked> Likely Cause</label>
                <label class="checkbox inline"><input type="checkbox" class="raw-ai-include-modules" checked> Modules</label>
                <label class="checkbox inline"><input type="checkbox" class="raw-ai-include-console" checked> Console</label>
                <label class="checkbox inline"><input type="checkbox" class="raw-ai-include-header" checked> Header + metadata</label>
                <label class="checkbox inline"><input type="checkbox" class="raw-ai-include-raw" checked> Raw</label>
            </div>
        </div>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-primary raw-ai-submit">Analyze</button>
            <button type="button" class="btn btn-default raw-ai-cancel">Close</button>
        </div>
        <div class="raw-ai-status" style="margin-top: 10px;"></div>
        <div class="crash-ai-result crash-ai-markdown-output hidden"></div>
    </div>
    <div class="raw-ai-tab-panel raw-ai-tab-history hidden">
        <div class="raw-ai-history-status"></div>
        <div class="raw-ai-history-list"></div>
    </div>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
<script src="{{ legacy_app.request.baseUrl }}/js/carburetor-analyze.js?v=20260515-source-lookup-cache-v1"></script>
<script src="{{ legacy_app.request.baseUrl }}/js/carburetor-memory.js"></script>
<script type="application/javascript">
var loading = $('#loading');
var progress = $('#loading .progress-bar');
var content = $('#content');

var tabStack = $('#tab-stack-text');
var tabMemory = $('#tab-memory');
var tabRaw = $('#tab-raw');
var errorBox = $('#carburetor-error');
var stackShell = $('#stack-shell');
var stackUnavailableMessage = 'Stack unavailable because carburetor crashed.';
var memoryUnavailableMessage = 'Memory view unavailable because carburetor crashed.';
var sourceLookupEnabled = {{ source_lookup_enabled ? 'true' : 'false' }};
var sourceLookupLocalAllowed = {{ source_lookup_local_allowed ? 'true' : 'false' }};
var sourceLookupUrl = '{{ path('carburetor_source_lookup', { id: id }) | escape('js') }}';
var sourceLookupToken = '{{ csrf_token('carburetor-source-lookup:' ~ id) | escape('js') }}';
var sourceLookupModules = {};
var rawAiEnabled = {{ ai_analysis_enabled and legacy_app.user ? 'true' : 'false' }};

{% if ai_analysis_enabled and legacy_app.user %}
var rawAiButton = $('#ask-ai-raw');
var rawAiPanel = $('#raw-ai-analysis-panel');
var rawAiDataNode = $('#raw-ai-analysis-data');
var rawAiUrl = rawAiDataNode.attr('data-url');
var rawAiHistoryUrl = rawAiDataNode.attr('data-history-url');
var rawAiVisibilityUrlTemplate = rawAiDataNode.attr('data-visibility-url-template');
var rawAiToken = rawAiDataNode.attr('data-token');
var rawAiConfigs = [];
try {
    rawAiConfigs = JSON.parse(rawAiDataNode.attr('data-configs') || '[]');
} catch (e) {
    rawAiConfigs = [];
}
var rawAiSelect = rawAiPanel.find('.raw-ai-config');
var rawAiPrompt = rawAiPanel.find('.raw-ai-prompt');
var rawAiStatus = rawAiPanel.find('.raw-ai-status');
var rawAiResult = rawAiPanel.find('.crash-ai-result');
var rawAiHistoryStatus = rawAiPanel.find('.raw-ai-history-status');
var rawAiHistoryList = rawAiPanel.find('.raw-ai-history-list');
var rawAiHistoryLoaded = false;
var rawAiEmbeddedHistory = [];
try {
    rawAiEmbeddedHistory = JSON.parse(rawAiDataNode.attr('data-history-items') || '[]');
} catch (e) {
    rawAiEmbeddedHistory = [];
}

function rawAiSelectedConfig() {
    var selectedId = String(rawAiSelect.val() || '');
    for (var i = 0; i < rawAiConfigs.length; i++) {
        if (String(rawAiConfigs[i].id) === selectedId) {
            return rawAiConfigs[i];
        }
    }
    return null;
}

function rawAiRenderConfigs() {
    rawAiSelect.empty();
    if (!rawAiConfigs.length) {
        rawAiSelect.append($('<option value=""></option>').text('No saved AI configs'));
        rawAiPrompt.val('');
        return;
    }

    rawAiConfigs.forEach(function(config) {
        rawAiSelect.append($('<option></option>').attr('value', config.id).text(config.display_name + ' (' + config.provider_label + ' / ' + config.model + ')'));
    });

    var preferred = null;
    rawAiConfigs.forEach(function(config) {
        if (config.is_default && preferred === null) {
            preferred = String(config.id);
        }
    });
    rawAiSelect.val(preferred || String(rawAiConfigs[0].id));
    var selected = rawAiSelectedConfig();
    rawAiPrompt.val(selected && selected.default_prompt ? selected.default_prompt : '');
}

function rawAiSetStatus(type, text, loading) {
    var box = $('<div></div>').addClass('alert alert-' + type);
    if (loading) {
        box.append($('<span class="crash-ai-inline-spinner"></span>'));
    }
    box.append(document.createTextNode(text));
    rawAiStatus.empty().append(box);
}

function rawAiSetHistoryStatus(type, text) {
    rawAiHistoryStatus.empty().append($('<div></div>').addClass('alert alert-' + type).text(text));
}

function rawAiShowTab(tab) {
    rawAiPanel.find('.raw-ai-tab-link').parent().removeClass('active');
    rawAiPanel.find('.raw-ai-tab-link[data-tab="' + tab + '"]').parent().addClass('active');
    rawAiPanel.find('.raw-ai-tab-panel').addClass('hidden');
    rawAiPanel.find('.raw-ai-tab-' + tab).removeClass('hidden');
    if (tab === 'history') {
        rawAiLoadHistory(false);
    }
    rawAiSyncPanelHeights();
}

function rawAiHistorySections(entry) {
    var labels = [];
    if (entry.request_sections && entry.request_sections.stack_trace) labels.push('stack');
    if (entry.request_sections && entry.request_sections.likely_cause) labels.push('cause');
    if (entry.request_sections && entry.request_sections.modules) labels.push('modules');
    if (entry.request_sections && entry.request_sections.console) labels.push('console');
    if (entry.request_sections && entry.request_sections.header_metadata) labels.push('header');
    if (entry.request_sections && entry.request_sections.raw) labels.push('raw');
    return labels.join(', ');
}

function rawAiRenderResponse(container, html, text) {
    var sanitizedHtml = rawAiSanitizeDisplay(html || '');
    var sanitizedText = rawAiSanitizeDisplay(text || '');
    if (html) {
        container.html(sanitizedHtml);
        return;
    }

    container.empty().append($('<pre></pre>').text(sanitizedText));
}

function rawAiSanitizeDisplay(value) {
    var text = String(value || '');
    text = text.replace(/\uFFFD/g, '\uE000');
    text = text.replace(/([ИиЫы])\uE000\s+(?=[А-Яа-яЁё])/g, function(match, letter) {
        return letter + '\u0445 ';
    });
    text = text.replace(/\uE000\s+(?=[A-Za-zА-Яа-яЁё])/g, '\u0445');
    text = text.replace(/\uE000\s+(?=[.,:;!?)\]<]|$)/g, '\u0445');
    text = text.replace(/\uE000(?=\s*[.,:;!?)\]<]|$)/g, '\u0445');
    text = text.replace(/\uE000/g, '\u0445');

    return text;
}

function rawAiAdjustPanelWidth(text) {
    rawAiPanel.css('width', '');
    rawAiPositionPanel();
}

function rawAiPositionPanel() {
    if (rawAiPanel.hasClass('hidden') || !rawAiButton.length) {
        return;
    }

    var buttonRect = rawAiButton[0].getBoundingClientRect();
    var panelWidth = rawAiPanel.outerWidth() || 620;
    var scrollTop = $(window).scrollTop() || 0;
    var scrollLeft = $(window).scrollLeft() || 0;
    var viewportWidth = window.innerWidth || panelWidth;
    var left = Math.max(12 + scrollLeft, Math.min(buttonRect.left + scrollLeft - panelWidth + rawAiButton.outerWidth(), scrollLeft + viewportWidth - panelWidth - 12));
    var top = Math.max(12 + scrollTop, buttonRect.top + scrollTop + rawAiButton.outerHeight() + 6);
    rawAiPanel.css({ top: top + 'px', left: left + 'px' });
}

function rawAiSyncPanelHeights() {
    if (rawAiPanel.hasClass('hidden')) {
        return;
    }

    var panelHeight = rawAiPanel.innerHeight() || 0;
    if (panelHeight <= 0) {
        return;
    }

    var headerHeight = rawAiPanel.find('.raw-source-header').outerHeight(true) || 0;
    var tabsHeight = rawAiPanel.find('.crash-ai-tabs').outerHeight(true) || 0;
    var available = Math.max(180, panelHeight - headerHeight - tabsHeight - 30);

    if (rawAiPanel.find('.raw-ai-tab-ask').is(':visible')) {
        var askPanel = rawAiPanel.find('.raw-ai-tab-ask');
        var fixed = 0;
        askPanel.children().not('.crash-ai-result').each(function() {
            fixed += $(this).outerHeight(true) || 0;
        });
        rawAiResult.css('height', Math.max(160, available - fixed) + 'px');
    }

    if (rawAiPanel.find('.raw-ai-tab-history').is(':visible')) {
        var historyPanel = rawAiPanel.find('.raw-ai-tab-history');
        var historyFixed = 0;
        historyPanel.children().not('.raw-ai-history-list').each(function() {
            historyFixed += $(this).outerHeight(true) || 0;
        });
        rawAiHistoryList.css('height', Math.max(160, available - historyFixed) + 'px');
    }
}

function rawAiBindHistoryTabs(item) {
    item.find('.crash-ai-history-tab').on('click', function() {
        var button = $(this);
        var tab = String(button.data('tab') || 'output');
        item.find('.crash-ai-history-tab').removeClass('active');
        button.addClass('active');
        item.find('.crash-ai-history-panel').addClass('hidden');
        item.find('.crash-ai-history-panel-' + tab).removeClass('hidden');
    });
}

function rawAiRenderHistory(items) {
    rawAiHistoryList.empty();
    if (!items || !items.length) {
        rawAiHistoryList.append($('<div class="crash-ai-history-empty muted"></div>').text('No AI history entries yet.'));
        return;
    }

    items.forEach(function(entry, index) {
        var item = $('<details class="crash-ai-history-entry"></details>');
        if (index === 0) {
            item.attr('open', 'open');
        }

        var head = $('<summary class="crash-ai-history-head crash-ai-history-toggle"></summary>').appendTo(item);
        var metaBox = $('<div></div>').appendTo(head);
        $('<div class="fw-semibold"></div>').text((entry.user_name || ('User #' + entry.user_id)) + ' - ' + entry.provider_label + ' / ' + entry.model).appendTo(metaBox);
        $('<div class="crash-ai-history-meta"></div>').text(entry.created_at + ' - ' + entry.context + ' - ' + rawAiHistorySections(entry)).appendTo(metaBox);

        var actions = $('<div class="text-right"></div>').appendTo(head);
        $('<span class="label ' + (entry.is_public ? 'label-success' : 'label-default') + '"></span>')
