function showError(message, data) {
    var lines = [message];

    if (data && typeof data.exit_code !== 'undefined' && data.exit_code !== null) {
        lines.push('Exit code: ' + data.exit_code);
    }

    if (data && data.stderr_tail) {
        lines.push('');
        lines.push('stderr:');
        lines.push(data.stderr_tail);
    }

    errorBox.text(lines.join('\n')).removeClass('hidden');
}

function renderFallbackStack(rows) {
    if (!Array.isArray(rows) || !rows.length) {
        return '';
    }

    return rows.map(function(row, index) {
        var frame = (row && typeof row.frame !== 'undefined' && row.frame !== null) ? row.frame : index;
        var rendered = (row && row.rendered) ? row.rendered : '';
        var fallback = [row && row.module ? row.module : '', row && row.function ? row.function : '']
            .filter(Boolean)
            .join('!');
        var text = rendered || fallback || '[unknown frame]';

        return '#' + frame + ' ' + text;
    }).join('\n');
}

function renderErrorContext(context) {
    if (!context || (!context.summary && (!Array.isArray(context.lines) || !context.lines.length))) {
        return '';
    }

    var parts = [];
    if (context.summary) {
        parts.push(context.summary);
    }

    if (Array.isArray(context.lines) && context.lines.length) {
        parts.push(context.lines.join('\n'));
    }

    return parts.join('\n');
}

function normalizeFrameLabel(frame) {
    if (frame.rendered) {
        return frame.rendered;
    }

    var fallback = [normalizeLookupValue(frame.module), normalizeLookupValue(frame.function)].filter(Boolean).join('!');
    return fallback || '[unknown frame]';
}

function lookupModuleKey(value) {
    value = basenameOnly(value);
    return value ? value.toLowerCase() : '';
}

function normalizeLookupValue(value) {
    if (value === null || typeof value === 'undefined') {
        return '';
    }

    if (typeof value === 'string' || typeof value === 'number') {
        return String(value).trim();
    }

    if (typeof value === 'object') {
        var preferred = ['rendered', 'name', 'function', 'code_file', 'debug_file', 'file', 'filename', 'module', 'path'];
        for (var i = 0; i < preferred.length; ++i) {
            var candidate = value[preferred[i]];
            if (typeof candidate === 'string' && candidate.trim() !== '') {
                return candidate.trim();
            }
        }
    }

    return '';
}

function basenameOnly(value) {
    value = normalizeLookupValue(value);
    if (!value) {
        return '';
    }

    return value.split(/[\\/]/).pop();
}

function parseFrameSymbol(label) {
    if (!label) {
        return { module: '', symbol: '' };
    }

    var bang = label.indexOf('!');
    if (bang === -1) {
        return { module: '', symbol: label };
    }

    return {
        module: label.substring(0, bang),
        symbol: label.substring(bang + 1)
    };
}

function buildLookupFrames(data) {
    if (data.error) {
        var fallback = Array.isArray(data.problem_stack) && data.problem_stack.length ? data.problem_stack : (Array.isArray(data.fallback_stack) ? data.fallback_stack : []);
        return fallback.map(function(frame, index) {
            var runtimeModule = normalizeLookupValue(frame.module);
            var functionName = normalizeLookupValue(frame.function);
            var label = frame.rendered || [runtimeModule, functionName].filter(Boolean).join('!');
            var parsed = parseFrameSymbol(label);
            var moduleBasename = parsed.module ? basenameOnly(parsed.module) : (basenameOnly(runtimeModule) || runtimeModule);

            return {
                threadIndex: 0,
                frameIndex: typeof frame.frame !== 'undefined' ? frame.frame : index,
                label: '#' + (typeof frame.frame !== 'undefined' ? frame.frame : index) + ' ' + label,
                runtimeModule: runtimeModule || parsed.module || moduleBasename,
                moduleBasename: moduleBasename,
                symbol: functionName || parsed.symbol,
            };
        });
    }

    if (!Array.isArray(data.threads) || !data.threads.length) {
        return [];
    }

    var threadIndex = (typeof data.requesting_thread !== 'undefined' && data.requesting_thread !== null && data.requesting_thread >= 0)
        ? data.requesting_thread
        : 0;
    var thread = data.threads[threadIndex] || [];

    return thread.map(function(frame, index) {
        var label = normalizeFrameLabel(frame);
        var parsed = parseFrameSymbol(label);

        return {
            threadIndex: threadIndex,
            frameIndex: index,
            label: '#' + index + ' ' + label,
            runtimeModule: normalizeLookupValue(frame.module) || parsed.module || basenameOnly(frame.module),
            moduleBasename: parsed.module ? basenameOnly(parsed.module) : (basenameOnly(frame.module) || normalizeLookupValue(frame.module)),
            symbol: normalizeLookupValue(frame.function) || parsed.symbol || label
        };
    });
}

function buildLookupState(frame) {
    var key = lookupModuleKey(frame.moduleBasename || frame.runtimeModule);
    var existing = key && sourceLookupModules[key] ? sourceLookupModules[key] : null;

    return $.extend({
        module_basename: frame.moduleBasename || basenameOnly(frame.runtimeModule),
        module_identifier: null,
        has_cache: false,
        has_mapping: false
    }, existing || {});
}

