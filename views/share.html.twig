{% extends 'layout.html.twig' %}

{% set logout_to_index = true %}
{% set supports_mobile = true %}

{% block stylesheets %}
{{ parent() }}
<style>
.sharing-shell {
    max-width: 980px;
    margin: 0 auto;
}

.sharing-panel {
    border: 1px solid #dbe3ee;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    overflow: hidden;
    margin-bottom: 24px;
}

.sharing-panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px 14px;
    border-bottom: 1px solid #e8edf4;
}

.sharing-panel-header h2 {
    margin: 0 0 4px;
}

.sharing-panel-header p {
    margin: 0;
    color: #758396;
}

.sharing-panel-body {
    padding: 0 20px 20px;
}

.sharing-empty {
    padding: 18px 0 4px;
    color: #758396;
    text-align: center;
}

.sharing-user-cell {
    min-width: 0;
}

.sharing-user-name {
    font-weight: 600;
    margin-bottom: 4px;
}

.sharing-user-meta {
    color: #758396;
    font-size: 12px;
    line-height: 1.45;
}

.sharing-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
}

.sharing-avatar {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    object-fit: cover;
    background: #eef3f8;
}

.sharing-table {
    margin-bottom: 0;
}

.sharing-table td,
.sharing-table th {
    vertical-align: middle !important;
}

.sharing-actions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-content: flex-end;
    flex-wrap: wrap;
}

body.theme-dark .sharing-panel {
    background: #1a2330;
    border-color: #303b4a;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.28);
}

body.theme-dark .sharing-panel-header {
    border-bottom-color: #303b4a;
}

body.theme-dark .sharing-panel-header p,
body.theme-dark .sharing-user-meta,
body.theme-dark .sharing-empty {
    color: #95a3b4;
}

body.theme-dark .sharing-avatar {
    background: #111820;
}
</style>
{% endblock %}

{% block content %}
<div class="sharing-shell">
    <div class="sharing-panel">
        <div class="sharing-panel-header">
            <div>
                <h2>Sharing With Others</h2>
                <p>Users listed here can access and manage your crash reports with the same permissions you have.</p>
            </div>
            <a href="{{ path('share_invite') }}" class="btn btn-success"><i class="icon-inbox"></i> Invite access</a>
        </div>
        <div class="sharing-panel-body">
            {% if sharing %}
                <div class="table-responsive">
                    <table class="table table-share sharing-table">
                        <thead>
                            <tr>
                                <th style="width: 52px;"></th>
                                <th>User</th>
                                <th style="width: 210px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for user in sharing %}
                            <tr{% if user.accepted == null %} class="warning"{% endif %}>
                                <td>
{% if user.steam_id %}
                                    <a href="https://steamcommunity.com/profiles/{{ user.steam_id }}" rel="noopener noreferrer">
                                        <img class="sharing-avatar" alt="{{ user.name ?? user.id }}'s avatar" src="{{ user.avatar ?? 'https://steamcdn-a.akamaihd.net/steamcommunity/public/images/avatars/fe/fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb_full.jpg' }}" width="32" height="32">
                                    </a>
{% else %}
                                    <img class="sharing-avatar" alt="{{ user.name ?? user.id }}'s avatar" src="{{ user.avatar ?? 'https://steamcdn-a.akamaihd.net/steamcommunity/public/images/avatars/fe/fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb_full.jpg' }}" width="32" height="32">
{% endif %}
                                </td>
                                <td class="sharing-user-cell">
                                    <div class="sharing-user-name">{{ user.name ?? user.id }}</div>
                                    <div class="sharing-user-meta">User ID: {{ user.id }}</div>
{% if user.email %}
                                    <div class="sharing-user-meta">Email: {{ user.email }}</div>
{% endif %}
{% if user.steam_id %}
                                    <div class="sharing-user-meta">SteamID64: {{ user.steam_id }}</div>
{% endif %}
{% if user.discord_id %}
                                    <div class="sharing-user-meta">Discord ID: {{ user.discord_id }}</div>
{% endif %}
                                </td>
                                <td>
                                    <div class="sharing-actions">
{% if user.accepted == null %}
                                        <span class="btn btn-xs btn-default" style="pointer-events: none;"><i class="icon-time"></i> Pending</span>
{% else %}
                                        <span class="sharing-status text-muted"><i class="icon-ok-circle"></i> Active since {{ user.accepted|date('Y-m-d') }}</span>
{% endif %}
                                        <form action="{{ path('share_revoke', { user: user.id }) }}" method="post" class="button-form">
                                            <button type="submit" class="btn btn-xs btn-danger"><i class="icon-remove"></i> Revoke</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="sharing-empty">You are not sharing your reports with anyone yet.</div>
            {% endif %}
        </div>
    </div>

    <div class="sharing-panel">
        <div class="sharing-panel-header">
            <div>
                <h2>Shared With You</h2>
                <p>These owners granted you access to their crash reports.</p>
            </div>
        </div>
        <div class="sharing-panel-body">
            {% if shared %}
                <div class="table-responsive">
                    <table class="table table-share sharing-table">
                        <thead>
                            <tr>
                                <th style="width: 52px;"></th>
                                <th>User</th>
                                <th style="width: 230px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for user in shared %}
                            <tr{% if user.accepted == null %} class="warning"{% endif %}>
                                <td>
{% if user.steam_id %}
                                    <a href="https://steamcommunity.com/profiles/{{ user.steam_id }}" rel="noopener noreferrer">
                                        <img class="sharing-avatar" alt="{{ user.name ?? user.id }}'s avatar" src="{{ user.avatar ?? 'https://steamcdn-a.akamaihd.net/steamcommunity/public/images/avatars/fe/fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb_full.jpg' }}" width="32" height="32">
                                    </a>
{% else %}
                                    <img class="sharing-avatar" alt="{{ user.name ?? user.id }}'s avatar" src="{{ user.avatar ?? 'https://steamcdn-a.akamaihd.net/steamcommunity/public/images/avatars/fe/fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb_full.jpg' }}" width="32" height="32">
{% endif %}
                                </td>
                                <td class="sharing-user-cell">
                                    <div class="sharing-user-name">{{ user.name ?? user.id }}</div>
                                    <div class="sharing-user-meta">User ID: {{ user.id }}</div>
{% if user.email %}
                                    <div class="sharing-user-meta">Email: {{ user.email }}</div>
{% endif %}
{% if user.steam_id %}
                                    <div class="sharing-user-meta">SteamID64: {{ user.steam_id }}</div>
{% endif %}
{% if user.discord_id %}
                                    <div class="sharing-user-meta">Discord ID: {{ user.discord_id }}</div>
{% endif %}
                                </td>
                                <td>
                                    <div class="sharing-actions">
{% if user.accepted == null %}
                                        <form action="{{ path('share_accept', { owner: user.id }) }}" method="post" class="button-form">
                                            <button type="submit" class="btn btn-xs btn-success"><i class="icon-ok"></i> Accept</button>
                                        </form>
{% else %}
                                        <span class="sharing-status text-muted"><i class="icon-ok-circle"></i> Active since {{ user.accepted|date('Y-m-d') }}</span>
{% endif %}
                                        <form action="{{ path('share_revoke', { owner: user.id }) }}" method="post" class="button-form">
                                            <button type="submit" class="btn btn-xs btn-danger"><i class="icon-remove"></i> Remove</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="sharing-empty">Nobody is sharing reports with you right now.</div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
