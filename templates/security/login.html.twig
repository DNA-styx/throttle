{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
<div class="form-wrapper">
    {% if login_link_sent %}
        <div class="alert alert-success">{{ 'login.link_sent' | trans }}</div>
    {% endif %}
    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey | trans(error.messageData, 'security') }}</div>
    {% endif %}
    <div class="d-grid gap-2">
        <a href="{{ path('login_steam') }}" class="btn btn-outline-primary">
            <svg class="bi me-1" width="16" height="16" aria-hidden="true">
                <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#steam"></use>
            </svg>
            Login with Steam
        </a>
    </div>
</div>
{% endblock %}
