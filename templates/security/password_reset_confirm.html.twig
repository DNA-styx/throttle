{% extends 'base.html.twig' %}

{% block title %}Set new password{% endblock %}

{% block body %}
<div class="auth-shell row justify-content-center">
    <div class="col-lg-6">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        <div class="auth-card card">
            <div class="card-body">
                <h1 class="h4 mb-3">Set new password</h1>
                <form method="post" action="{{ path('password_reset_confirm') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('password-reset-confirm') }}">
                    <input type="hidden" name="token" value="{{ token }}">
                    <div class="mb-3">
                        <label class="form-label">New password</label>
                        <input type="password" class="form-control" name="password" autocomplete="new-password" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirm password</label>
                        <input type="password" class="form-control" name="password_confirm" autocomplete="new-password" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Save password</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
