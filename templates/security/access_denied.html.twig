{% extends 'base.html.twig' %}

{% block title %}Access denied{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <h1 class="h4 mb-3">Access denied</h1>
                    <p class="mb-4 text-muted">You do not have access to this page.</p>
                    <a href="{{ path('index') }}" class="btn btn-outline-secondary">Back to dashboard</a>
                    {% if not app.user %}
                        <a href="{{ path('login_steam', {'return': app.request.requestUri}) }}" class="btn btn-primary ms-2">
                            <svg class="bi me-1" width="16" height="16" aria-hidden="true">
                                <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#steam"></use>
                            </svg>
                            Login with Steam
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
