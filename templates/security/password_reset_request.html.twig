{% extends 'base.html.twig' %}

{% block title %}Reset password{% endblock %}

{% block body %}
<div class="auth-shell row justify-content-center">
    <div class="col-lg-6">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% if not mailerConfigured %}
            <div class="alert alert-warning">{{ mailerNotice }}</div>
        {% endif %}
        <div class="auth-card card">
            <div class="card-body">
                <h1 class="h4 mb-3">Reset password</h1>
                {% if mailerConfigured %}
                    <form method="post" action="{{ path('password_reset_request') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('password-reset-request') }}">
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" name="email" autocomplete="email" required>
                        </div>
                        <button type="submit" class="btn btn-primary">Send reset link</button>
                        <a href="{{ path('login') }}" class="btn btn-outline-secondary ms-2">Back to login</a>
                    </form>
                {% else %}
                    <div class="auth-inline-note mb-3">
                        Password reset is unavailable until email delivery is configured.
                    </div>
                    <a href="{{ path('login') }}" class="btn btn-outline-secondary">Back to login</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
