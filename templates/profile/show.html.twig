{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block body %}
    <div class="profile-shell">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h1 class="h3 mb-1">Profile</h1>
                <div class="text-muted">Account, upload token, and SourceMod Accelerator configuration.</div>
            </div>
            <a href="{{ path('dashboard') }}" class="btn btn-outline-secondary">
                <svg class="bi me-1" width="16" height="16" aria-hidden="true">
                    <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#speedometer2"></use>
                </svg>
                Dashboard
            </a>
        </div>

        <div class="profile-panel mb-3">
            <div class="d-flex align-items-center gap-3">
                <svg class="bi profile-avatar" width="48" height="48" aria-hidden="true">
                    <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#{{ steamAccount ? 'steam' : 'person-fill' }}"></use>
                </svg>
                <div>
                    <div class="h5 mb-1">{{ user.name }}</div>
                    {% if steamAccount %}
                        <div class="text-muted profile-meta-line">
                            <span>User ID: {{ user.id }}</span>
                            <a href="https://steamcommunity.com/profiles/{{ steamAccount.identifier }}" rel="noopener noreferrer">
                                {{ steamAccount.identifier }}
                            </a>
                            {% if steamAccount.lastLogin %}
                                <span>Last login: {{ steamAccount.lastLogin|date('Y-m-d H:i:s') }}</span>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="text-muted">User ID: {{ user.id }}</div>
                        <a href="{{ path('login_steam') }}" class="btn btn-sm btn-outline-primary mt-2">
                            Link Steam
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>

        <section class="profile-panel mb-3">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <h2 class="h5 mb-0">Upload token</h2>
                <a href="{{ path('profile_token_statistics') }}" class="btn btn-sm btn-outline-secondary">Open statistics</a>
            </div>

            <label for="upload-token" class="form-label">Token for crash, symbol, and binary uploads</label>
            <div class="input-group mb-3">
                <input id="upload-token" class="form-control font-monospace" value="{{ user.uploadToken }}" readonly>
                <button class="btn btn-outline-secondary" type="button" data-copy-token="#upload-token">
                    <svg class="bi me-1" width="16" height="16" aria-hidden="true">
                        <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#clipboard"></use>
                    </svg>
                    Copy
                </button>
            </div>

            <div class="profile-stat-grid mb-3">
                <div>
                    <div class="profile-stat-value">{{ tokenStats.uses }}</div>
                    <div class="text-muted">Uses</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ tokenStats.crashes }}</div>
                    <div class="text-muted">Crashes</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ tokenStats.symbols }}</div>
                    <div class="text-muted">Symbols</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ tokenStats.binaries }}</div>
                    <div class="text-muted">Binaries</div>
                </div>
            </div>

            <h3 class="h6">Last servers</h3>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Server</th>
                            <th>Uses</th>
                            <th>Last used</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for server in recentServers %}
                            <tr>
                                <td>{{ server.remote_addr ?: server.account ?: 'Unknown' }}</td>
                                <td>{{ server.uses }}</td>
                                <td>{{ server.last_used }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-muted">No token usage recorded yet.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <form method="post" action="{{ path('profile_regenerate_token') }}" class="mt-3">
                <input type="hidden" name="_token" value="{{ csrf_token('regenerate-upload-token') }}">
                <button type="submit" class="btn btn-outline-danger">
                    <svg class="bi me-1" width="16" height="16" aria-hidden="true">
                        <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#arrow-clockwise"></use>
                    </svg>
                    Regenerate token
                </button>
            </form>
        </section>

        <section
            class="profile-panel"
            data-core-config-generator
            data-token="{{ user.uploadToken }}"
            data-default-base-url="{{ coreConfigBaseUrl }}"
        >
            <div class="mb-3">
                <h2 class="h5 mb-1">core.cfg generator</h2>
                <div class="text-muted">Adjust the Accelerator settings, then generate the config block. Paste the generated lines at the bottom of <code>addons/sourcemod/configs/core.cfg</code>.</div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="core-account">MinidumpAccount</label>
                    <input id="core-account" class="form-control" data-core-field="account" value="{{ steamAccount ? steamAccount.identifier : 'YOUR_STEAMID64' }}">
                    <div class="form-text">SteamID64 that will own uploaded crashes.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="core-base-url">Base URL</label>
                    <input id="core-base-url" class="form-control" data-core-field="baseUrl" value="{{ coreConfigBaseUrl }}">
                    <div class="form-text">This is generated from the current page host, not hardcoded.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="core-symbol-upload">MinidumpSymbolUpload</label>
                    <select id="core-symbol-upload" class="form-select" data-core-field="symbolUpload">
                        <option value="0">0 - disabled</option>
                        <option value="1">1 - minimal</option>
                        <option value="2">2 - normal</option>
                        <option value="3" selected>3 - full</option>
                    </select>
                    <div class="form-text">Controls how aggressively Accelerator uploads symbol files.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="core-binary-upload">MinidumpBinaryUpload</label>
                    <select id="core-binary-upload" class="form-select" data-core-field="binaryUpload">
                        <option value="yes" selected>yes</option>
                        <option value="no">no</option>
                    </select>
                    <div class="form-text">Allows uploading binaries so Throttle can generate symbols.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="core-presubmit">MinidumpPresubmit</label>
                    <select id="core-presubmit" class="form-select" data-core-field="presubmit">
                        <option value="yes" selected>yes</option>
                        <option value="no">no</option>
                    </select>
                    <div class="form-text">Asks Throttle which symbols are missing before uploading the dump.</div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" type="button" data-core-generate>Generate settings</button>
                <button class="btn btn-outline-secondary" type="button" data-copy-token="#core-cfg">
                    <svg class="bi me-1" width="16" height="16" aria-hidden="true">
                        <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#clipboard"></use>
                    </svg>
                    Copy config
                </button>
            </div>

            <textarea id="core-cfg" class="form-control font-monospace profile-config mt-3" readonly data-autosize-textarea>{{ coreConfig }}</textarea>

            <div class="table-responsive mt-3">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Setting</th>
                            <th>How it is used</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>MinidumpAccount</code></td>
                            <td>Links uploaded crash dumps to this profile by SteamID64.</td>
                        </tr>
                        <tr>
                            <td><code>MinidumpSymbolUpload</code></td>
                            <td>Controls symbol upload depth. Use <code>3</code> for full Linux symbol support.</td>
                        </tr>
                        <tr>
                            <td><code>MinidumpBinaryUpload</code></td>
                            <td>Enables binary upload to <code>/binary/submit</code> for modules that need generated symbols.</td>
                        </tr>
                        <tr>
                            <td><code>MinidumpPresubmit</code></td>
                            <td>Lets Throttle request only missing useful module symbols before the final dump upload.</td>
                        </tr>
                        <tr>
                            <td><code>MinidumpUrl</code></td>
                            <td>Receives crash minidumps and records usage when the generated token is present.</td>
                        </tr>
                        <tr>
                            <td><code>MinidumpSymbolUrl</code></td>
                            <td>Receives Breakpad symbol files and uses your profile upload token.</td>
                        </tr>
                        <tr>
                            <td><code>MinidumpBinaryUrl</code></td>
                            <td>Receives binaries and uses your profile upload token.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="profile-panel mt-3" data-ai-provider-section data-ai-provider-definitions="{{ aiProviderTemplates|json_encode|e('html_attr') }}">
            <div class="mb-3">
                <h2 class="h5 mb-1">AI analysis</h2>
                <div class="text-muted">Save one or more AI API configurations for crash analysis. Keys are stored on the server and encrypted before being written to the database.</div>
            </div>

            {% if aiAnalysisEnabled %}
                <div class="alert alert-success py-2 mb-3">Ask AI buttons are enabled globally in <a href="{{ path('health') }}" class="alert-link">/health</a>.</div>
            {% else %}
                <div class="alert alert-warning py-2 mb-3">Ask AI buttons are currently hidden because AI crash analysis is disabled in <a href="{{ path('health') }}" class="alert-link">/health</a>.</div>
            {% endif %}

            <div class="border rounded p-3 mb-3">
                <h3 class="h6 mb-3">Add AI config</h3>
                <form method="post" action="{{ path('profile_ai_config_save') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('profile-ai-config-save') }}">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Display name</label>
                            <input class="form-control" name="display_name" value="" maxlength="100" placeholder="My OpenAI config">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Provider</label>
                            <select class="form-select" name="provider" required data-ai-provider-select>
                                {% for providerKey, provider in aiProviderTemplates %}
                                    <option value="{{ providerKey }}">{{ provider.label }}</option>
                                {% endfor %}
                            </select>
                            <div class="form-text" data-ai-provider-help></div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Model</label>
                            <input class="form-control font-monospace" name="model" value="" maxlength="255" placeholder="gpt-5.2" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">API key</label>
                            <input type="password" class="form-control font-monospace" name="api_key" value="" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Base URL</label>
                            <input class="form-control font-monospace" name="base_url" value="" maxlength="1024" placeholder="Optional unless using OpenRouter or Custom OpenAI-compatible" data-ai-base-url>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Temperature</label>
                            <input class="form-control" name="temperature" value="0.2">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Max tokens</label>
                            <input class="form-control" name="max_tokens" value="2048">
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="ai-enabled-new" name="enabled" value="1" checked>
                                <label class="form-check-label" for="ai-enabled-new">Enabled</label>
                            </div>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="ai-default-new" name="is_default" value="1"{% if not aiConfigs %} checked{% endif %}>
                                <label class="form-check-label" for="ai-default-new">Default config</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Default prompt</label>
                            <textarea class="form-control" name="default_prompt" rows="8" required>{{ defaultAiPrompt }}</textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Extra request JSON</label>
                            <textarea class="form-control font-monospace" name="extra_options_json" rows="5" placeholder='{"reasoning": {"effort": "high"}}'></textarea>
                            <div class="form-text">Optional provider-specific JSON merged into the request body. Useful for custom OpenAI-compatible APIs and advanced provider knobs.</div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Create AI config</button>
                    </div>
                </form>
            </div>

            {% if aiConfigs %}
                <div class="mb-2 d-flex align-items-center justify-content-between gap-2">
                    <h3 class="h6 mb-0">Saved configs</h3>
                    <div class="text-muted small">{{ aiConfigs|length }} saved</div>
                </div>

                <div class="profile-ai-config-list">
                    {% for config in aiConfigs %}
                        <details class="profile-ai-card">
                            <summary class="profile-ai-card-summary">
                                <div class="profile-ai-card-main">
                                    <div class="fw-semibold">{{ config.display_name }}</div>
                                    <div class="text-muted small">{{ config.provider_label }} &middot; {{ config.model }}</div>
                                </div>
                                <div class="profile-ai-card-meta">
                                    {% if config.api_key_configured %}
                                        <span class="profile-ai-key-indicator">Key {{ config.api_key_mask ?: 'saved' }}</span>
                                    {% endif %}
                                    {% if config.is_default %}
                                        <span class="badge text-bg-primary">Default</span>
                                    {% endif %}
                                    {% if not config.enabled %}
                                        <span class="badge text-bg-secondary">Disabled</span>
                                    {% endif %}
                                </div>
                            </summary>

                            <div class="profile-ai-card-body">
                                <form method="post" action="{{ path('profile_ai_config_save') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('profile-ai-config-save') }}">
                                    <input type="hidden" name="id" value="{{ config.id }}">

                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Display name</label>
                                            <input class="form-control" name="display_name" value="{{ config.display_name }}" maxlength="100" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Provider</label>
                                            <select class="form-select" name="provider" required data-ai-provider-select>
                                                {% for providerKey, provider in aiProviderTemplates %}
                                                    <option value="{{ providerKey }}"{% if providerKey == config.provider %} selected{% endif %}>{{ provider.label }}</option>
                                                {% endfor %}
                                            </select>
                                            <div class="form-text" data-ai-provider-help></div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Model</label>
                                            <input class="form-control font-monospace" name="model" value="{{ config.model }}" maxlength="255" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">API key</label>
                                            <input type="password" class="form-control font-monospace" name="api_key" placeholder="Leave blank to keep the current key">
                                            <div class="form-text">
                                                {% if config.api_key_configured %}
                                                    Saved as {{ config.api_key_mask ?: 'hidden value' }}. Enter a new value only when you want to replace it.
                                                {% else %}
                                                    No API key saved yet.
                                                {% endif %}
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Base URL</label>
                                            <input class="form-control font-monospace" name="base_url" value="{{ config.base_url ?? '' }}" maxlength="1024" placeholder="Used for OpenRouter or custom OpenAI-compatible APIs" data-ai-base-url>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Temperature</label>
                                            <input class="form-control" name="temperature" value="{{ config.temperature is not null ? config.temperature : '' }}" placeholder="0.2">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Max tokens</label>
                                            <input class="form-control" name="max_tokens" value="{{ config.max_tokens is not null ? config.max_tokens : '' }}" placeholder="2048">
                                        </div>
                                        <div class="col-md-3 d-flex align-items-end">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" role="switch" id="ai-enabled-{{ config.id }}" name="enabled" value="1"{% if config.enabled %} checked{% endif %}>
                                                <label class="form-check-label" for="ai-enabled-{{ config.id }}">Enabled</label>
                                            </div>
                                        </div>
                                        <div class="col-md-3 d-flex align-items-end">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" role="switch" id="ai-default-{{ config.id }}" name="is_default" value="1"{% if config.is_default %} checked{% endif %}>
                                                <label class="form-check-label" for="ai-default-{{ config.id }}">Default config</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Default prompt</label>
                                            <textarea class="form-control" name="default_prompt" rows="6" required>{{ config.default_prompt }}</textarea>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Extra request JSON</label>
                                            <textarea class="form-control font-monospace" name="extra_options_json" rows="5" placeholder='{"reasoning": {"effort": "high"}}'>{{ config.extra_options_json }}</textarea>
                                            <div class="form-text">Optional provider-specific JSON merged into the request body.</div>
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2 mt-3">
                                        <button type="submit" class="btn btn-primary">Save AI config</button>
                                    </div>
                                </form>
                                <div class="d-flex gap-2 mt-2">
                                    <form method="post" action="{{ path('profile_ai_config_delete') }}" onsubmit="return confirm('Delete this AI config?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('profile-ai-config-delete') }}">
                                        <input type="hidden" name="config_id" value="{{ config.id }}">
                                        <button type="submit" class="btn btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </details>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (() => {
            const section = document.querySelector('[data-ai-provider-section]');
            if (!section) {
                return;
            }

            let definitions = {};
            try {
                definitions = JSON.parse(section.getAttribute('data-ai-provider-definitions') || '{}');
            } catch (error) {
                definitions = {};
            }

            const bindForm = (form) => {
                const select = form.querySelector('[data-ai-provider-select]');
                const help = form.querySelector('[data-ai-provider-help]');
                const baseUrl = form.querySelector('[data-ai-base-url]');
                if (!select || !help || !baseUrl) {
                    return;
                }

                const update = () => {
                    const provider = definitions[select.value] || null;
                    help.textContent = provider && provider.help ? provider.help : '';
                    if (provider && typeof provider.default_base_url === 'string' && baseUrl.value.trim() === '') {
                        baseUrl.placeholder = provider.default_base_url !== '' ? provider.default_base_url : 'Required for custom OpenAI-compatible providers';
                    }
                };

                select.addEventListener('change', update);
                update();
            };

            section.querySelectorAll('form').forEach(bindForm);
        })();
    </script>
{% endblock %}
