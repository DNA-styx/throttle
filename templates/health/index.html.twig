{% extends 'base.html.twig' %}

{% block title %}Health{% endblock %}

{% block body %}
    <div class="profile-shell health-shell">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h1 class="h3 mb-1">Health</h1>
                <div class="text-muted">Runtime checks for crash processing and uploads.</div>
            </div>
            <a href="{{ path('dashboard') }}" class="btn btn-outline-secondary">Dashboard</a>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <section class="profile-panel mb-3">
            <h2 class="h5 mb-3">Queue</h2>
            <div class="profile-stat-grid">
                <div>
                    <div class="profile-stat-value">{{ queue.pending }}</div>
                    <div class="text-muted">Pending</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ queue.failed }}</div>
                    <div class="text-muted">Failed</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ queue.processed_today }}</div>
                    <div class="text-muted">Processed today</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ queue.latest_processed ?: '-' }}</div>
                    <div class="text-muted">Last processed</div>
                </div>
            </div>
        </section>

        <section class="profile-panel">
            <h2 class="h5 mb-3">Checks</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Check</th>
                            <th>Detail</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for check in checks %}
                            <tr class="{{ check.ok ? '' : 'table-danger' }}">
                                <td>{{ check.ok ? 'OK' : 'Fail' }}</td>
                                <td>{{ check.name }}</td>
                                <td><code>{{ check.detail }}</code></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="profile-panel mt-3">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">Upload processing settings</h2>
                    <div class="text-muted">Runtime settings used by symbol uploads, binary uploads, optional raw source lookup, and optional AI crash analysis.</div>
                </div>
                <span class="badge text-bg-secondary">{{ uploadSettingsSource }}</span>
            </div>

            {% if uploadSettingsSaved %}
                <div class="alert alert-success">Upload processing settings saved.</div>
            {% endif %}
            {% if uploadSettingsReset %}
                <div class="alert alert-success">Upload processing settings reset to defaults.</div>
            {% endif %}
            {% for error in uploadSettingsErrors %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endfor %}

            <form method="post" class="health-settings-stack">
                <input type="hidden" name="_token" value="{{ csrf_token('upload-settings') }}">
                <input type="hidden" name="upload_settings_form" value="1">
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="streaming-symbols-enabled" name="streaming_symbols_enabled" value="1"{% if uploadSettings.streaming_symbols_enabled %} checked{% endif %}>
                        <label class="form-check-label" for="streaming-symbols-enabled">Streaming symbol upload processing</label>
                    </div>
                    <div class="form-text">Reads .sym uploads line by line and writes .sym.gz without loading the whole file into PHP memory.</div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="allow-anonymous-minidumps" name="allow_anonymous_minidump_uploads" value="1"{% if uploadSettings.allow_anonymous_minidump_uploads %} checked{% endif %}>
                        <label class="form-check-label" for="allow-anonymous-minidumps">Allow minidump uploads without a token</label>
                    </div>
                    <div class="form-text">Only controls crash dump uploads sent to <code>MinidumpUrl</code> (<code>/submit</code>). Symbol and binary uploads already require tokens.</div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="crash-source-lookup-enabled" name="crash_source_lookup_enabled" value="1"{% if uploadSettings.crash_source_lookup_enabled %} checked{% endif %}>
                        <label class="form-check-label" for="crash-source-lookup-enabled">Enable native source lookup on Raw crash pages (Experimental)</label>
                    </div>
                    <div class="form-text">Adds per-frame source lookup for native stack frames using GitHub code search and targeted file fetches or admin-approved local source roots.</div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="crash-ai-analysis-enabled" name="crash_ai_analysis_enabled" value="1"{% if uploadSettings.crash_ai_analysis_enabled %} checked{% endif %}>
                        <label class="form-check-label" for="crash-ai-analysis-enabled">Enable AI crash analysis</label>
                    </div>
                    <div class="form-text">Shows Ask AI buttons on crash details and raw pages for users who configured AI APIs in their profile.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="upload-memory-limit">Upload memory limit</label>
                    <input id="upload-memory-limit" name="upload_memory_limit" class="form-control font-monospace" value="{{ uploadSettings.upload_memory_limit }}" list="upload-memory-limit-options">
                    <datalist id="upload-memory-limit-options">
                        <option value="128M">
                        <option value="256M">
                        <option value="512M">
                        <option value="1G">
                        <option value="-1">
                    </datalist>
                    <div class="form-text">
                        Upload endpoints will use: <code>{{ uploadSettings.upload_memory_limit }}</code>.<br>
                        Current /health request limit: <code>{{ currentMemoryLimit }}</code>.
                    </div>
                </div>
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="upload-failure-backoff-enabled" name="upload_failure_backoff_enabled" value="1"{% if uploadSettings.upload_failure_backoff_enabled %} checked{% endif %}>
                        <label class="form-check-label" for="upload-failure-backoff-enabled">Upload failure backoff</label>
                    </div>
                    <div class="form-text">Stops re-requesting the same module for a while after repeated upload failures.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="upload-failure-backoff-threshold">Failure threshold</label>
                    <input id="upload-failure-backoff-threshold" name="upload_failure_backoff_threshold" type="number" min="1" class="form-control" value="{{ uploadSettings.upload_failure_backoff_threshold }}">
                </div>
                <div class="mb-3">
                    <label class="form-label" for="upload-failure-backoff-ttl">Backoff TTL (sec)</label>
                    <input id="upload-failure-backoff-ttl" name="upload_failure_backoff_ttl" type="number" min="60" step="60" class="form-control" value="{{ uploadSettings.upload_failure_backoff_ttl }}">
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="submit" name="reset_upload_settings" value="1" class="btn btn-outline-secondary">Reset</button>
                </div>
            </form>
        </section>

        <section class="profile-panel mt-3">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">Upload failure backoff state</h2>
                    <div class="text-muted">Module-level suppression used to stop endless retry loops after repeated symbol or binary upload failures.</div>
                </div>
                <form method="post" action="{{ path('health_symbols_backoff_reset') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('health-symbols-backoff-reset') }}">
                    <button type="submit" class="btn btn-outline-secondary">Clear backoff state</button>
                </form>
            </div>

            <div class="profile-stat-grid mb-3">
                <div>
                    <div class="profile-stat-value">{{ backoffStats.total }}</div>
                    <div class="text-muted">Tracked modules</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ backoffStats.suppressed }}</div>
                    <div class="text-muted">Currently suppressed</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ uploadSettings.upload_failure_backoff_enabled ? 'On' : 'Off' }}</div>
                    <div class="text-muted">Backoff enabled</div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Module</th>
                            <th>Identifier</th>
                            <th>Failures</th>
                            <th>Blocked until</th>
                            <th>Last status</th>
                            <th>Endpoint</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in backoffStats.entries %}
                            <tr>
                                <td class="font-monospace">{{ entry.module }}</td>
                                <td class="font-monospace">{{ entry.identifier }}</td>
                                <td>{{ entry.count }}</td>
                                <td>{{ entry.blocked_until ? entry.blocked_until|date('Y-m-d H:i:s') : '-' }}</td>
                                <td>{{ entry.last_status_code ?: '-' }}</td>
                                <td>{{ entry.last_endpoint ?: '-' }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-muted">No upload failure backoff entries are currently tracked.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="profile-panel mt-3">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">Binary upload request policy</h2>
                    <div class="text-muted">These effective rules control which Linux modules Accelerator is asked to upload so Throttle can generate symbols during presubmit.</div>
                </div>
                <span class="badge text-bg-secondary">{{ symbolRequestPolicySource }}</span>
            </div>

            {% if symbolRequestPolicyEmpty %}
                <div class="alert alert-info">Defaults are currently empty. That now means default allow: Throttle will request missing modules like the original behavior unless a deny rule blocks them or upload-failure backoff suppresses them.</div>
            {% endif %}

            {% if symbolRequestPolicySaved %}
                <div class="alert alert-success">Binary upload request policy saved.</div>
            {% endif %}
            {% if symbolRequestPolicyReset %}
                <div class="alert alert-success">Binary upload request policy reset to defaults.</div>
            {% endif %}
            {% for error in symbolRequestPolicyErrors %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endfor %}

            <form method="post" class="mb-3">
                <input type="hidden" name="_token" value="{{ csrf_token('symbol-request-policy') }}">
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-8">
                        <label class="form-label" for="policy-test-module">Test module path/name</label>
                        <input id="policy-test-module" name="policy_test_module" class="form-control font-monospace" value="{{ policyTestInput }}" placeholder="/home/container/tf/bin/server_srv.so">
                    </div>
                    <div class="col-md-4">
                        <button type="submit" name="test_policy" value="1" class="btn btn-outline-primary">Check policy</button>
                    </div>
                </div>
                {% if policyTest %}
                    <div class="alert {{ policyTest.requested ? 'alert-success' : 'alert-warning' }}">
                        <strong>{{ policyTest.requested ? 'Binary upload requested' : 'Blocked' }}</strong>
                        for <code>{{ policyTest.basename }}</code>.
                        {% if policyTest.rule %}
                            Matched <code>{{ policyTest.stage }}</code> rule <code>{{ policyTest.rule }}</code> = <code>{{ policyTest.value }}</code>.
                        {% else %}
                            No rule matched; default allow.
                        {% endif %}
                        <div class="small mt-1">Allow rules override generic deny rules, but hard deny path/exact rules still win.</div>
                    </div>
                {% endif %}
                <div class="row g-3">
                    {% for rule, value in symbolRequestPolicyFields %}
                        <div class="col-md-6">
                            <label class="form-label" for="symbol-request-{{ rule }}"><code>{{ rule }}</code></label>
                            <textarea id="symbol-request-{{ rule }}" name="symbol_request_policy[{{ rule }}]" class="form-control font-monospace" rows="{{ rule == 'allow-regex' ? 4 : 3 }}">{{ value }}</textarea>
                            <div class="form-text">One value per line.</div>
                        </div>
                    {% endfor %}
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Save policy</button>
                    <button type="submit" name="reset_policy" value="1" class="btn btn-outline-secondary">Reset to defaults</button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Rule</th>
                            <th>Values</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rule, values in symbolRequestPolicy %}
                            <tr>
                                <td><code>{{ rule }}</code></td>
                                <td>
                                    {% for value in values %}
                                        <code class="me-2">{{ value }}</code>
                                    {% else %}
                                        <span class="text-muted">None</span>
                                    {% endfor %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="profile-panel mt-3">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">Symbol maintenance</h2>
                    <div class="text-muted">Refresh caches after manual uploads and keep symbol presence in sync with the filesystem.</div>
                </div>
                <form method="post" action="{{ path('health_symbols_refresh') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('health-symbols-refresh') }}">
                    <button type="submit" class="btn btn-primary">Refresh symbol cache</button>
                </form>
            </div>

            <form method="post" action="{{ path('health_symbols_upload_binary') }}" enctype="multipart/form-data" class="row g-3">
                <input type="hidden" name="_token" value="{{ csrf_token('health-symbols-upload-binary') }}">
                <div class="col-lg">
                    <label class="form-label" for="binary-file">Upload binary and generate symbols</label>
                    <input id="binary-file" type="file" name="binary_file" class="form-control" required>
                </div>
                <div class="col-auto d-flex align-items-end">
                    <button type="submit" class="btn btn-success">Upload binary</button>
                </div>
                <div class="col-12">
                    <div class="form-text">Uses <code>dump_syms</code> when possible and falls back to <code>nm</code> for degraded public-symbol output.</div>
                </div>
            </form>
        </section>

        <section class="profile-panel mt-3">
            <div class="table-more module-log-toggle mb-3">
                <a href="#stored-symbols-panel" data-bs-toggle="collapse" aria-expanded="{{ symbolsOpen ? 'true' : 'false' }}" aria-controls="stored-symbols-panel">
                    <svg class="bi me-1" width="16" height="16" aria-hidden="true">
                        <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#three-dots"></use>
                    </svg>
                    Stored symbols
                </a>
            </div>

            <div id="stored-symbols-panel" class="collapse{% if symbolsOpen %} show{% endif %}">
                <div class="text-muted mb-3">Search, select, and export existing symbol files as a ZIP archive of <code>.sym.gz</code> files.</div>
                <form method="get" class="row g-2 align-items-end mb-3">
                    <div class="col-md-8">
                        <label class="form-label" for="symbol-filter">Filter</label>
                        <input id="symbol-filter" name="symbol_filter" class="form-control font-monospace" value="{{ symbolFilter }}" placeholder="engine_srv.so or 45EA846F...">
                    </div>
                    <div class="col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-outline-primary">Search</button>
                        <a href="{{ path('health') }}" class="btn btn-outline-secondary">Clear</a>
                    </div>
                </form>

                <form method="post" action="{{ path('health_symbols_export') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('health-symbols-export') }}">
                    <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                        <div class="text-muted">{{ symbolEntriesCount }} matching version{{ symbolEntriesCount == 1 ? '' : 's' }}</div>
                        <button type="submit" class="btn btn-outline-primary">Export selected symbols</button>
                        <button type="submit" name="delete_selected" value="1" class="btn btn-outline-danger" onclick="return confirm('Delete all selected stored symbol versions?');">Delete selected symbols</button>
                    </div>
                    {% if symbolGroups %}
                        <div class="table-responsive health-symbols-table-wrap">
                            <table class="table table-sm align-middle health-symbols-table">
                                <colgroup>
                                    <col class="health-symbols-col-checkbox">
                                    <col class="health-symbols-col-module">
                                    <col class="health-symbols-col-identifier">
                                    <col class="health-symbols-col-size">
                                    <col class="health-symbols-col-modified">
                                    <col class="health-symbols-col-binary">
                                    <col class="health-symbols-col-action">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Module</th>
                                        <th>Identifier</th>
                                        <th>Size</th>
                                        <th>Modified</th>
                                        <th>Binary</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                {% for group in symbolGroups %}
                                    {% set groupIndex = loop.index %}
                                    {% set groupId = 'stored-symbol-group-' ~ groupIndex %}
                                    {% set openGroup = symbolFilter != '' %}
                                    {% set primaryEntry = group.entries|first %}
                                    <tbody>
                                        <tr>
                                            <td><input type="checkbox" name="selected_symbols[]" value="{{ primaryEntry.module }}|{{ primaryEntry.identifier }}"></td>
                                            <td class="font-monospace">
                                                {{ group.module }}
                                                {% if group.version_count > 1 %}
                                                    <a href="#{{ groupId }}" data-bs-toggle="collapse" aria-expanded="{{ openGroup ? 'true' : 'false' }}" aria-controls="{{ groupId }}" class="ms-1 text-decoration-none" title="Show {{ group.version_count - 1 }} more version{{ group.version_count - 1 == 1 ? '' : 's' }}">
                                                        ({{ group.version_count }})
                                                    </a>
                                                {% endif %}
                                            </td>
                                            <td class="font-monospace">{{ primaryEntry.identifier }}</td>
                                            <td>{{ primaryEntry.bytes|number_format }}</td>
                                            <td>{{ primaryEntry.modified_at|date('Y-m-d H:i:s') }}</td>
                                            <td>{{ primaryEntry.binary_path ? 'Available' : 'Missing' }}</td>
                                            <td class="text-end">
                                                <button type="submit" form="delete-symbol-{{ groupIndex }}-1" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete stored symbols for {{ primaryEntry.module }}/{{ primaryEntry.identifier }}?');">Delete</button>
                                            </td>
                                        </tr>
                                        {% if group.version_count > 1 %}
                                            <tr class="health-symbols-detail-row">
                                                <td colspan="8" class="p-0 border-0">
                                                    <div id="{{ groupId }}" class="collapse{% if openGroup %} show{% endif %}">
                                                        <div class="health-symbols-detail-panel">
                                                            <table class="table table-sm align-middle health-symbols-table mb-0">
                                                                <colgroup>
                                                                    <col class="health-symbols-col-checkbox">
                                                                    <col class="health-symbols-col-module">
                                                                    <col class="health-symbols-col-identifier">
                                                                    <col class="health-symbols-col-size">
                                                                    <col class="health-symbols-col-modified">
                                                                    <col class="health-symbols-col-binary">
                                                                    <col class="health-symbols-col-action">
                                                                </colgroup>
                                                                <tbody>
                                                                    {% for entry in group.entries|slice(1) %}
                                                                        {% set deleteFormId = 'delete-symbol-' ~ groupIndex ~ '-' ~ (loop.index + 1) %}
                                                                        <tr class="health-symbols-version-row">
                                                                            <td><input type="checkbox" name="selected_symbols[]" value="{{ entry.module }}|{{ entry.identifier }}"></td>
                                                                            <td class="font-monospace"></td>
                                                                            <td class="font-monospace">{{ entry.identifier }}</td>
                                                                            <td>{{ entry.bytes|number_format }}</td>
                                                                            <td>{{ entry.modified_at|date('Y-m-d H:i:s') }}</td>
                                                                            <td>{{ entry.binary_path ? 'Available' : 'Missing' }}</td>
                                                                            <td class="text-end">
                                                                                <button type="submit" form="{{ deleteFormId }}" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete stored symbols for {{ entry.module }}/{{ entry.identifier }}?');">Delete</button>
                                                                            </td>
                                                                        </tr>
                                                                    {% endfor %}
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endif %}
                                    </tbody>
                                {% endfor %}
                            </table>
                        </div>
                    {% else %}
                        <div class="text-muted">No stored symbol files matched the current filter.</div>
                    {% endif %}
                </form>
                {% for group in symbolGroups %}
                    {% set groupIndex = loop.index %}
                    {% for entry in group.entries %}
                        <form id="delete-symbol-{{ groupIndex }}-{{ loop.index }}" method="post" action="{{ path('health_symbols_delete') }}" class="d-none">
                            <input type="hidden" name="_token" value="{{ csrf_token('health-symbols-delete') }}">
                            <input type="hidden" name="module" value="{{ entry.module }}">
                            <input type="hidden" name="identifier" value="{{ entry.identifier }}">
                        </form>
                    {% endfor %}
                {% endfor %}
            </div>
        </section>
    </div>
{% endblock %}
