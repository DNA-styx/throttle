{% extends 'base.html.twig' %}

{% block title %}Health{% endblock %}

{% block body %}
    <div class="profile-shell health-shell">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h1 class="h3 mb-1">Health</h1>
                <div class="text-muted">Runtime checks for crash processing and uploads.</div>
            </div>
            <a href="{{ path('dashboard') }}" class="btn btn-outline-secondary">Dashboard</a>
        </div>

        <section class="profile-panel mb-3">
            <h2 class="h5 mb-3">Queue</h2>
            <div class="profile-stat-grid">
                <div>
                    <div class="profile-stat-value">{{ queue.pending }}</div>
                    <div class="text-muted">Pending</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ queue.failed }}</div>
                    <div class="text-muted">Failed</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ queue.processed_today }}</div>
                    <div class="text-muted">Processed today</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ queue.latest_processed ?: '-' }}</div>
                    <div class="text-muted">Last processed</div>
                </div>
            </div>
        </section>

        <section class="profile-panel mb-3">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">Users</h2>
                    <div class="text-muted">Quick summary of account state, linked providers, and moderation flags.</div>
                </div>
                <a href="{{ path('health_users') }}" class="btn btn-outline-primary">Manage users</a>
            </div>
            <div class="profile-stat-grid">
                <div>
                    <div class="profile-stat-value">{{ userSummary.total }}</div>
                    <div class="text-muted">Total users</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ userSummary.banned }}</div>
                    <div class="text-muted">Banned</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ userSummary.uploads_blocked }}</div>
                    <div class="text-muted">Uploads blocked</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ userSummary.with_password }}</div>
                    <div class="text-muted">With password</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ userSummary.with_steam }}</div>
                    <div class="text-muted">Steam linked</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ userSummary.with_discord }}</div>
                    <div class="text-muted">Discord linked</div>
                </div>
            </div>
        </section>

        <section class="profile-panel">
            <h2 class="h5 mb-3">Checks</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Check</th>
                            <th>Detail</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for check in checks %}
                            <tr class="{{ check.ok ? '' : 'table-danger' }}">
                                <td>{{ check.ok ? 'OK' : 'Fail' }}</td>
                                <td>{{ check.name }}</td>
                                <td><code>{{ check.detail }}</code></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section id="auth-mail" class="profile-panel mt-3">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">Authentication & Mail</h2>
                    <div class="text-muted">Quick diagnostics for SMTP delivery plus Steam and Discord sign-in configuration.</div>
                </div>
            </div>

            {% for message in app.flashes('auth_danger') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('auth_warning') %}
                <div class="alert alert-warning">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('auth_success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Component</th>
                            <th>Status</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="{{ mailerSummary.configured ? '' : 'table-warning' }}">
                            <td>SMTP mailer</td>
                            <td>{{ mailerSummary.configured ? 'Configured' : 'Not configured' }}</td>
                            <td>
                                {% if mailerSummary.configured %}
                                    <div><strong>From:</strong> <code>{{ authEnvironment.getMailerFrom() }}</code></div>
                                    <div><strong>Method:</strong> <code>{{ mailerSummary.scheme|upper }}</code></div>
                                    <div><strong>Host:</strong> <code>{{ mailerSummary.host }}</code>{% if mailerSummary.port %}:<code>{{ mailerSummary.port }}</code>{% endif %}</div>
                                    <div><strong>Username:</strong> <code>{{ mailerSummary.username }}</code></div>
                                    <div><strong>Encryption:</strong> <code>{{ mailerSummary.encryption ?: 'default' }}</code>{% if mailerSummary.auth_mode %} · <strong>Auth:</strong> <code>{{ mailerSummary.auth_mode }}</code>{% endif %}</div>
                                    <div class="small text-muted mt-1">DKIM/SPF are applied by your mail provider and DNS, not by Throttle itself.</div>
                                {% else %}
                                    <span class="text-muted">{{ authEnvironment.mailerNotice() }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr class="{{ uploadSettings.auth_enable_steam ? '' : 'table-warning' }}">
                            <td>Steam login</td>
                            <td>{{ uploadSettings.auth_enable_steam ? 'Enabled' : 'Disabled' }}</td>
                            <td>
                                <div><strong>Toggle:</strong> <code>{{ uploadSettings.auth_enable_steam ? 'enabled' : 'disabled' }}</code></div>
                                <div><strong>STEAM_API_KEY:</strong> <code>{{ authEnvironment.isSteamApiConfigured() ? authEnvironment.getSteamApiKeyMasked() : 'not configured' }}</code></div>
                                <div class="small text-muted mt-1">{{ authEnvironment.steamNotice() }}</div>
                            </td>
                        </tr>
                        <tr class="{{ authEnvironment.isDiscordConfigured() ? '' : 'table-warning' }}">
                            <td>Discord OAuth</td>
                            <td>{{ authEnvironment.isDiscordConfigured() ? 'Configured' : 'Not configured' }}</td>
                            <td>
                                <div><strong>Toggle:</strong> <code>{{ uploadSettings.auth_enable_discord ? 'enabled' : 'disabled' }}</code></div>
                                {% if authEnvironment.isDiscordConfigured() %}
                                    <div><strong>Client ID:</strong> <code>{{ authEnvironment.getDiscordClientIdMasked() }}</code></div>
                                    <div><strong>Callback URL:</strong> <code>{{ discordCallbackUrl }}</code></div>
                                {% else %}
                                    <div class="text-muted">{{ authEnvironment.discordNotice() }}</div>
                                    <div><strong>Expected callback URL:</strong> <code>{{ discordCallbackUrl }}</code></div>
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="border rounded p-3 mt-3">
                <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                    <div>
                        <h3 class="h6 mb-1">SMTP delivery test</h3>
                        <div class="text-muted">Sends a real email through the configured Symfony mailer and shows the exact transport error if sending fails.</div>
                    </div>
                </div>
                <form method="post" action="{{ path('health_auth_test_email') }}" class="row g-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('health-auth-test-email') }}">
                    <div class="col-md-8">
                        <label class="form-label" for="health-test-email">Recipient email</label>
                        <input id="health-test-email" type="email" class="form-control" name="email" value="{{ mailerTestDefaultTo }}" placeholder="admin@example.com" required>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100" {{ not mailerSummary.configured ? 'disabled' : '' }}>Send test email</button>
                    </div>
                </form>
            </div>

            <hr class="my-4">

            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <h3 class="h6 mb-1">Authentication methods</h3>
                    <div class="text-muted">Turn individual sign-in methods on or off without touching the rest of the upload settings.</div>
                </div>
            </div>

            <form method="post" class="health-settings-stack">
                <input type="hidden" name="_token" value="{{ csrf_token('upload-settings') }}">
                <input type="hidden" name="upload_settings_form" value="1">
                <input type="hidden" name="streaming_symbols_enabled" value="{{ uploadSettings.streaming_symbols_enabled ? '1' : '0' }}">
                <input type="hidden" name="allow_anonymous_minidump_uploads" value="{{ uploadSettings.allow_anonymous_minidump_uploads ? '1' : '0' }}">
                <input type="hidden" name="crash_source_lookup_enabled" value="{{ uploadSettings.crash_source_lookup_enabled ? '1' : '0' }}">
                <input type="hidden" name="crash_ai_analysis_enabled" value="{{ uploadSettings.crash_ai_analysis_enabled ? '1' : '0' }}">
                <input type="hidden" name="upload_memory_limit" value="{{ uploadSettings.upload_memory_limit }}">
                <input type="hidden" name="upload_failure_backoff_enabled" value="{{ uploadSettings.upload_failure_backoff_enabled ? '1' : '0' }}">
                <input type="hidden" name="upload_failure_backoff_threshold" value="{{ uploadSettings.upload_failure_backoff_threshold }}">
                <input type="hidden" name="upload_failure_backoff_ttl" value="{{ uploadSettings.upload_failure_backoff_ttl }}">
                {% for signature in uploadSettings.ignored_crash_signatures %}
                    <input type="hidden" name="ignored_crash_signatures[]" value="{{ signature }}">
                {% endfor %}
                {% for category, categorySettings in uploadSettings.storage_cleanup %}
                    <input type="hidden" name="storage_cleanup_{{ category }}_enabled" value="{{ categorySettings.enabled ? '1' : '0' }}">
                    <input type="hidden" name="storage_cleanup_{{ category }}_max_total_size" value="{{ storageCleanupMegabytes[category] }}">
                    <input type="hidden" name="storage_cleanup_{{ category }}_max_age_days" value="{{ categorySettings.max_age_days }}">
                {% endfor %}

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="auth-enable-steam" name="auth_enable_steam" value="1"{% if uploadSettings.auth_enable_steam %} checked{% endif %}>
                            <label class="form-check-label" for="auth-enable-steam">Enable Steam login</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="auth-enable-discord" name="auth_enable_discord" value="1"{% if uploadSettings.auth_enable_discord %} checked{% endif %}>
                            <label class="form-check-label" for="auth-enable-discord">Enable Discord login</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="auth-enable-email-login-link" name="auth_enable_email_login_link" value="1"{% if uploadSettings.auth_enable_email_login_link %} checked{% endif %}>
                            <label class="form-check-label" for="auth-enable-email-login-link">Enable email login links</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="auth-enable-password-login" name="auth_enable_password_login" value="1"{% if uploadSettings.auth_enable_password_login %} checked{% endif %}>
                            <label class="form-check-label" for="auth-enable-password-login">Enable email + password login</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="auth-enable-password-registration" name="auth_enable_password_registration" value="1"{% if uploadSettings.auth_enable_password_registration %} checked{% endif %}>
                            <label class="form-check-label" for="auth-enable-password-registration">Enable email + password registration</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="auth-enable-password-reset" name="auth_enable_password_reset" value="1"{% if uploadSettings.auth_enable_password_reset %} checked{% endif %}>
                            <label class="form-check-label" for="auth-enable-password-reset">Enable password reset</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="auth-enable-token-login" name="auth_enable_token_login" value="1"{% if uploadSettings.auth_enable_token_login %} checked{% endif %}>
                            <label class="form-check-label" for="auth-enable-token-login">Enable upload token login</label>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Save authentication settings</button>
                </div>
            </form>
        </section>

        <section id="upload-processing" class="profile-panel mt-3">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">Upload processing settings</h2>
                    <div class="text-muted">Runtime settings used by symbol uploads, binary uploads, optional raw source lookup, and optional AI crash analysis.</div>
                </div>
                <span class="badge text-bg-secondary">{{ uploadSettingsSource }}</span>
            </div>

            {% if uploadSettingsSaved %}
                <div class="alert alert-success">Upload processing settings saved.</div>
            {% endif %}
            {% if uploadSettingsReset %}
                <div class="alert alert-success">Upload processing settings reset to defaults.</div>
            {% endif %}
            {% for error in uploadSettingsErrors %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endfor %}

            <form method="post" class="health-settings-stack">
                <input type="hidden" name="_token" value="{{ csrf_token('upload-settings') }}">
                <input type="hidden" name="upload_settings_form" value="1">
                <input type="hidden" name="auth_enable_steam" value="{{ uploadSettings.auth_enable_steam ? '1' : '0' }}">
                <input type="hidden" name="auth_enable_discord" value="{{ uploadSettings.auth_enable_discord ? '1' : '0' }}">
                <input type="hidden" name="auth_enable_email_login_link" value="{{ uploadSettings.auth_enable_email_login_link ? '1' : '0' }}">
                <input type="hidden" name="auth_enable_password_login" value="{{ uploadSettings.auth_enable_password_login ? '1' : '0' }}">
                <input type="hidden" name="auth_enable_password_registration" value="{{ uploadSettings.auth_enable_password_registration ? '1' : '0' }}">
                <input type="hidden" name="auth_enable_password_reset" value="{{ uploadSettings.auth_enable_password_reset ? '1' : '0' }}">
                <input type="hidden" name="auth_enable_token_login" value="{{ uploadSettings.auth_enable_token_login ? '1' : '0' }}">
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="streaming-symbols-enabled" name="streaming_symbols_enabled" value="1"{% if uploadSettings.streaming_symbols_enabled %} checked{% endif %}>
                        <label class="form-check-label" for="streaming-symbols-enabled">Streaming symbol upload processing</label>
                    </div>
                    <div class="form-text">Reads .sym uploads line by line and writes .sym.gz without loading the whole file into PHP memory.</div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="allow-anonymous-minidumps" name="allow_anonymous_minidump_uploads" value="1"{% if uploadSettings.allow_anonymous_minidump_uploads %} checked{% endif %}>
                        <label class="form-check-label" for="allow-anonymous-minidumps">Allow minidump uploads without a token</label>
                    </div>
                    <div class="form-text">Only controls crash dump uploads sent to <code>MinidumpUrl</code> (<code>/submit</code>). Symbol and binary uploads already require tokens.</div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="crash-source-lookup-enabled" name="crash_source_lookup_enabled" value="1"{% if uploadSettings.crash_source_lookup_enabled %} checked{% endif %}>
                        <label class="form-check-label" for="crash-source-lookup-enabled">Enable native source lookup on Raw crash pages (Experimental)</label>
                    </div>
                    <div class="form-text">Adds per-frame source lookup for native stack frames using GitHub code search and targeted file fetches or admin-approved local source roots.</div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="crash-ai-analysis-enabled" name="crash_ai_analysis_enabled" value="1"{% if uploadSettings.crash_ai_analysis_enabled %} checked{% endif %}>
                        <label class="form-check-label" for="crash-ai-analysis-enabled">Enable AI crash analysis</label>
                    </div>
                    <div class="form-text">Shows Ask AI buttons on crash details and raw pages for users who configured AI APIs in their profile.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="upload-memory-limit">Upload memory limit</label>
                    <input id="upload-memory-limit" name="upload_memory_limit" class="form-control font-monospace" value="{{ uploadSettings.upload_memory_limit }}" list="upload-memory-limit-options">
                    <datalist id="upload-memory-limit-options">
                        <option value="128M">
                        <option value="256M">
                        <option value="512M">
                        <option value="1G">
                        <option value="-1">
                    </datalist>
                    <div class="form-text">
                        Upload endpoints will use: <code>{{ uploadSettings.upload_memory_limit }}</code>.<br>
                        Current /health request limit: <code>{{ currentMemoryLimit }}</code>.
                    </div>
                </div>
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="upload-failure-backoff-enabled" name="upload_failure_backoff_enabled" value="1"{% if uploadSettings.upload_failure_backoff_enabled %} checked{% endif %}>
                        <label class="form-check-label" for="upload-failure-backoff-enabled">Upload failure backoff</label>
                    </div>
                    <div class="form-text">Stops re-requesting the same module for a while after repeated upload failures.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="upload-failure-backoff-threshold">Failure threshold</label>
                    <input id="upload-failure-backoff-threshold" name="upload_failure_backoff_threshold" type="number" min="1" class="form-control" value="{{ uploadSettings.upload_failure_backoff_threshold }}">
                </div>
                <div class="mb-3">
                    <label class="form-label" for="upload-failure-backoff-ttl">Backoff TTL (sec)</label>
                    <input id="upload-failure-backoff-ttl" name="upload_failure_backoff_ttl" type="number" min="60" step="60" class="form-control" value="{{ uploadSettings.upload_failure_backoff_ttl }}">
                </div>
                <div class="mb-3">
                    <label class="form-label" for="ignored-crash-signatures">Ignored crash signatures</label>
                    <textarea id="ignored-crash-signatures" name="ignored_crash_signatures" class="form-control font-monospace" rows="6" placeholder="libsteam_api.so!SteamGameServer_Shutdown + 0x0">{{ uploadSettings.ignored_crash_signatures|join("\n") }}</textarea>
                    <div class="form-text">One displayed signature per line. Use the same text shown in Top Crashers or Latest Crash Reports. Matching crashes still reach stackwalk so the primary details page can be built, then raw dump access, console history, processing logs, Discord webhooks, and other follow-up processing are skipped.</div>
                </div>
                <hr class="my-4">
                <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                    <div>
                        <h3 class="h6 mb-1">Storage cleanup</h3>
                        <div class="text-muted">Automatic retention rules for heavy crash artifacts, stored symbols, and stored binaries.</div>
                    </div>
                    <button type="submit" class="btn btn-outline-secondary" form="storage-cleanup-run-form">Run cleanup now</button>
                </div>
                {% for message in app.flashes('storage_cleanup_danger') %}
                    <div class="alert alert-danger">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('storage_cleanup_warning') %}
                    <div class="alert alert-warning">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('storage_cleanup_success') %}
                    <div class="alert alert-success">{{ message }}</div>
                {% endfor %}
                {% if storageCleanupSummary %}
                    <div class="alert alert-info">
                        Last {{ storageCleanupSummary.mode }} cleanup ran at {{ storageCleanupSummary.ran_at|date('Y-m-d H:i:s') }}.
                        Deleted {{ storageCleanupSummary.deleted_files }} file(s) and reclaimed {{ storageCleanupSummary.reclaimed_bytes|human_size }}.
                    </div>
                {% endif %}
                <div class="table-responsive mb-3">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Enabled</th>
                                <th>Max total size</th>
                                <th>Max age</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for category, categorySettings in uploadSettings.storage_cleanup %}
                                <tr>
                                    <td>
                                        <div>{{ category|replace({'_': ' '})|title }}</div>
                                        <div class="small text-muted mt-1">
                                            {{ storageCleanupUsage[category].files }} file(s) · {{ storageCleanupUsage[category].bytes|human_size }}
                                        </div>
                                    </td>
                                    <td>
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox" role="switch" id="cleanup-{{ category }}-enabled" name="storage_cleanup_{{ category }}_enabled" value="1"{% if categorySettings.enabled %} checked{% endif %}>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input id="cleanup-{{ category }}-size" name="storage_cleanup_{{ category }}_max_total_size" type="number" min="0" step="1" class="form-control cleanup-size-helper" value="{{ storageCleanupMegabytes[category] }}" placeholder="0">
                                            <span class="input-group-text">MB</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input name="storage_cleanup_{{ category }}_max_age_days" type="number" min="0" step="1" class="form-control" value="{{ categorySettings.max_age_days }}">
                                            <span class="input-group-text">days</span>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="submit" name="reset_upload_settings" value="1" class="btn btn-outline-secondary">Reset</button>
                </div>
            </form>

            <hr class="my-4">

            <div id="global-ai-analysis" class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <h3 class="h6 mb-1">Global AI analysis</h3>
                    <div class="text-muted">Site-wide AI summary used for the main `Ai Analysis` tab on crash pages and reused by crash signature (`stackhash`).</div>
                </div>
                <span class="badge text-bg-secondary">{{ globalAiConfig.enabled ? 'Enabled' : 'Disabled' }}</span>
            </div>

            {% for message in app.flashes('global_ai_danger') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('global_ai_warning') %}
                <div class="alert alert-warning">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('global_ai_success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            <form method="post" action="{{ path('health_global_ai_save') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('health-global-ai') }}">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" role="switch" id="global-ai-enabled" name="enabled" value="1"{% if globalAiConfig.enabled %} checked{% endif %}>
                            <label class="form-check-label" for="global-ai-enabled">Enable global AI</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Provider</label>
                        <select class="form-select" name="provider" required>
                            {% for providerKey, provider in globalAiProviderTemplates %}
                                <option value="{{ providerKey }}"{% if globalAiConfig.provider == providerKey %} selected{% endif %}>{{ provider.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Model</label>
                        <input class="form-control font-monospace" name="model" value="{{ globalAiConfig.model }}" maxlength="255" placeholder="gpt-5.2" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">API key</label>
                        <input type="password" class="form-control font-monospace" name="api_key" value="" placeholder="{{ globalAiConfig.api_key_mask ?: 'Enter API key' }}">
                        <div class="form-text">{{ globalAiConfig.api_key_mask ?: 'No saved key yet.' }}</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Base URL</label>
                        <input class="form-control font-monospace" name="base_url" value="{{ globalAiConfig.base_url ?: '' }}" maxlength="1024" placeholder="Optional unless using OpenRouter or Custom OpenAI-compatible">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Temperature</label>
                        <input class="form-control" name="temperature" value="{{ globalAiConfig.temperature is not null ? globalAiConfig.temperature : '' }}" placeholder="0.2">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Max tokens</label>
                        <input class="form-control" name="max_tokens" value="{{ globalAiConfig.max_tokens is not null ? globalAiConfig.max_tokens : '' }}" placeholder="2048">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Prompt</label>
                        <textarea class="form-control" name="prompt" rows="8" required>{{ globalAiConfig.prompt }}</textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Extra request JSON</label>
                        <textarea class="form-control font-monospace" name="extra_options_json" rows="5" placeholder='{"reasoning": {"effort": "high"}}'>{{ globalAiConfig.extra_options_json }}</textarea>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Save global AI</button>
                    <button type="submit" class="btn btn-outline-secondary" formaction="{{ path('health_global_ai_test') }}">Test current config</button>
                </div>
            </form>
        </section>

        <section id="backoff-state" class="profile-panel mt-3">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">Upload failure backoff state</h2>
                    <div class="text-muted">Module-level suppression used to stop endless retry loops after repeated symbol or binary upload failures.</div>
                </div>
                <form method="post" action="{{ path('health_symbols_backoff_reset') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('health-symbols-backoff-reset') }}">
                    <button type="submit" class="btn btn-outline-secondary">Clear backoff state</button>
                </form>
            </div>

            {% for message in app.flashes('backoff_danger') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('backoff_warning') %}
                <div class="alert alert-warning">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('backoff_success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            <div class="profile-stat-grid mb-3">
                <div>
                    <div class="profile-stat-value">{{ backoffStats.total }}</div>
                    <div class="text-muted">Tracked modules</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ backoffStats.suppressed }}</div>
                    <div class="text-muted">Currently suppressed</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ uploadSettings.upload_failure_backoff_enabled ? 'On' : 'Off' }}</div>
                    <div class="text-muted">Backoff enabled</div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Module</th>
                            <th>Identifier</th>
                            <th>Failures</th>
                            <th>Blocked until</th>
                            <th>Last status</th>
                            <th>Endpoint</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in backoffStats.entries %}
                            <tr>
                                <td class="font-monospace">{{ entry.module }}</td>
                                <td class="font-monospace">{{ entry.identifier }}</td>
                                <td>{{ entry.count }}</td>
                                <td>{{ entry.blocked_until ? entry.blocked_until|date('Y-m-d H:i:s') : '-' }}</td>
                                <td>{{ entry.last_status_code ?: '-' }}</td>
                                <td>{{ entry.last_endpoint ?: '-' }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-muted">No upload failure backoff entries are currently tracked.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section id="symbol-request-policy" class="profile-panel mt-3">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">Binary upload request policy</h2>
                    <div class="text-muted">These effective rules control which Linux modules Accelerator is asked to upload so Throttle can generate symbols during presubmit.</div>
                </div>
                <span class="badge text-bg-secondary">{{ symbolRequestPolicySource }}</span>
            </div>

            {% if symbolRequestPolicyEmpty %}
                <div class="alert alert-info">Defaults are currently empty. That now means default allow: Throttle will request missing modules like the original behavior unless a deny rule blocks them or upload-failure backoff suppresses them.</div>
            {% endif %}

            {% if symbolRequestPolicySaved %}
                <div class="alert alert-success">Binary upload request policy saved.</div>
            {% endif %}
            {% if symbolRequestPolicyReset %}
                <div class="alert alert-success">Binary upload request policy reset to defaults.</div>
            {% endif %}
            {% for error in symbolRequestPolicyErrors %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endfor %}

            <form method="post" class="mb-3">
                <input type="hidden" name="_token" value="{{ csrf_token('symbol-request-policy') }}">
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-8">
                        <label class="form-label" for="policy-test-module">Test module path/name</label>
                        <input id="policy-test-module" name="policy_test_module" class="form-control font-monospace" value="{{ policyTestInput }}" placeholder="/home/container/tf/bin/server_srv.so">
                    </div>
                    <div class="col-md-4">
                        <button type="submit" name="test_policy" value="1" class="btn btn-outline-primary">Check policy</button>
                    </div>
                </div>
                {% if policyTest %}
                    <div class="alert {{ policyTest.requested ? 'alert-success' : 'alert-warning' }}">
                        <strong>{{ policyTest.requested ? 'Binary upload requested' : 'Blocked' }}</strong>
                        for <code>{{ policyTest.basename }}</code>.
                        {% if policyTest.rule %}
                            Matched <code>{{ policyTest.stage }}</code> rule <code>{{ policyTest.rule }}</code> = <code>{{ policyTest.value }}</code>.
                        {% else %}
                            No rule matched; default allow.
                        {% endif %}
                        <div class="small mt-1">Allow rules override generic deny rules, but hard deny path/exact rules still win.</div>
                    </div>
                {% endif %}
                <div class="row g-3">
                    {% for rule, value in symbolRequestPolicyFields %}
                        <div class="col-md-6">
                            <label class="form-label" for="symbol-request-{{ rule }}"><code>{{ rule }}</code></label>
                            <textarea id="symbol-request-{{ rule }}" name="symbol_request_policy[{{ rule }}]" class="form-control font-monospace" rows="{{ rule == 'allow-regex' ? 4 : 3 }}">{{ value }}</textarea>
                            <div class="form-text">One value per line.</div>
                        </div>
                    {% endfor %}
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Save policy</button>
                    <button type="submit" name="reset_policy" value="1" class="btn btn-outline-secondary">Reset to defaults</button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Rule</th>
                            <th>Values</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rule, values in symbolRequestPolicy %}
                            <tr>
                                <td><code>{{ rule }}</code></td>
                                <td>
                                    {% for value in values %}
                                        <code class="me-2">{{ value }}</code>
                                    {% else %}
                                        <span class="text-muted">None</span>
                                    {% endfor %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section id="symbol-maintenance" class="profile-panel mt-3">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">Symbol maintenance</h2>
                    <div class="text-muted">Refresh caches after manual uploads and keep symbol presence in sync with the filesystem.</div>
                </div>
                <form method="post" action="{{ path('health_symbols_refresh') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('health-symbols-refresh') }}">
                    <button type="submit" class="btn btn-primary">Refresh symbol cache</button>
                </form>
            </div>

            {% for message in app.flashes('symbols_danger') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('symbols_warning') %}
                <div class="alert alert-warning">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('symbols_success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            {% if symbolDiagnostics.summary.has_warning %}
                <div class="alert alert-warning">
                    <strong>{{ symbolDiagnostics.summary.title }}</strong>
                    <div>{{ symbolDiagnostics.summary.body }}</div>
                </div>
            {% endif %}

            <div class="profile-stat-grid mb-3">
                <div>
                    <div class="profile-stat-value">{{ symbolDiagnostics.module_rows }}</div>
                    <div class="text-muted">Module rows</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ symbolDiagnostics.crashes_with_modules }}</div>
                    <div class="text-muted">Crashes with modules</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ symbolDiagnostics.stored_symbol_versions }}</div>
                    <div class="text-muted">Stored symbol versions</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ symbolDiagnostics.stored_binary_versions }}</div>
                    <div class="text-muted">Stored binary versions</div>
                </div>
                <div>
                    <div class="profile-stat-value">{{ symbolDiagnostics.stale_crashes }}</div>
                    <div class="text-muted">Awaiting reprocess</div>
                </div>
            </div>

            <form method="post" action="{{ path('health_symbols_upload_binary') }}" enctype="multipart/form-data" class="row g-3" id="binary-upload-form">
                <input type="hidden" name="_token" value="{{ csrf_token('health-symbols-upload-binary') }}">
                <div class="col-12">
                    <label class="form-label" for="binary-file">Upload binaries and generate symbols</label>
                    <div id="binary-drop-zone" class="border rounded p-4 text-center health-drop-zone">
                        <input id="binary-file" type="file" name="binary_files[]" class="d-none" multiple>
                        <div class="fw-semibold mb-2">Drag and drop binaries here</div>
                        <div class="text-muted mb-3">or click this panel to choose one or more files</div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="binary-file-trigger">Choose files</button>
                        <div class="small text-muted mt-3" id="binary-file-selection">No files selected.</div>
                        <div class="mt-2 d-flex flex-wrap justify-content-center gap-2" id="binary-file-list"></div>
                    </div>
                </div>
                <div class="col-auto d-flex align-items-end">
                    <button type="submit" class="btn btn-success">Upload binary</button>
                </div>
            </form>

            <div class="mt-3">
                <a class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" href="#symbol-upload-details-panel" role="button" aria-expanded="{{ symbolUploadsOpen ? 'true' : 'false' }}" aria-controls="symbol-upload-details-panel">Upload details</a>
            </div>

            <div id="symbol-upload-details-panel" class="collapse{% if symbolUploadsOpen %} show{% endif %} mt-3">
                <div class="form-text mb-3">Uses <code>dump_syms</code> when possible and falls back to <code>nm</code> for degraded public-symbol output. Recent entries also include manual uploads from this page.</div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Endpoint</th>
                                <th>Module</th>
                                <th>Identifier</th>
                                <th>Status</th>
                                <th>Result</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for entry in symbolDiagnostics.recent_uploads %}
                                <tr class="{{ entry.status_code >= 400 ? 'table-danger' : '' }}">
                                    <td>{{ entry.created_at }}</td>
                                    <td>{{ entry.endpoint }}</td>
                                    <td class="font-monospace">{{ entry.module ?: '-' }}</td>
                                    <td class="font-monospace">{{ entry.identifier ?: '-' }}</td>
                                    <td>{{ entry.status_code ?: '-' }}</td>
                                    <td>{{ entry.result ?: '-' }}</td>
                                    <td>{{ entry.reason ?: '-' }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="text-muted">No recent symbol or binary upload audit entries were found.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <a class="btn btn-outline-secondary btn-sm{% if symbolDiagnostics.recent_upload_pager.newest_offset is null %} disabled{% endif %}" {% if symbolDiagnostics.recent_upload_pager.newest_offset is not null %}href="{{ path('health', {recent_upload_offset: symbolDiagnostics.recent_upload_pager.newest_offset, symbol_uploads_open: 1, _fragment: 'symbol-maintenance'}) }}"{% else %}aria-disabled="true"{% endif %}>&larr; Newest</a>
                    <a class="btn btn-outline-secondary btn-sm{% if symbolDiagnostics.recent_upload_pager.older_offset is null %} disabled{% endif %}" {% if symbolDiagnostics.recent_upload_pager.older_offset is not null %}href="{{ path('health', {recent_upload_offset: symbolDiagnostics.recent_upload_pager.older_offset, symbol_uploads_open: 1, _fragment: 'symbol-maintenance'}) }}"{% else %}aria-disabled="true"{% endif %}>Older &rarr;</a>
                </div>
            </div>
        </section>

        <section id="stored-symbols" class="profile-panel mt-3">
            <div class="table-more module-log-toggle mb-3">
                <a href="#stored-symbols-panel" data-bs-toggle="collapse" aria-expanded="{{ symbolsOpen ? 'true' : 'false' }}" aria-controls="stored-symbols-panel">
                    <svg class="bi me-1" width="16" height="16" aria-hidden="true">
                        <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#three-dots"></use>
                    </svg>
                    Stored symbols
                </a>
            </div>

            <div id="stored-symbols-panel" class="collapse{% if symbolsOpen %} show{% endif %}">
                <div class="text-muted mb-3">Search, select, and export existing symbol files as a ZIP archive of <code>.sym.gz</code> files.</div>
                <form method="get" class="row g-2 align-items-end mb-3">
                    <div class="col-md-8">
                        <label class="form-label" for="symbol-filter">Filter</label>
                        <input id="symbol-filter" name="symbol_filter" class="form-control font-monospace" value="{{ symbolFilter }}" placeholder="engine_srv.so or 45EA846F...">
                    </div>
                    <div class="col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-outline-primary">Search</button>
                        <a href="{{ path('health') }}" class="btn btn-outline-secondary">Clear</a>
                    </div>
                </form>

                <form method="post" action="{{ path('health_symbols_export') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('health-symbols-export') }}">
                    <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                        <div class="text-muted">{{ symbolEntriesCount }} matching version{{ symbolEntriesCount == 1 ? '' : 's' }}</div>
                        <button type="submit" class="btn btn-outline-primary">Export selected symbols</button>
                        <button type="submit" name="delete_selected" value="1" class="btn btn-outline-danger" onclick="return confirm('Delete all selected stored symbol versions?');">Delete selected symbols</button>
                    </div>
                    {% if symbolGroups %}
                        <div class="table-responsive health-symbols-table-wrap">
                            <table class="table table-sm align-middle health-symbols-table">
                                <colgroup>
                                    <col class="health-symbols-col-checkbox">
                                    <col class="health-symbols-col-module">
                                    <col class="health-symbols-col-identifier">
                                    <col class="health-symbols-col-size">
                                    <col class="health-symbols-col-modified">
                                    <col class="health-symbols-col-binary">
                                    <col class="health-symbols-col-action">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Module</th>
                                        <th>Identifier</th>
                                        <th>Size</th>
                                        <th>Modified</th>
                                        <th>Binary</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                {% for group in symbolGroups %}
                                    {% set groupIndex = loop.index %}
                                    {% set groupId = 'stored-symbol-group-' ~ groupIndex %}
                                    {% set openGroup = symbolFilter != '' %}
                                    {% set primaryEntry = group.entries|first %}
                                    <tbody>
                                        <tr>
                                            <td><input type="checkbox" name="selected_symbols[]" value="{{ primaryEntry.module }}|{{ primaryEntry.identifier }}"></td>
                                            <td class="font-monospace">
                                                {{ group.module }}
                                                {% if group.version_count > 1 %}
                                                    <a href="#{{ groupId }}" data-bs-toggle="collapse" aria-expanded="{{ openGroup ? 'true' : 'false' }}" aria-controls="{{ groupId }}" class="ms-1 text-decoration-none" title="Show {{ group.version_count - 1 }} more version{{ group.version_count - 1 == 1 ? '' : 's' }}">
                                                        ({{ group.version_count }})
                                                    </a>
                                                {% endif %}
                                            </td>
                                            <td class="font-monospace">{{ primaryEntry.identifier }}</td>
                                            <td>{{ primaryEntry.bytes|human_size }}</td>
                                            <td>{{ primaryEntry.modified_at|date('Y-m-d H:i:s') }}</td>
                                            <td>
                                                {% if primaryEntry.binary_path %}
                                                    Available
                                                {% elseif primaryEntry.binary_retention.deleted %}
                                                    Deleted by cleanup
                                                {% else %}
                                                    Missing
                                                {% endif %}
                                            </td>
                                            <td class="text-end">
                                                <button type="submit" form="delete-symbol-{{ groupIndex }}-1" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete stored symbols for {{ primaryEntry.module }}/{{ primaryEntry.identifier }}?');">Delete</button>
                                            </td>
                                        </tr>
                                        {% if group.version_count > 1 %}
                                            <tr class="health-symbols-detail-row">
                                                <td colspan="8" class="p-0 border-0">
                                                    <div id="{{ groupId }}" class="collapse{% if openGroup %} show{% endif %}">
                                                        <div class="health-symbols-detail-panel">
                                                            <table class="table table-sm align-middle health-symbols-table mb-0">
                                                                <colgroup>
                                                                    <col class="health-symbols-col-checkbox">
                                                                    <col class="health-symbols-col-module">
                                                                    <col class="health-symbols-col-identifier">
                                                                    <col class="health-symbols-col-size">
                                                                    <col class="health-symbols-col-modified">
                                                                    <col class="health-symbols-col-binary">
                                                                    <col class="health-symbols-col-action">
                                                                </colgroup>
                                                                <tbody>
                                                                    {% for entry in group.entries|slice(1) %}
                                                                        {% set deleteFormId = 'delete-symbol-' ~ groupIndex ~ '-' ~ (loop.index + 1) %}
                                                                        <tr class="health-symbols-version-row">
                                                                            <td><input type="checkbox" name="selected_symbols[]" value="{{ entry.module }}|{{ entry.identifier }}"></td>
                                                                            <td class="font-monospace"></td>
                                                                            <td class="font-monospace">{{ entry.identifier }}</td>
                                                                            <td>{{ entry.bytes|human_size }}</td>
                                                                            <td>{{ entry.modified_at|date('Y-m-d H:i:s') }}</td>
                                                                            <td>
                                                                                {% if entry.binary_path %}
                                                                                    Available
                                                                                {% elseif entry.binary_retention.deleted %}
                                                                                    Deleted by cleanup
                                                                                {% else %}
                                                                                    Missing
                                                                                {% endif %}
                                                                            </td>
                                                                            <td class="text-end">
                                                                                <button type="submit" form="{{ deleteFormId }}" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete stored symbols for {{ entry.module }}/{{ entry.identifier }}?');">Delete</button>
                                                                            </td>
                                                                        </tr>
                                                                    {% endfor %}
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endif %}
                                    </tbody>
                                {% endfor %}
                            </table>
                        </div>
                    {% else %}
                        <div class="text-muted">No stored symbol files matched the current filter.</div>
                    {% endif %}
                </form>
                {% for group in symbolGroups %}
                    {% set groupIndex = loop.index %}
                    {% for entry in group.entries %}
                        <form id="delete-symbol-{{ groupIndex }}-{{ loop.index }}" method="post" action="{{ path('health_symbols_delete') }}" class="d-none">
                            <input type="hidden" name="_token" value="{{ csrf_token('health-symbols-delete') }}">
                            <input type="hidden" name="module" value="{{ entry.module }}">
                            <input type="hidden" name="identifier" value="{{ entry.identifier }}">
                        </form>
                    {% endfor %}
                {% endfor %}
            </div>
        </section>
    </div>
    <form id="storage-cleanup-run-form" method="post" action="{{ path('health_storage_cleanup_run') }}" class="d-none">
        <input type="hidden" name="_token" value="{{ csrf_token('health-storage-cleanup-run') }}">
    </form>
    <script>
        (() => {
            const dropZone = document.getElementById('binary-drop-zone');
            const input = document.getElementById('binary-file');
            const trigger = document.getElementById('binary-file-trigger');
            const selection = document.getElementById('binary-file-selection');
            const fileList = document.getElementById('binary-file-list');
            if (!dropZone || !input || !trigger || !selection || !fileList) {
                return;
            }

            const updateSelection = () => {
                if (!input.files || input.files.length === 0) {
                    selection.textContent = 'No files selected.';
                    fileList.innerHTML = '';
                    return;
                }

                const files = Array.from(input.files);
                selection.textContent = `${files.length} file(s) selected.`;
                fileList.innerHTML = '';
                files.forEach((file, index) => {
                    const chip = document.createElement('span');
                    chip.className = 'd-inline-flex align-items-center gap-2 border rounded px-2 py-1';

                    const label = document.createElement('span');
                    label.className = 'small text-muted';
                    label.textContent = file.name;

                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'btn-close btn-close-white opacity-75';
                    remove.setAttribute('aria-label', `Remove ${file.name}`);
                    remove.addEventListener('click', (event) => {
                        event.preventDefault();
                        event.stopPropagation();
                        const nextFiles = files.filter((_, fileIndex) => fileIndex !== index);
                        const dataTransfer = new DataTransfer();
                        nextFiles.forEach((nextFile) => dataTransfer.items.add(nextFile));
                        input.files = dataTransfer.files;
                        updateSelection();
                    });

                    chip.appendChild(label);
                    chip.appendChild(remove);
                    fileList.appendChild(chip);
                });
            };

            const assignFiles = (files) => {
                if (!files || files.length === 0) {
                    return;
                }

                const dataTransfer = new DataTransfer();
                Array.from(files).forEach((file) => dataTransfer.items.add(file));
                input.files = dataTransfer.files;
                updateSelection();
            };

            const openPicker = () => input.click();

            trigger.addEventListener('click', (event) => {
                event.preventDefault();
                event.stopPropagation();
                openPicker();
            });
            dropZone.addEventListener('click', (event) => {
                if (event.target.closest('#binary-file-trigger') || event.target.closest('#binary-file-list') || event.target.closest('button')) {
                    return;
                }
                openPicker();
            });
            input.addEventListener('change', updateSelection);
            ['dragenter', 'dragover'].forEach((eventName) => {
                dropZone.addEventListener(eventName, (event) => {
                    event.preventDefault();
                    dropZone.classList.add('border-primary');
                });
            });
            ['dragleave', 'drop'].forEach((eventName) => {
                dropZone.addEventListener(eventName, (event) => {
                    event.preventDefault();
                    dropZone.classList.remove('border-primary');
                });
            });
            dropZone.addEventListener('drop', (event) => {
                assignFiles(event.dataTransfer ? event.dataTransfer.files : null);
            });

            if (window.location.hash === '#symbol-maintenance') {
                const target = document.getElementById('symbol-maintenance');
                if (target) {
                    window.requestAnimationFrame(() => {
                        target.scrollIntoView({block: 'start'});
                    });
                }
            }
        })();
    </script>
{% endblock %}
