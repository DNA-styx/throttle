<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% if sentry_dsn is defined %}
            {{ sentry_trace_meta() }}
            {{ sentry_baggage_meta() }}
        {% endif %}
        <title>{% if block('title') is defined %}{{ block('title') }} - {% endif %}{{ app_name }}</title>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}
            <script>
                const APP_CONFIG = {
                    environment: {{ app.environment | default("dev") | json_encode | raw }},
                    sentry_dsn: {{ sentry_dsn | default(null) | json_encode | raw }},
                    sentry_tunnel: {{ path('sentry') | json_encode | raw }},
                    sentry_user: {{ (app.user ? { username: app.user.userIdentifier } : {}) | json_encode | raw }}
                };
            </script>
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        {% block page_body %}
            <header class="mb-3 border-bottom">
                <div class="container">
                    <div class="navbar navbar-light align-items-center justify-content-center justify-content-sm-between">
                        <a href="{{ path('index') }}" class="py-1 px-2 d-flex align-items-center text-dark text-decoration-none">
                            <svg class="me-2" width="32" height="32" fill="currentColor" role="img" aria-label="{{ app_name }}">
                                <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#speedometer2"></use>
                            </svg>
                            {{ app_name }}
                        </a>
                        <div class="d-flex align-items-center ms-auto">
                            {% if app.user %}
                                <div class="dropdown">
                                    <button class="btn navbar-text-btn dropdown-toggle d-flex align-items-center gap-2" type="button" id="account-menu" data-bs-toggle="dropdown" aria-expanded="false">
                                        {{ include('_server_owner.html.twig', {owner: app.user}) }}
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="account-menu">
                                        <li>
                                            <a class="dropdown-item" href="{{ path('profile') }}">
                                                <svg class="bi me-2" width="16" height="16" aria-hidden="true">
                                                    <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#person-fill"></use>
                                                </svg>
                                                Profile
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="{{ path('dashboard') }}">
                                                <svg class="bi me-2" width="16" height="16" aria-hidden="true">
                                                    <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#list"></use>
                                                </svg>
                                                Dashboard
                                            </a>
                                        </li>
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <li>
                                                <a class="dropdown-item" href="{{ path('health') }}">
                                                    <svg class="bi me-2" width="16" height="16" aria-hidden="true">
                                                        <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#heart-fill"></use>
                                                    </svg>
                                                    Health
                                                </a>
                                            </li>
                                        {% endif %}
                                        <li>
                                            <a class="dropdown-item" href="{{ path('share') }}">
                                                <svg class="bi me-2" width="16" height="16" aria-hidden="true">
                                                    <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#share-fill"></use>
                                                </svg>
                                                Sharing
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        {% if is_granted('IS_IMPERSONATOR') %}
                                            <li>
                                                <a class="dropdown-item text-danger" href="{{ impersonation_exit_path() }}">
                                                    <svg class="bi me-2" width="16" height="16" aria-hidden="true">
                                                        <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#box-arrow-right"></use>
                                                    </svg>
                                                    Exit Impersonation
                                                </a>
                                            </li>
                                        {% else %}
                                            <li>
                                                <a class="dropdown-item" href="{{ logout_path() }}">
                                                    <svg class="bi me-2" width="16" height="16" aria-hidden="true">
                                                        <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#box-arrow-right"></use>
                                                    </svg>
                                                    Logout
                                                </a>
                                            </li>
                                        {% endif %}
                                    </ul>
                                </div>
                            {% elseif not (app.request.attributes.get('_route') starts with 'login') %}
                                <a href="{{ path('login_steam', {'return': app.request.requestUri}) }}" class="btn btn-outline-primary me-2">
                                    <svg class="bi me-1" width="16" height="16" aria-hidden="true">
                                        <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#steam"></use>
                                    </svg>
                                    Login with Steam
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </header>
            <div class="container">
                {% block body %}{% endblock %}
            </div>
        {% endblock %}
    </body>
</html>
