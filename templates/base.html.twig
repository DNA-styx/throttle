<!DOCTYPE html>
{% set theme_preference = 'system' %}
<html lang="{{ app.request.locale }}" data-theme-preference="{{ theme_preference }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% if sentry_dsn is defined %}
            {{ sentry_trace_meta() }}
            {{ sentry_baggage_meta() }}
        {% endif %}
        <title>{% if block('title') is defined %}{{ block('title') }} - {% endif %}{{ app_name }}</title>
        <script>
            (function() {
                var root = document.documentElement;
                var stored = null;
                try {
                    stored = window.localStorage && window.localStorage.getItem('throttleTheme');
                } catch (e) {}
                var preference = /^(light|dark|system)$/.test(stored || '') ? stored : (root.getAttribute('data-theme-preference') || 'system');
                if (!/^(light|dark|system)$/.test(preference)) {
                    preference = 'system';
                }
                var effective = preference === 'system' && window.matchMedia
                    ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                    : preference;
                root.setAttribute('data-theme-preference', preference);
                root.setAttribute('data-bs-theme', effective === 'dark' ? 'dark' : 'light');
            })();
        </script>
        <style>
            [data-bs-theme="dark"], [data-bs-theme="dark"] body { background: #111820; color: #e5edf5; color-scheme: dark; }
        </style>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        <style>
            [data-bs-theme="dark"], [data-bs-theme="dark"] body { background: #111820; color: #e5edf5; }
            [data-bs-theme="dark"] header.border-bottom { background: #1a2330; border-color: #303b4a !important; }
            [data-bs-theme="dark"] .navbar-light .text-dark,
            [data-bs-theme="dark"] .navbar-light .navbar-brand,
            [data-bs-theme="dark"] .navbar-text-btn { color: #f4f8fb !important; }
            [data-bs-theme="dark"] .profile-panel { background: #1a2330; border-color: #303b4a; box-shadow: 0 1px 0 rgba(255, 255, 255, 0.03); }
            [data-bs-theme="dark"] .table { color: #dce6f0; border-color: #303b4a; }
            [data-bs-theme="dark"] .table > :not(caption) > * > * { border-color: #303b4a; }
            [data-bs-theme="dark"] .table-striped > tbody > tr:nth-of-type(odd) > * { color: #dce6f0; background-color: rgba(255, 255, 255, 0.025); }
            [data-bs-theme="dark"] .table-danger > * { color: #ffd9df; background-color: #432026 !important; }
            [data-bs-theme="dark"] .form-control,
            [data-bs-theme="dark"] .form-select { color: #e5edf5; background-color: #111820; border-color: #3a4758; }
            [data-bs-theme="dark"] .form-control:focus,
            [data-bs-theme="dark"] .form-select:focus { color: #fff; background-color: #111820; border-color: #6da8ff; box-shadow: 0 0 0 0.25rem rgba(109, 168, 255, 0.2); }
            [data-bs-theme="dark"] .form-text,
            [data-bs-theme="dark"] .text-muted { color: #95a3b4 !important; }
            [data-bs-theme="dark"] code,
            [data-bs-theme="dark"] pre { color: #d8e7ff; background-color: #0d131a; border-color: #303b4a; }
            [data-bs-theme="dark"] .dropdown-menu { background: #1a2330; border-color: #303b4a; }
            [data-bs-theme="dark"] .dropdown-item { color: #dce6f0; }
            [data-bs-theme="dark"] .dropdown-item:hover,
            [data-bs-theme="dark"] .dropdown-item:focus { color: #fff; background: #263345; }
            [data-bs-theme="dark"] .btn-outline-secondary { color: #d7e0ea; border-color: #536174; }
            [data-bs-theme="dark"] .btn-outline-secondary:hover { color: #fff; background: #2b3849; border-color: #6b7b91; }
            [data-bs-theme="dark"] .pagination .page-link { color: #d7e0ea; background-color: #1a2330; border-color: #3a4758; }
            [data-bs-theme="dark"] .pagination .page-link:hover,
            [data-bs-theme="dark"] .pagination .page-link:focus,
            [data-bs-theme="dark"] .pagination .active .page-link { color: #fff; background-color: #2b3849; border-color: #536174; }
            [data-bs-theme="dark"] .pagination .disabled .page-link { color: #6f7b8a; background-color: #151c25; border-color: #303b4a; }
            [data-bs-theme="dark"] .alert-success { color: #cff4d2; background: #16341f; border-color: #2f6d3f; }
            [data-bs-theme="dark"] .alert-danger { color: #ffd7de; background: #421b24; border-color: #8a3444; }
        </style>
        {% block javascripts %}
            <script>
                const APP_CONFIG = {
                    environment: {{ app.environment | default("dev") | json_encode | raw }},
                    sentry_dsn: {{ sentry_dsn | default(null) | json_encode | raw }},
                    sentry_tunnel: {{ path('sentry') | json_encode | raw }},
                    sentry_user: {{ (app.user ? { username: app.user.userIdentifier } : {}) | json_encode | raw }},
                    theme_preference: {{ theme_preference | json_encode | raw }}
                };
            </script>
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        {% block page_body %}
            <header class="mb-3 border-bottom">
                <div class="container-fluid px-2">
                    <div class="navbar navbar-light align-items-center">
                        <div class="navbar-start">
                        <a href="{{ path('index') }}" class="py-1 px-2 d-flex align-items-center text-dark text-decoration-none navbar-brand-link">
                            <svg class="throttle-brand-icon me-2" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                <path d="M8 4a.5.5 0 0 1 .5.5V6a.5.5 0 0 1-1 0V4.5A.5.5 0 0 1 8 4zM3.732 5.732a.5.5 0 0 1 .707 0l.915.914a.5.5 0 1 1-.708.708l-.914-.915a.5.5 0 0 1 0-.707zM2 10a.5.5 0 0 1 .5-.5h1.586a.5.5 0 0 1 0 1H2.5A.5.5 0 0 1 2 10zm9.5 0a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 0 1H12a.5.5 0 0 1-.5-.5zm.754-4.246a.389.389 0 0 0-.527-.02L7.547 9.31a.91.91 0 1 0 1.302 1.258l3.434-4.297a.389.389 0 0 0-.029-.518z"/>
                                <path fill-rule="evenodd" d="M0 10a8 8 0 1 1 15.547 2.661c-.442 1.253-1.845 1.602-2.932 1.25C11.309 13.488 9.475 13 8 13c-1.474 0-3.31.488-4.615.911-1.087.352-2.49.003-2.932-1.25A7.988 7.988 0 0 1 0 10zm8-7a7 7 0 0 0-6.603 9.329c.203.575.923.876 1.68.63C4.397 12.533 6.358 12 8 12s3.604.532 4.923.96c.757.245 1.477-.056 1.68-.631A7 7 0 0 0 8 3z"/>
                            </svg>
                            {{ app_name }}
                        </a>
                        </div>
                        <div class="d-flex align-items-center ms-auto">
                            {% if app.user %}
                                <div class="me-2">
                                    {{ include('_theme_switcher.html.twig') }}
                                </div>
                                {{ include('_account_menu_bootstrap5.html.twig') }}
                            {% else %}
                                <div class="me-2">
                                    {{ include('_theme_switcher.html.twig') }}
                                </div>
                                {% if not (app.request.attributes.get('_route') starts with 'login') %}
                                    <a href="{{ path('login', {'return': app.request.requestUri}) }}" class="btn btn-outline-primary me-2">
                                        <svg class="bi me-1" width="16" height="16" aria-hidden="true">
                                            <use xlink:href="{{ asset('build/bootstrap-icons.svg') }}#box-arrow-in-right"></use>
                                        </svg>
                                        Login
                                    </a>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </header>
            <div class="container app-content-container">
                {% block body %}{% endblock %}
            </div>
        {% endblock %}
        <script>
            (function() {
                var root = document.documentElement;
                var media = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
                var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-theme-choice]'));

                function storedPreference() {
                    try {
                        var stored = window.localStorage && window.localStorage.getItem('throttleTheme');
                        return /^(light|dark|system)$/.test(stored || '') ? stored : null;
                    } catch (e) {
                        return null;
                    }
                }

                function apply(preference, persist) {
                    preference = /^(light|dark|system)$/.test(preference || '') ? preference : 'system';
                    var effective = preference === 'system' && media ? (media.matches ? 'dark' : 'light') : preference;
                    root.setAttribute('data-theme-preference', preference);
                    root.setAttribute('data-bs-theme', effective === 'dark' ? 'dark' : 'light');
                    buttons.forEach(function(button) {
                        var active = button.getAttribute('data-theme-choice') === preference;
                        button.classList.toggle('active', active);
                        button.setAttribute('aria-pressed', active ? 'true' : 'false');
                    });
                    if (persist) {
                        try {
                            window.localStorage && window.localStorage.setItem('throttleTheme', preference);
                        } catch (e) {}
                    }
                }

                buttons.forEach(function(button) {
                    button.addEventListener('click', function() {
                        apply(button.getAttribute('data-theme-choice'), true);
                    });
                });
                if (media && media.addEventListener) {
                    media.addEventListener('change', function() {
                        apply(storedPreference() || root.getAttribute('data-theme-preference') || 'system', false);
                    });
                }
                apply(storedPreference() || root.getAttribute('data-theme-preference') || 'system', false);
            })();
        </script>
    </body>
</html>
