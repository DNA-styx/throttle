{% extends 'base.html.twig' %}

{% block title %}{{ user.name ?: ('User #' ~ user.id) }}{% endblock %}

{% block body %}
    <style>
        .player-profile-shell .pager {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .player-profile-shell .pager li {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .player-profile-shell .pager li a {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 12px;
            border: 1px solid rgba(133, 160, 196, 0.22);
            border-radius: 8px;
            background: rgba(18, 28, 40, 0.86);
            color: #dfe9f5;
            text-decoration: none;
        }

        .player-profile-shell .pager li a:hover,
        .player-profile-shell .pager li a:focus {
            background: rgba(32, 47, 66, 0.96);
            color: #ffffff;
        }

        .player-profile-shell .pager li.disabled a {
            opacity: 0.45;
            pointer-events: none;
        }

        .player-summary-card {
            border: 1px solid rgba(133, 160, 196, 0.18);
            border-radius: 12px;
            padding: 16px 18px;
            background: rgba(18, 28, 40, 0.72);
            height: 100%;
        }

        .player-summary-label {
            color: #9eb0c7;
            font-size: 0.82rem;
            margin-bottom: 6px;
        }

        .player-summary-value {
            font-size: 1.15rem;
            font-weight: 600;
            word-break: break-word;
        }

        .player-identity-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 12px;
        }
    </style>
    <div class="profile-shell player-profile-shell">
        <section class="profile-panel">
            <div class="row g-4 player-profile-grid">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                        <img
                            src="{{ avatarSeed|identicon(96) }}"
                            alt="Avatar for {{ user.name ?: ('user #' ~ user.id) }}"
                            class="rounded-circle border player-profile-avatar"
                            width="96"
                            height="96"
                        >
                        <div>
                            <h1 class="h3 mb-1">{{ user.name ?: ('User #' ~ user.id) }}</h1>
                            <div class="text-muted">Player profile / User #{{ user.id }}</div>
                            {% if profileIsPrivate %}
                                <span class="badge text-bg-secondary mt-2">Private profile</span>
                            {% elseif isOwnProfile %}
                                <span class="badge text-bg-primary mt-2">Your profile</span>
                            {% endif %}
                        </div>
                    </div>

                    {% if profileIsPrivate %}
                        <div class="player-private-state">
                            <div class="player-private-state__copy">
                                <h2 class="h5 mb-2">Profile is private</h2>
                                <p class="text-muted mb-0">This player chose to hide their crash history and linked identity details from other users.</p>
                            </div>
                        </div>
                    {% else %}
                        <div class="profile-stat-grid mb-3">
                            <div>
                                <div class="profile-stat-value">{{ crashCount }}</div>
                                <div class="text-muted">Crashes</div>
                            </div>
                            <div>
                                <div class="profile-stat-value">{{ showSteam ? (steamId ?: '-') : 'Hidden' }}</div>
                                <div class="text-muted">SteamID64</div>
                            </div>
                            <div>
                                <div class="profile-stat-value">{{ showDiscord ? (discordId ?: '-') : 'Hidden' }}</div>
                                <div class="text-muted">Discord ID</div>
                            </div>
                            <div>
                                <div class="profile-stat-value">{{ showEmail ? (contactEmail ?: '-') : 'Hidden' }}</div>
                                <div class="text-muted">Contact email</div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-lg-8">
                                <div class="player-summary-card">
                                    <h2 class="h6 mb-3">Identity visibility</h2>
                                    <div class="player-identity-list">
                                        <div>
                                            <div class="player-summary-label">Contact email</div>
                                            <div class="player-summary-value">{{ showEmail ? (contactEmail ?: 'Not set') : 'Hidden by player' }}</div>
                                        </div>
                                        <div>
                                            <div class="player-summary-label">SteamID64</div>
                                            <div class="player-summary-value">{{ showSteam ? (steamId ?: 'Not linked') : 'Hidden by player' }}</div>
                                        </div>
                                        <div>
                                            <div class="player-summary-label">Discord ID</div>
                                            <div class="player-summary-value">{{ showDiscord ? (discordId ?: 'Not linked') : 'Hidden by player' }}</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="player-summary-card">
                                    <h2 class="h6 mb-2">Profile visibility</h2>
                                    <p class="mb-2 text-muted">
                                        {% if user.profilePrivate %}
                                            Private for other users.
                                        {% else %}
                                            Public to signed-in users.
                                        {% endif %}
                                    </p>
                                    {% if isOwnProfile or isAdminViewer %}
                                        <div class="player-summary-label">Roles</div>
                                        <div class="player-summary-value">{{ user.roles ? user.roles|join(', ') : 'ROLE_USER' }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </section>

        {% if not profileIsPrivate %}
            <section class="profile-panel">
                <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                    <div>
                        <h2 class="h5 mb-1">Recent crashes</h2>
                        <div class="text-muted">
                            Showing {{ recentCrashes|length }} most recent crash{{ recentCrashes|length == 1 ? '' : 'es' }}
                            {% if offset %}
                                on this page
                            {% endif %}
                            out of {{ crashCount }} total linked to this player.
                        </div>
                    </div>
                </div>

                <div class="well well-tight">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Crash ID</th>
                                <th>Uploaded</th>
                                <th class="hidden-xs"></th>
                                <th class="hidden-xs">Function</th>
                            </tr>
                        </thead>
                        <tbody>
                    {% set last = null %}
                    {% for crash in recentCrashes %}
                    {% set last = crash.timestamp %}
                    {% if crash.module is not empty or crash.module2 is empty %}
                    {% set frame = {rendered: crash.rendered, first: true} %}
                    {% else %}
                    {% set frame = {rendered: crash.rendered2, first: false} %}
                    {% endif %}
                            <tr {% if crash.processed == 0 %}class="warning"{% elseif crash.failed == 1 %}class="danger"{% endif %}>
                                <td>
                                    {% if crash.cmdline %}
                                        <img class="column-identicon" src="{{ crash.cmdline|identicon }}" width="20" height="20" alt="">
                                    {% endif %}
                                </td>
                                <td class="monospace"><a href="{{ path('details', {id: crash.id}) }}">{{ crash.id|crashid }}</a></td>
                                <td><span title="{{ crash.timestamp|date }}">{{ crash.timestamp|diffdate }}</span></td>
                                <td class="hidden-xs">
                                    <img class="column-identicon" title="{{ user.name ?: ('User #' ~ user.id) }}" src="{{ avatarSeed|identicon }}" width="20" height="20" alt="">
                                </td>
                                <td title="{{ frame.rendered }}" class="hidden-xs monospace column-stackframe {% if not frame.first %}column-stackframe-fallback{% endif %}">
                                    {{ frame.rendered }}
                                </td>
                            </tr>
                    {% else %}
                            <tr>
                                <td colspan="5" class="text-center">No Crashes</td>
                            </tr>
                    {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5">
                                    <ul class="pager">
                                        <li class="previous {% if not offset %}disabled{% endif %}">
                                            <a {% if offset %}href="{{ path('user_show', {id: user.id}) }}"{% endif %}>&larr; Newest</a>
                                        </li>
                                        <li class="next {% if not last %}disabled{% endif %}">
                                            <a {% if last %}href="{{ path('user_show', {id: user.id, offset: last}) }}"{% endif %}>Older &rarr;</a>
                                        </li>
                                    </ul>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </section>
        {% endif %}
    </div>
{% endblock %}
