{{ form_start(form) }}
    <div class="row g-3">
        {% for field in form %}
            {% if field.vars.name != '_token' %}
                <div class="col-12">
                    {{ form_row(field) }}
                </div>
            {% endif %}
        {% endfor %}
    </div>
    {{ form_rest(form) }}
    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary">{{ button_label|default('Save') }}</button>
    </div>
{{ form_end(form) }}
