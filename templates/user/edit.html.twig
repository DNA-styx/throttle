{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
    <div class="profile-shell">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h1 class="h3 mb-1">Edit User</h1>
                <div class="text-muted">Account details, roles, and contact settings.</div>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('user_show', {id: user.id}) }}" class="btn btn-outline-secondary">Profile</a>
                <a href="{{ path('user_index') }}" class="btn btn-outline-secondary">Back to list</a>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <section class="profile-panel h-100">
                    {{ include('user/_form.html.twig', {'button_label': 'Save changes'}) }}
                </section>
            </div>
            <div class="col-lg-4">
                <section class="profile-panel h-100">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="{{ avatarSeed|identicon(64) }}" alt="{{ user.name ?: ('user #' ~ user.id) }} avatar" width="64" height="64" class="rounded-circle border">
                        <div>
                            <div class="h5 mb-1">{{ user.name ?: ('User #' ~ user.id) }}</div>
                            <div class="text-muted">User #{{ user.id }}</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <div class="border rounded p-3 h-100">
                                <div class="small text-muted text-uppercase">Crashes</div>
                                <div class="h4 mb-0">{{ crashCount }}</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-3 h-100">
                                <div class="small text-muted text-uppercase">Last login</div>
                                <div class="small mb-0">{{ user.lastLogin ? user.lastLogin|date('Y-m-d H:i') : 'Never' }}</div>
                            </div>
                        </div>
                    </div>

                    <dl class="mb-0">
                        <dt class="small text-muted">Contact email</dt>
                        <dd>{{ user.contactEmail ?: 'Not set' }}</dd>
                        <dt class="small text-muted">Email verification</dt>
                        <dd>{{ user.emailVerifiedAt ? ('Verified at ' ~ user.emailVerifiedAt|date('Y-m-d H:i')) : 'Not verified' }}</dd>
                        <dt class="small text-muted">SteamID64</dt>
                        <dd>{{ steamId ?: 'Not linked' }}</dd>
                        <dt class="small text-muted">Discord ID</dt>
                        <dd>{{ discordId ?: 'Not linked' }}</dd>
                        <dt class="small text-muted">Moderation</dt>
                        <dd>
                            {% if user.isBanned %}
                                Banned{% if user.bannedAt %} at {{ user.bannedAt|date('Y-m-d H:i') }}{% endif %}
                            {% else %}
                                Not banned
                            {% endif %}
                            / {{ user.uploadsBlocked ? 'Uploads blocked' : 'Uploads allowed' }}
                        </dd>
                        <dt class="small text-muted">Registration</dt>
                        <dd class="text-muted">Registration timestamp is not stored in the current schema.</dd>
                    </dl>
                </section>
            </div>
        </div>

        <section class="profile-panel mt-3">
            {{ include('user/_delete_form.html.twig') }}
        </section>
    </div>
{% endblock %}
